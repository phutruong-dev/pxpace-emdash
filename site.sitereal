      ],
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".w-home-hero",
              "css": "gap: 0;"
            },
            {
              "selector": ".w-home-hero__container",
              "css": "align-items: center;\ngap: var(--space-xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-block: var(--space-3xl) 56px;"
            },
            {
              "selector": ".w-home-hero__copy",
              "css": "align-items: center;\ngap: var(--space-s);"
            },
            {
              "selector": ".w-home-hero__heading",
              "css": "display: flex;\nflex-direction: column;\nalign-items: center;\ngap: 2px;\nmargin: 0;\ntext-align: center;"
            },
            {
              "selector": ".w-home-hero__line-row",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: var(--space-2xs);\nwhite-space: nowrap;\n@media (max-width: 767px) {\n  flex-wrap: wrap;\n  justify-content: center;\n}"
            },
            {
              "selector": ".w-home-hero__word",
              "css": "font-family: var(--font-family-display);\nfont-size: var(--text-7xl);\nline-height: var(--line-height-xs);\nletter-spacing: var(--letter-spacing-display);\ncolor: var(--text-body-dark);\ntransition: color 350ms;"
            },
            {
              "selector": ".w-home-hero__word.is-active",
              "css": "color: var(--hero-word-active);"
            },
            {
              "selector": ".w-home-hero__word--agent.is-active",
              "css": "color: var(--hero-word-agent);"
            },
            {
              "selector": ".w-home-hero .w-heading-2xl",
              "css": "text-align: center;"
            },
            {
              "selector": ".w-home-hero .w-text-m",
              "css": "max-inline-size: 564px;\nline-height: var(--line-height-3xl);\ntext-align: center;"
            },
            {
              "selector": ".w-home-hero__actions",
              "css": "display: flex;\nflex-direction: row;\njustify-content: center;\nalign-items: center;\ngap: var(--space-m);"
            },
            {
              "selector": ".w-home-hero__visual",
              "css": "position: relative;\ninline-size: 100%;\nmax-inline-size: none;\npadding-inline: 0;\naspect-ratio: 1600 / 707;\nmax-block-size: 707px;\noverflow: hidden;\nbackground: var(--bg-sky);"
            },
            {
              "selector": ".w-home-hero__background",
              "css": "inline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
            },
            {
              "selector": ".w-home-hero__illustration",
              "css": "position: absolute;\nz-index: 2;\ninset-block-start: 10.2%;\ninset-inline-start: 50%;\ninline-size: 88%;\nmax-inline-size: 1200px;\ntransform: translateX(-50%);"
            },
            {
              "selector": ".w-home-hero__fade",
              "css": "position: absolute;\nz-index: 3;\ninset-inline-start: 0;\ninset-block-end: 0;\ninline-size: 100%;\nblock-size: 160px;\nbackground: var(--gradient-fade-bottom);\npointer-events: none;"
            },
            {
              "selector": ".w-logos",
              "css": "gap: var(--space-l);\npadding-block-start: var(--space-xl);"
            },
            {
              "selector": ".w-logos__container",
              "css": "align-items: center;\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-inline: var(--layout-margin);"
            },
            {
              "selector": ".w-logos__intro",
              "css": "inline-size: 584px;\nmax-inline-size: 100%;\ntext-align: center;\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-logos__band",
              "css": "inline-size: 100%;\nmax-inline-size: none;\npadding-inline: 0;\nborder-block: var(--stroke-subtle);"
            },
            {
              "selector": ".w-logos__viewport",
              "css": "inline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\nmargin-inline: auto;\noverflow: hidden;"
            },
            {
              "selector": ".w-logos__track",
              "css": "display: flex;\nflex-direction: row;\ninline-size: max-content;\nanimation: w-marquee-left 36s linear infinite;\nwill-change: transform;"
            },
            {
              "selector": ".w-logos__viewport:hover .w-logos__track",
              "css": "animation-play-state: paused;"
            },
            {
              "selector": ".w-hosting",
              "css": "position: relative;\npadding: var(--space-4xl) var(--layout-margin);"
            },
            {
              "selector": ".w-hosting::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-hosting__container",
              "css": "align-items: stretch;\ngap: var(--space-2xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-inline: var(--layout-inset);\n@media (max-width: 767px) {\n  padding-inline: var(--space-s);\n}"
            },
            {
              "selector": ".w-hosting__head",
              "css": "align-items: center;\ngap: var(--space-s);\ntext-align: center;"
            },
            {
              "selector": ".w-hosting .w-heading-xl",
              "css": "letter-spacing: normal;"
            },
            {
              "selector": ".w-hosting .w-text-l",
              "css": "max-inline-size: 680px;\nline-height: var(--line-height-2xl);"
            },
            {
              "selector": ".w-hosting__grid",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: var(--space-l);\n@media (max-width: 991px) {\n  grid-template-columns: var(--columns-2);\n}\n@media (max-width: 767px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-hosting__item",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".w-hosting__note",
              "css": "max-inline-size: 760px;\nmargin-inline: auto;\ntext-align: center;\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-hosting__note-link",
              "css": "color: var(--accent);\nbackground:\n    linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat,\n    linear-gradient(color-mix(in srgb, currentColor 35%, transparent), color-mix(in srgb, currentColor 35%, transparent)) left bottom / 100% 1px no-repeat;\ntransition: background-size var(--duration-slow) var(--ease-reveal);"
            },
            {
              "selector": ".w-hosting__note-link:is(:hover, :focus-visible)",
              "css": "background-position: left bottom, left bottom;\nbackground-size: 100% 1px, 100% 1px;"
            },
            {
              "selector": ".w-plans",
              "css": "position: relative;\npadding: var(--space-4xl) var(--layout-margin);"
            },
            {
              "selector": ".w-plans::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-plans__container",
              "css": "align-items: stretch;\ngap: var(--space-3xl);\nmax-inline-size: min(var(--layout-frame), 100%);"
            },
            {
              "selector": ".w-plans__head",
              "css": "align-items: center;\ngap: var(--space-xs);\ntext-align: center;"
            },
            {
              "selector": ".w-plans .w-heading-xl",
              "css": "letter-spacing: normal;"
            },
            {
              "selector": ".w-plans .w-text-m",
              "css": "max-inline-size: 670px;"
            },
            {
              "selector": ".w-plans__cards",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: 1px;\npadding-block: 1px;\nbackground: var(--border-subtle);\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-stack__container",
              "css": "flex-direction: row;\nalign-items: center;\nblock-size: 184px;\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-inline: 0;\nbackground: var(--bg-surface);\nborder-inline: var(--stroke-subtle);\n@media (max-width: 991px) {\n  flex-direction: column;\n  block-size: auto;\n}"
            },
            {
              "selector": ".w-stack__intro",
              "css": "position: relative;\ndisplay: flex;\nflex-direction: column;\njustify-content: center;\nalign-self: stretch;\ngap: var(--space-xs);\nflex: 0 0 400px;\npadding-inline: var(--space-l);\nborder-inline-end: var(--stroke-subtle);\n@media (max-width: 991px) {\n  flex-basis: auto;\n  inline-size: 100%;\n  padding-block: var(--space-l);\n  border-inline-end: 0;\n  border-block-end: var(--stroke-subtle);\n}"
            },
            {
              "selector": ".w-stack__title",
              "css": "position: relative;\nz-index: 1;\nfont-size: var(--text-m);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-3xl);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-stack__description",
              "css": "position: relative;\nz-index: 1;\ninline-size: 269px;\nmax-inline-size: 100%;\nfont-size: var(--text-s);\nline-height: var(--line-height-m);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-stack__dots",
              "css": "position: absolute;\ninset-block-start: 0;\ninset-inline-end: 0;\ninline-size: 147px;\nblock-size: 180px;\npointer-events: none;"
            },
            {
              "selector": ".w-stack__rows",
              "css": "flex: 1 1 800px;\nmin-inline-size: 0;\n@media (max-width: 991px) {\n  flex-basis: auto;\n  inline-size: 100%;\n}"
            },
            {
              "selector": ".w-stack__row",
              "css": "block-size: 80px;\noverflow: hidden;\nmask-image: linear-gradient(90deg, transparent 0, #000 18%, #000 85%, transparent);"
            },
            {
              "selector": ".w-stack__track",
              "css": "display: flex;\nflex-direction: row;\ninline-size: max-content;\nanimation: w-marquee-left 44s linear infinite;\nwill-change: transform;"
            },
            {
              "selector": ".w-stack__track--reverse",
              "css": "animation-name: w-marquee-right;\nanimation-duration: 141s;"
            },
            {
              "selector": ".w-stack__rule",
              "css": "display: block;\nblock-size: 1px;\nmargin: 6px 0 5px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-features",
              "css": "position: relative;\npadding: var(--space-4xl) var(--layout-margin) var(--space-5xl);"
            },
            {
              "selector": ".w-features::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-features__container",
              "css": "align-items: stretch;\ngap: 40px;\nmax-inline-size: min(var(--layout-frame), 100%);"
            },
            {
              "selector": ".w-features__head",
              "css": "align-items: center;\ngap: var(--space-xs);\ntext-align: center;"
            },
            {
              "selector": ".w-features .w-heading-xl",
              "css": "max-inline-size: 678px;"
            },
            {
              "selector": ".w-features .w-text-m",
              "css": "max-inline-size: 610px;"
            },
            {
              "selector": ".w-features .w-button-text",
              "css": "margin-block-start: var(--space-3xs);"
            },
            {
              "selector": ".w-features__grid",
              "css": "display: flex;\nflex-direction: column;\ngap: 1px;\npadding-block: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-features__row",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: 1px;"
            },
            {
              "selector": ".w-features__row--thirds",
              "css": "grid-template-columns: var(--columns-3);"
            },
            {
              "selector": ".w-features__row--full",
              "css": "grid-template-columns: minmax(0, 1fr);"
            },
            {
              "selector": ".w-features__stack",
              "css": "position: relative;\ndisplay: block;\nblock-size: 360px;\noverflow: hidden;\nbackground: var(--bg-surface-3);\n@media (max-width: 991px) {\n  block-size: auto;\n}"
            },
            {
              "selector": ".w-features__stack::after",
              "css": "content: \"\";\nposition: absolute;\ninset-inline-start: 0;\ninset-inline-end: 0;\ninset-block-end: 0;\nz-index: 4;\nblock-size: 2px;\nbackground: var(--active);\ntransform: scaleX(0);\ntransform-origin: 0 50%;\ntransition: transform 280ms;"
            },
            {
              "selector": ".w-features__stack:hover::after",
              "css": "transform: scaleX(1);"
            },
            {
              "selector": ".w-features__stack-text",
              "css": "position: absolute;\ninset-block-start: 0;\ninset-inline-start: 0;\ndisplay: flex;\nflex-direction: column;\njustify-content: center;\ninline-size: 588px;\nblock-size: 360px;\npadding: var(--space-l) var(--space-xl);\n@media (max-width: 991px) {\n  position: static;\n  inline-size: 100%;\n  block-size: auto;\n}"
            },
            {
              "selector": ".w-features__stack-copy",
              "css": "display: flex;\nflex-direction: column;\ngap: var(--space-2xs);\ninline-size: 484px;\nmax-inline-size: 100%;"
            },
            {
              "selector": ".w-features__stack-title",
              "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-features__stack-description",
              "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-features__stack-arrow",
              "css": "inline-size: 18px;\nblock-size: 18px;\nposition: absolute;\ninset-inline-end: var(--space-s);\ninset-block-end: var(--space-xs);\nz-index: 4;\ncolor: var(--accent);\nopacity: 0;\ntransform: translate(-3px, 3px);\ntransition: opacity 220ms, transform 220ms;"
            },
            {
              "selector": ".w-features__stack:hover .w-features__stack-arrow",
              "css": "opacity: 1;\ntransform: none;"
            },
            {
              "selector": ".w-features__diagram",
              "css": "position: absolute;\ninset-block-start: 0;\ninset-inline-start: 607px;\ninline-size: 592px;\nblock-size: 360px;\nbackground: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--bg-surface) 35%, transparent) 46%, color-mix(in srgb, var(--bg-surface) 75%, transparent) 100%);\n@media (max-width: 991px) {\n  display: none;\n}"
            },
            {
              "selector": ".w-features__diagram-wires",
              "css": "position: absolute;\ninset: 0;\ninline-size: 100%;\nblock-size: 100%;"
            },
            {
              "selector": ".w-features__diagram-tree",
              "css": "stroke: var(--border-subtle);\nopacity: 0.9;"
            },
            {
              "selector": ".w-features__diagram-flow",
              "css": "stroke: url(#w-features-flow);\nopacity: 0;\nanimation: w-features-flow 10s ease-in-out infinite;"
            },
            {
              "selector": ".w-features__diagram-pill",
              "css": "position: absolute;\ninset-block-start: 159px;\ninset-inline-start: 14px;\ndisplay: grid;\nplace-items: center;\ninline-size: 128px;\nblock-size: 42px;\nborder-radius: 10px;\nbackground: var(--bg-surface);\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xs);\nwhite-space: nowrap;\nbox-shadow: 0 1px 2px rgba(35, 38, 44, 0.06), 0 8px 20px -12px rgba(35, 38, 44, 0.35);"
            },
            {
              "selector": ".w-features__diagram-hub",
              "css": "position: absolute;\ninset-block-start: 161px;\ninset-inline-start: 161px;\ndisplay: grid;\nplace-items: center;\ninline-size: 38px;\nblock-size: 38px;\nborder-radius: 50%;\nbackground: var(--active);\ncolor: var(--all-light);\nbox-shadow: 0 0 0 5px color-mix(in srgb, var(--bg-surface) 90%, transparent), 0 0 0 6px var(--border-subtle), 0 6px 16px -6px rgba(21, 112, 239, 0.55);"
            },
            {
              "selector": ".w-features__diagram-card",
              "css": "position: absolute;\ninset-inline-start: 300px;\ninset-inline-end: 16px;\ndisplay: flex;\nflex-direction: row;\nalign-items: center;\ngap: 10px;\nblock-size: 72px;\npadding: 0 14px 0 12px;\nborder-radius: 14px;\nbackground: color-mix(in srgb, var(--bg-surface) 72%, transparent);\nbox-shadow: 0 1px 2px rgba(35, 38, 44, 0.05);\ntransform-origin: 0 50%;\nanimation: w-features-card 10s ease-in-out infinite;"
            },
            {
              "selector": ".w-features__diagram-card--first",
              "css": "inset-block-start: 18px;\nanimation-delay: -10s;"
            },
            {
              "selector": ".w-features__diagram-card--second",
              "css": "inset-block-start: 102px;\nanimation-delay: -7.5s;"
            },
            {
              "selector": ".w-features__diagram-card--third",
              "css": "inset-block-start: 186px;\nanimation-delay: -5s;"
            },
            {
              "selector": ".w-features__diagram-card--fourth",
              "css": "inset-block-start: 270px;\nanimation-delay: -2.5s;"
            },
            {
              "selector": ".w-features__diagram-mark",
              "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 34px;\nblock-size: 34px;\nborder-radius: 9px;\nbackground: var(--bg-surface-2);"
            },
            {
              "selector": ".w-features__diagram-logo",
              "css": "inline-size: 20px;\nblock-size: 20px;\nobject-fit: contain;"
            },
            {
              "selector": ".w-features__diagram-body",
              "css": "display: grid;\nflex: 1 1 auto;\ngap: 5px;\nmin-inline-size: 0;"
            },
            {
              "selector": ".w-features__diagram-name",
              "css": "font-size: 13px;\nfont-weight: var(--font-weight-strong);\nline-height: 1.1;\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-features__diagram-rows",
              "css": "display: grid;\ngap: var(--space-3xs);"
            },
            {
              "selector": ".w-features__diagram-skeleton",
              "css": "display: block;\nblock-size: 4px;\nborder-radius: 2px;\nbackground: var(--bg-surface-3);"
            },
            {
              "selector": ".w-features__diagram-description",
              "css": "font-size: 11px;\nline-height: 1.35;\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-features__diagram-radio",
              "css": "flex: 0 0 auto;\ninline-size: 14px;\nblock-size: 14px;\nborder-radius: 50%;\nbox-shadow: inset 0 0 0 1.5px var(--border-dark);"
            },
            {
              "selector": ".w-features__diagram-card--first .w-features__diagram-radio",
              "css": "box-shadow: inset 0 0 0 4px var(--active);"
            },
            {
              "selector": "@keyframes w-features-card",
              "css": "0%, 22% { background: color-mix(in srgb, var(--bg-surface) 97%, transparent); transform: scale(1.045); box-shadow: 0 2px 6px rgba(35, 38, 44, 0.06), 0 18px 34px -18px rgba(35, 38, 44, 0.45); }\n  28%, 100% { background: color-mix(in srgb, var(--bg-surface) 72%, transparent); transform: scale(1); box-shadow: 0 1px 2px rgba(35, 38, 44, 0.05); }"
            },
            {
              "selector": "@keyframes w-features-flow",
              "css": "0%, 22% { opacity: 1; } 28%, 100% { opacity: 0; }"
            },
            {
              "selector": ".w-features__row, .w-features__row--thirds",
              "css": "@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-security",
              "css": "padding: var(--space-5xl) var(--layout-margin);"
            },
            {
              "selector": ".w-security__container",
              "css": "align-items: stretch;\ngap: var(--space-2xl);\nmax-inline-size: min(var(--layout-frame), 100%);"
            },
            {
              "selector": ".w-security__head",
              "css": "display: flex;\nflex-direction: row;\njustify-content: space-between;\nalign-items: flex-end;\ngap: var(--space-2xl);"
            },
            {
              "selector": ".w-security__headline",
              "css": "flex: 0 1 520px;"
            },
            {
              "selector": ".w-security .w-eyebrow",
              "css": "margin-block-end: var(--space-xs);"
            },
            {
              "selector": ".w-security .w-text-m",
              "css": "flex: 0 1 540px;"
            },
            {
              "selector": ".w-security__body",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 9fr) minmax(0, 11fr);\ngap: var(--space-l);\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-security__record",
              "css": "display: flex;\nflex-direction: column;\noverflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--bg-night-2);"
            },
            {
              "selector": ".w-security__record-title",
              "css": "padding: var(--space-s) var(--space-l);\nborder-block-end: var(--stroke-subtle);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-security__record-list",
              "css": "display: flex;\nflex-direction: column;\ngap: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-security__record-item",
              "css": "background: var(--bg-night-2);"
            },
            {
              "selector": ".w-security__record-link",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-2xs);\npadding: var(--space-s) var(--space-l);"
            },
            {
              "selector": ".w-security__record-top",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\nalign-items: center;\ngap: var(--space-2xs);"
            },
            {
              "selector": ".w-security__record-name",
              "css": "font-size: var(--text-m);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);\nbackground: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: color var(--duration-fast), background-size var(--duration-slow) var(--ease-reveal);"
            },
            {
              "selector": ".w-security__record-link:is(:hover, :focus-visible) .w-security__record-name",
              "css": "color: var(--hover);\nbackground-position: left bottom;\nbackground-size: 100% 1px;"
            },
            {
              "selector": ".w-security__record-chip",
              "css": "padding: var(--space-3xs) var(--space-2xs);\nborder-radius: var(--radius-s);\nbackground: var(--bg-night-3);\nfont-size: var(--text-xs);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-security__record-meta",
              "css": "font-size: var(--text-xs);\nline-height: var(--line-height-xl);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-security__record-more",
              "css": "margin-block-start: auto;\npadding: var(--space-s) var(--space-l);\nborder-block-start: var(--stroke-subtle);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\ncolor: var(--text-highlight);"
            },
            {
              "selector": ".w-security__record-more-label",
              "css": "background: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: background-size var(--duration-slow) var(--ease-reveal);"
            },
            {
              "selector": ".w-security__record-more:is(:hover, :focus-visible) .w-security__record-more-label",
              "css": "background-position: left bottom;\nbackground-size: 100% 1px;"
            },
            {
              "selector": ".w-security__cards",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: var(--space-s);\n@media (max-width: 478px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-security__foot",
              "css": "display: flex;\nflex-direction: row;\njustify-content: space-between;\nalign-items: center;\ngap: var(--space-xl);"
            },
            {
              "selector": ".w-security__actions",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\ngap: var(--space-s);"
            },
            {
              "selector": ".w-security__stats",
              "css": "display: flex;\nflex-direction: row;\ngap: var(--space-2xl);"
            },
            {
              "selector": ".w-security__head, .w-security__foot",
              "css": "@media (max-width: 991px) {\n  flex-direction: column;\n  align-items: flex-start;\n}"
            },
            {
              "selector": ".w-agents",
              "css": "position: relative;\npadding: 0 var(--layout-margin) var(--space-5xl);"
            },
            {
              "selector": ".w-agents::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-agents__container",
              "css": "align-items: stretch;\nmax-inline-size: min(var(--layout-frame), 100%);\noverflow: hidden;\nborder-block-end: var(--stroke-subtle);"
            },
            {
              "selector": ".w-agents__head",
              "css": "position: relative;\nisolation: isolate;\nalign-items: center;\ngap: var(--space-s);\ntext-align: center;\npadding: var(--space-xl) var(--space-xl) var(--space-2xl);\nborder-block-end: var(--stroke-subtle);"
            },
            {
              "selector": ".w-agents__head::before",
              "css": "content: \"\";\nposition: absolute;\ninset: 0;\nz-index: -1;\npointer-events: none;\nbackground-image: var(--pattern-dots);\nbackground-size: 22px 22px;\nbackground-position: center top;\nmask-image: radial-gradient(100% 80% at 50% 45%, #000 0%, transparent 75%);"
            },
            {
              "selector": ".w-agents .w-heading-xl",
              "css": "max-inline-size: 678px;"
            },
            {
              "selector": ".w-agents .w-text-m",
              "css": "max-inline-size: 610px;"
            },
            {
              "selector": ".w-agents__showcase",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 5fr) minmax(0, 6fr);\nalign-items: center;\ngap: var(--space-3xl);\npadding: 72px var(--space-3xl);\nborder-block-start: var(--stroke-subtle);\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n  padding: var(--space-2xl) var(--space-l);\n}"
            },
            {
              "selector": ".w-agents__copy",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;"
            },
            {
              "selector": ".w-agents .w-heading-m",
              "css": "margin-block-end: var(--space-s);"
            },
            {
              "selector": ".w-agents__lede",
              "css": "max-inline-size: 380px;\nmargin-block-end: var(--space-m);\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-agents__tiles",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: 1px;\noverflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-agents__ways",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: 1px;\npadding-block-start: 1px;\nbackground: var(--border-subtle);\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-git-deploy",
              "css": "position: relative;\npadding-block-start: var(--space-2xl);"
            },
            {
              "selector": ".w-git-deploy::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: 1px solid transparent;\nborder-image: linear-gradient(to bottom, var(--border-subtle) 55%, var(--bg-body) 100%) 1;"
            },
            {
              "selector": ".w-git-deploy__container",
              "css": "flex-direction: row;\nalign-items: stretch;\ngap: var(--space-2xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-inline-start: var(--space-2xl);\nbackground: var(--bg-surface);\n@media (max-width: 991px) {\n  flex-direction: column;\n  padding-inline: var(--space-l);\n}"
            },
            {
              "selector": ".w-git-deploy__text",
              "css": "display: flex;\nflex-direction: column;\njustify-content: space-between;\nflex: 0 0 414px;\npadding-block: var(--space-2xl);\n@media (max-width: 991px) {\n  flex-basis: auto;\n}"
            },
            {
              "selector": ".w-git-deploy__head",
              "css": "gap: var(--space-2xs);"
            },
            {
              "selector": ".w-git-deploy__body",
              "css": "align-items: flex-start;\ngap: var(--space-l);\ninline-size: 412px;\nmax-inline-size: 100%;"
            },
            {
              "selector": ".w-git-deploy__points",
              "css": "display: flex;\nflex-direction: column;\ngap: var(--space-xs);"
            },
            {
              "selector": ".w-git-deploy__point",
              "css": "display: flex;\nflex-direction: row;\nalign-items: flex-start;\ngap: var(--space-2xs);\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-git-deploy__check",
              "css": "inline-size: 18px;\nblock-size: 18px;\nmargin-block-start: 1px;\nflex: 0 0 auto;\ncolor: var(--accent);"
            },
            {
              "selector": ".w-git-deploy__visual",
              "css": "position: relative;\nflex: 0 0 auto;\nalign-self: flex-start;\ninline-size: 690px;\naspect-ratio: 1380 / 1384;\noverflow: hidden;\n@media (max-width: 1279px) {\n  inline-size: 50%;\n}\n@media (max-width: 991px) {\n  inline-size: 100%;\n}"
            },
            {
              "selector": ".w-git-deploy__background",
              "css": "position: absolute;\ninset: 0;\ninline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
            },
            {
              "selector": ".w-git-deploy__illustration",
              "css": "position: absolute;\nz-index: 2;\ninset-block-start: 9%;\ninset-inline-start: 8.3%;\ninline-size: 91.6%;"
            },
            {
              "selector": ".w-git-deploy__fade",
              "css": "position: absolute;\nz-index: 3;\ninset-inline-start: 0;\ninset-block-end: 0;\ninline-size: 100%;\nblock-size: 20%;\npointer-events: none;\nbackground: linear-gradient(transparent 0%, var(--bg-body) 89.66%);"
            },
            {
              "selector": ".w-ai-assistant",
              "css": "padding: var(--space-4xl) var(--space-l) var(--space-5xl);"
            },
            {
              "selector": ".w-ai-assistant__container",
              "css": "align-items: stretch;\nmax-inline-size: min(var(--layout-frame), 100%);"
            },
            {
              "selector": ".w-ai-assistant__band",
              "css": "position: relative;\nisolation: isolate;\ninline-size: 100%;\naspect-ratio: 1200 / 600;\noverflow: hidden;\nborder-radius: var(--radius-l);\nbackground: var(--bg-deep);\n@media (max-width: 991px) {\n  aspect-ratio: auto;\n  padding: var(--space-xl);\n}"
            },
            {
              "selector": ".w-ai-assistant__background",
              "css": "position: absolute;\ninset: 0;\nz-index: 0;\ninline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
            },
            {
              "selector": ".w-ai-assistant__dashboard",
              "css": "position: absolute;\nz-index: 1;\ninset-block-start: 8%;\ninset-inline-start: 0;\ninline-size: 44.333%;\npointer-events: none;"
            },
            {
              "selector": ".w-ai-assistant__chat",
              "css": "position: absolute;\nz-index: 1;\ninset-block-start: 14.333%;\ninset-inline-start: 27.083%;\ninline-size: 17.25%;\npointer-events: none;"
            },
            {
              "selector": ".w-ai-assistant__content",
              "css": "position: absolute;\nz-index: 2;\ninset-block-start: calc(50% - 6px);\ninset-inline-start: 51%;\ninline-size: 43.833%;\ntransform: translateY(-50%);\ndisplay: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);\n@media (max-width: 991px) {\n  position: relative;\n  inset-block-start: auto;\n  inset-inline-start: auto;\n  inline-size: 100%;\n  transform: none;\n}"
            },
            {
              "selector": ".w-ai-assistant .w-heading-l",
              "css": "line-height: var(--line-height-s);\nletter-spacing: -1.08px;\ncolor: var(--text-contrast);"
            },
            {
              "selector": ".w-ai-assistant .w-text-l",
              "css": "color: var(--text-contrast-body);"
            },
