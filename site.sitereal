      "headingMinRatio": 1.25,
      "headingMaxSize": 20,
      "headingMaxRatio": 1.333,
      "sizeOverrides": {},
      "colorOverrides": {},
      "headingFont": "system-ui, sans-serif",
      "textFont": "system-ui, sans-serif",
