      ],
      "stylesheets": [
        {
          "id": "tpl-tplcss-main-footer",
          "name": "Footer",
          "rules": [
            {
              "selector": ".w-footer",
              "css": "position: relative;"
            },
            {
              "selector": ".w-footer::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100%);\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-footer__container",
              "css": "align-items: stretch;\nmax-inline-size: min(var(--layout-frame), 100%);"
            },
            {
              "selector": ".w-footer__cta",
              "css": "align-items: center;\nblock-size: 536px;\noverflow: hidden;\ntext-align: center;"
            },
            {
              "selector": ".w-footer__cta-visual",
              "css": "inline-size: 742px;\nmax-inline-size: 100%;\nmargin: 21px auto 0;"
            },
            {
              "selector": ".w-footer__cta-image",
              "css": "inline-size: 100%;"
            },
            {
              "selector": ".w-footer__cta-copy",
              "css": "display: flex;\nflex-direction: column;\nalign-items: center;\ngap: var(--space-xs);\nmargin-block-start: 18px;"
            },
            {
              "selector": ".w-footer .w-heading-l",
              "css": "max-inline-size: 588px;"
            },
            {
              "selector": ".w-footer__cta-text",
              "css": "max-inline-size: 482px;\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-footer__cta-actions",
              "css": "display: flex;\nflex-direction: row;\njustify-content: center;\ngap: var(--space-s);\nmargin-block-start: var(--space-xl);"
            },
            {
              "selector": ".w-footer__guarantees",
              "css": "display: grid;\ngrid-template-columns: var(--columns-4);\ngap: 1px;\npadding-block: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-footer__brand",
              "css": "display: flex;\nflex-direction: row;\nalign-items: flex-end;\ngap: 40px;\npadding: var(--space-xl);\nborder-block-end: var(--stroke-subtle);\n@media (max-width: 991px) {\n  flex-direction: column;\n  align-items: stretch;\n}"
            },
            {
              "selector": ".w-footer__intro",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-m);\nflex: 552 1 0;"
            },
            {
              "selector": ".w-footer__logo",
              "css": "inline-size: auto;\nblock-size: 28px;"
            },
            {
              "selector": ".w-footer__tagline",
              "css": "font-size: var(--text-m);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-footer__ask",
              "css": "display: flex;\nflex-direction: column;\ngap: 10px;"
            },
            {
              "selector": ".w-footer__label",
              "css": "font-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ntext-transform: uppercase;\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-footer__label-brand",
              "css": "text-transform: none;"
            },
            {
              "selector": ".w-footer__ask-list",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\ngap: var(--space-2xs);"
            },
            {
              "selector": ".w-footer__ask-item",
              "css": "display: block;"
            },
            {
              "selector": ".w-footer__ask-link",
              "css": "display: grid;\nplace-items: center;\ninline-size: 40px;\nblock-size: 40px;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-s);\ntransition: background-color var(--duration-fast);"
            },
            {
              "selector": ".w-footer__ask-link:hover",
              "css": "background: var(--bg-base-3);"
            },
            {
              "selector": ".w-footer__ask-icon",
              "css": "inline-size: 20px;\nblock-size: 20px;\nfilter: brightness(0) invert(1);\nopacity: 0.72;\ntransition: opacity var(--duration-fast);"
            },
            {
              "selector": ".w-footer__ask-link:hover .w-footer__ask-icon",
              "css": "opacity: 1;"
            },
            {
              "selector": ".w-footer__subscribe",
              "css": "display: flex;\nflex-direction: column;\nalign-items: stretch;\ngap: var(--space-2xs);\nflex: 544 1 0;"
            },
            {
              "selector": ".w-footer__menus",
              "css": "display: grid;\ngrid-template-columns: var(--columns-4);\ngap: 1px;\npadding-block-end: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-footer__menu-stack",
              "css": "display: flex;\nflex-direction: column;\ngap: 1px;\nmin-inline-size: 0;"
            },
            {
              "selector": ".w-footer .w-menu-column",
              "css": "flex: 0 0 auto;\nbackground: var(--bg-base);"
            },
            {
              "selector": ".w-footer .w-menu-column:last-child",
              "css": "flex-grow: 1;"
            },
            {
              "selector": ".w-footer__bottom",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: 1px;\npadding-block-end: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-footer__address",
              "css": "position: relative;\ndisplay: flex;\nflex-direction: column;\njustify-content: flex-end;\ngap: var(--space-xs);\npadding: var(--space-xl) var(--space-l);\noverflow: hidden;\nbackground: var(--bg-base);"
            },
            {
              "selector": ".w-footer__address-dots",
              "css": "position: absolute;\ninset-block-start: 0;\ninset-inline-end: -1px;\ninline-size: 192px;"
            },
            {
              "selector": ".w-footer__address-label",
              "css": "font-size: var(--text-xs);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-footer__address-text",
              "css": "font-size: var(--text-s);\nline-height: var(--line-height-3xl);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-footer__social",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngrid-auto-rows: 64px;\ngap: 1px;"
            },
            {
              "selector": ".w-footer__social-item",
              "css": "display: flex;\nbackground: var(--bg-base);"
            },
            {
              "selector": ".w-footer__social-item--alt",
              "css": "background: var(--bg-base-3);"
            },
            {
              "selector": ".w-footer__legal",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: 1px;\nbackground: var(--border-subtle);"
            },
            {
              "selector": ".w-footer__legal-cell",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\nmin-block-size: 70px;\npadding: var(--space-l);\nbackground: var(--bg-base);"
            },
            {
              "selector": ".w-footer__legal-text",
              "css": "font-size: var(--text-m);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-footer__legal-text--muted",
              "css": "color: var(--text-body-dark);"
            },
            {
              "selector": ".w-footer__legal-muted",
              "css": "color: var(--text-body-dark);"
            },
            {
              "selector": ".w-footer__legal-link",
              "css": "color: var(--text-title);\nbackground:\n    linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat,\n    linear-gradient(color-mix(in srgb, currentColor 35%, transparent), color-mix(in srgb, currentColor 35%, transparent)) left bottom / 100% 1px no-repeat;\ntransition: background-size var(--duration-slow) var(--ease-reveal);"
            },
            {
              "selector": ".w-footer__legal-link:is(:hover, :focus-visible)",
              "css": "background-position: left bottom, left bottom;\nbackground-size: 100% 1px, 100% 1px;"
            },
            {
              "selector": ".w-footer__guarantees, .w-footer__menus",
              "css": "@media (max-width: 991px) {\n  grid-template-columns: var(--columns-2);\n}\n@media (max-width: 478px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-footer__bottom, .w-footer__legal",
              "css": "@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            }
          ]
        }
      ],
      "applyTo": {
        "all": true
      }
    },
