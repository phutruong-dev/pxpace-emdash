            "kind": "color",
            "color": "secondary",
            "on": true,
            "builtin": true
          },
          {
            "id": "tertiary",
            "label": "Tertiary",
            "kind": "color",
            "color": "tertiary",
            "on": true,
            "builtin": true
          },
          {
