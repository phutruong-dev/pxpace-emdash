      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".w-docs-hub",
              "css": "position: relative;\npadding-inline: var(--layout-margin);"
            },
            {
              "selector": ".w-docs-hub::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-docs-hub__container",
              "css": "position: relative;\ndisplay: grid;\ngrid-template-columns: var(--layout-docs-sidebar) minmax(0, 1fr);\nalign-items: start;\ncolumn-gap: var(--space-xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding: var(--space-xl) var(--space-l) var(--space-5xl);\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n  padding-block-start: var(--space-l);\n}\n@media (max-width: 767px) {\n  padding-inline: var(--space-s);\n}"
            },
            {
              "selector": ".w-docs-hub__container::before",
              "css": "content: \"\";\nposition: absolute;\ninset-block-start: 0;\ninset-block-end: 0;\npointer-events: none;\ninset-inline-start: calc(var(--space-l) + var(--layout-docs-sidebar) + var(--space-xl) / 2);\nborder-inline-start: var(--stroke-subtle);\n@media (max-width: 991px) {\n  display: none;\n}"
            },
            {
              "selector": ".w-docs-hub__main",
              "css": "display: flex;\nflex-direction: column;\nflex-wrap: nowrap;\nalign-items: stretch;\nmin-inline-size: 0;"
            },
            {
              "selector": ".w-docs-hub__hero",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);\npadding: var(--space-2xs) 0 var(--space-xl);\nborder-block-end: var(--stroke-subtle);"
            },
            {
              "selector": ".w-docs-hub__hero-row",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\njustify-content: space-between;\ngap: var(--space-s);\ninline-size: 100%;"
            },
            {
              "selector": ".w-docs-hub__tools",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: var(--space-2xs);"
            },
            {
              "selector": ".w-docs-hub .w-heading-xl",
              "css": "max-inline-size: 30ch;\ntext-wrap: balance;"
            },
            {
              "selector": ".w-docs-hub .w-text-l",
              "css": "max-inline-size: 60ch;\nfont-size: var(--text-l);\nline-height: var(--line-height-3xl);"
            },
            {
              "selector": ".w-docs-hub__quick",
              "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: var(--space-s);\nmargin: var(--space-xl) 0 var(--space-3xl);\n@media (max-width: 767px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-docs-hub__browse",
              "css": "display: flex;\nflex-direction: column;\nflex-wrap: nowrap;\nalign-items: stretch;\ngap: var(--space-2xl);"
            },
            {
              "selector": ".w-docs-hub__browse-head",
              "css": "display: flex;\nflex-direction: row;\nalign-items: flex-end;\njustify-content: space-between;\ngap: var(--space-l);\n@media (max-width: 767px) {\n  flex-direction: column;\n  align-items: stretch;\n}"
            },
            {
              "selector": ".w-docs-hub__browse-intro",
              "css": "display: flex;\nflex-direction: column;\ngap: var(--space-3xs);"
            },
            {
              "selector": ".w-docs-hub__browse-search",
              "css": "flex: 0 0 auto;\ninline-size: min(320px, 42%);\n@media (max-width: 767px) {\n  inline-size: 100%;\n}"
            },
            {
              "selector": ".w-docs-hub__group",
              "css": "display: flex;\nflex-direction: column;\nflex-wrap: nowrap;\nalign-items: stretch;\ngap: var(--space-s);"
            },
            {
              "selector": ".w-docs-hub__group-label",
              "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-docs-hub__group-label::after",
              "css": "content: \"\";\nflex: 1 1 auto;\nborder-block-start: var(--stroke-subtle);"
            },
            {
              "selector": ".w-docs-hub__group-number",
              "css": "color: var(--accent);"
            },
            {
              "selector": ".w-docs-hub__grid",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: 1px;\nborder: var(--stroke-subtle);\nbackground: var(--bg-surface);\n@media (max-width: 991px) {\n  grid-template-columns: var(--columns-2);\n}\n@media (max-width: 767px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".w-docs-hub .w-docs-topic",
              "css": "box-shadow: 0 0 0 1px var(--border-subtle);"
            }
          ]
        }
      ]
    },
