        },
        {
          "selector": ".w-button-ripple--from-right:is(:hover, :focus-visible) .w-button-ripple__fill",
          "css": "transform: translateX(-100%);"
        },
        {
          "selector": ".w-button-ripple--from-bottom:is(:hover, :focus-visible) .w-button-ripple__label, .w-button-ripple--from-left:is(:hover, :focus-visible) .w-button-ripple__label, .w-button-ripple--from-right:is(:hover, :focus-visible) .w-button-ripple__label",
          "css": "transform: translateY(160%) skewY(-10deg);"
        },
        {
          "selector": ".w-button-ripple--from-bottom:is(:hover, :focus-visible) .w-button-ripple__label-next, .w-button-ripple--from-left:is(:hover, :focus-visible) .w-button-ripple__label-next, .w-button-ripple--from-right:is(:hover, :focus-visible) .w-button-ripple__label-next",
          "css": "transform: none;"
        },
        {
          "selector": ".w-button-dot",
          "css": "display: inline-flex;\nalign-items: center;\nalign-self: flex-start;\ngap: var(--space-xs);\nmin-block-size: 24px;\ncursor: pointer;\nwhite-space: nowrap;\nfont-size: var(--text-m);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-l);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-button-dot__bullet",
          "css": "display: flex;\nalign-items: center;\njustify-content: center;\nflex: 0 0 auto;\ninline-size: 8px;\nblock-size: 8px;\noverflow: hidden;\nborder-radius: var(--radius-full);\nbackground: var(--accent);\ncolor: var(--all-light);\ntransition: width var(--duration-reveal) var(--ease-reveal), height var(--duration-reveal) var(--ease-reveal);"
        },
        {
          "selector": ".w-button-dot__icon",
          "css": "flex: 0 0 auto;\ninline-size: 14px;\nblock-size: 14px;\ntransform: translateX(-24px);\ntransition: transform var(--duration-reveal) var(--ease-reveal);"
        },
        {
          "selector": ".w-button-dot__label",
          "css": "position: relative;\ndisplay: block;"
        },
        {
          "selector": ".w-button-dot__label::after",
          "css": "content: \"\";\nposition: absolute;\ninset-inline-start: 0;\ninset-inline-end: 0;\ninset-block-end: -2px;\nblock-size: 1px;\nbackground: currentColor;\ntransform-origin: right center;\ntransition: transform var(--duration-reveal) var(--ease-reveal);"
        },
        {
          "selector": ".w-button-dot:is(:hover, :focus-visible) .w-button-dot__bullet",
          "css": "inline-size: 24px;\nblock-size: 24px;"
        },
        {
          "selector": ".w-button-dot:is(:hover, :focus-visible) .w-button-dot__icon",
          "css": "transform: translateX(0);"
        },
        {
          "selector": ".w-button-dot:is(:hover, :focus-visible) .w-button-dot__label::after",
          "css": "transform: scaleX(0);"
        },
        {
          "selector": ".w-button-nudge",
          "css": "position: relative;\ndisplay: inline-flex;\npadding: 3px;\nborder-radius: calc(var(--radius-s) + 3px);\ncursor: pointer;\nwhite-space: nowrap;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\nbackground: var(--bg-accent);"
        },
        {
          "selector": ".w-button-nudge__face",
          "css": "position: relative;\nz-index: 1;\ndisplay: inline-flex;\nalign-items: center;\nblock-size: 48px;\npadding-inline: var(--space-m);\nborder-radius: var(--radius-s);\ncolor: var(--btn-primary-fg);\nbackground: var(--btn-primary-bg);\nbox-shadow: var(--btn-primary-shadow-hover);"
        },
        {
          "selector": ".w-button-nudge__note",
          "css": "position: absolute;\ninset: 0;\ndisplay: flex;\njustify-content: center;\nborder-radius: inherit;\nbackground: var(--bg-accent);\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-button-nudge__note-text",
          "css": "display: flex;\nalign-items: center;\nblock-size: 24px;\nfont-size: var(--text-xs);\ncolor: transparent;\nbackground: var(--btn-nudge-shimmer) 0 0 / 250% 100%;\n-webkit-background-clip: text;\nbackground-clip: text;\nanimation: w-shimmer 2.4s linear infinite;"
        },
        {
          "selector": ".w-button-nudge:is(:hover, :focus-visible) .w-button-nudge__note",
          "css": "transform: translateY(-21px);"
        },
        {
          "selector": "@keyframes w-shimmer",
          "css": "from { background-position-x: 100%; } to { background-position-x: 0%; }"
        },
        {
          "selector": ".w-button-glow",
          "css": "position: relative;\nisolation: isolate;\ndisplay: inline-flex;\nflex: 0 0 auto;\noverflow: hidden;\npadding: 1px;\nborder-radius: var(--radius-s);\ncursor: pointer;\nwhite-space: nowrap;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ncolor: var(--btn-outline-fg);\nbackground: var(--btn-outline-ring);\ntransition: box-shadow var(--duration-slow);"
        },
        {
          "selector": ".w-button-glow::before",
          "css": "content: \"\";\nposition: absolute;\nz-index: -1;\ninset-block-start: 50%;\ninset-inline-start: 50%;\ninline-size: 150%;\naspect-ratio: 1;\ntranslate: -50% -50%;\nbackground: var(--btn-glow-gradient);\nanimation: w-spin 3s linear infinite;"
        },
        {
          "selector": ".w-button-glow:is(:hover, :focus-visible)",
          "css": "box-shadow: var(--btn-glow-shadow);"
        },
        {
          "selector": ".w-button-glow__face",
          "css": "display: inline-flex;\nalign-items: center;\ngap: var(--space-2xs);\nblock-size: 46px;\npadding-inline: var(--space-m);\nborder-radius: calc(var(--radius-s) - 1px);\nbackground: var(--btn-outline-bg);"
        },
        {
          "selector": ".w-button-glow__label",
          "css": "display: block;"
        },
        {
          "selector": ".w-button-glow__icon",
          "css": "flex: 0 0 auto;\ninline-size: 16px;\nblock-size: 16px;\ncolor: var(--accent);"
        },
        {
          "selector": "@keyframes w-spin",
          "css": "to { rotate: 1turn; }"
        },
        {
          "selector": ".w-button-secondary:is(:hover, :focus-visible)::after, .w-button-track:is(:hover, :focus-visible) .w-button-track__chevrons, .w-button-marquee__track, .w-button-nudge__note-text, .w-button-glow::before",
          "css": "@media (prefers-reduced-motion: reduce) {\n  animation: none;\n}"
        },
        {
          "selector": ".w-badge-rating",
          "css": "display: inline-flex;\nalign-items: center;\njustify-content: center;\ngap: var(--space-3xs);\npadding: 6px var(--space-2xs);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\nbox-shadow: inset 0 0 0 1px var(--border-subtle);\ntransition: box-shadow var(--duration-fast), background-color var(--duration-fast);"
        },
        {
          "selector": ".w-badge-rating:hover",
          "css": "background: var(--badge-rating-bg-hover);\nbox-shadow: inset 0 0 0 1px var(--border-light);"
        },
        {
          "selector": ".w-badge-rating__icon",
          "css": "inline-size: 12px;\nblock-size: 12px;\nflex: 0 0 auto;\ncolor: var(--badge-rating-star);"
        },
        {
          "selector": ".w-badge-rating__text",
          "css": "font-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ncolor: var(--badge-rating-fg);\nwhite-space: nowrap;"
        },
        {
          "selector": ".w-badge",
          "css": "display: inline-block;\npadding: 2px var(--space-2xs);\nborder-radius: var(--radius-s);\nvertical-align: 1px;\nbackground: var(--bg-accent);\ncolor: var(--text-badge);\nwhite-space: nowrap;\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 18%, transparent);\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nletter-spacing: 0.2px;\nline-height: var(--line-height-2xl);"
        },
        {
          "selector": ".w-badge-pill",
          "css": "display: inline-flex;\nalign-items: center;\nalign-self: flex-start;\npadding: 3px var(--space-2xs);\nborder-radius: var(--radius-s);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\nwhite-space: nowrap;\nbackground: linear-gradient(110deg, var(--bg-accent-2) 0%, var(--bg-accent) 100%);\ncolor: var(--badge-pill-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 20%, transparent);"
        },
        {
          "selector": ".w-badge-pill--dark",
          "css": "font-size: var(--text-xs);\nbackground: var(--badge-pill-dark-bg);\ncolor: var(--badge-pill-dark-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--badge-pill-dark-fg) 22%, transparent);"
        },
        {
          "selector": ".w-badge-pill__icon",
          "css": "inline-size: 12px;\nblock-size: 12px;\nmargin-inline-end: var(--space-3xs);\nflex: 0 0 auto;\ncolor: var(--text-highlight);"
        },
        {
          "selector": ".w-badge-pill--dark .w-badge-pill__icon",
          "css": "color: var(--badge-pill-dark-fg);"
        },
        {
          "selector": ".is-in .w-badge-pill__icon, .w-badge-pill:hover .w-badge-pill__icon",
          "css": "animation: w-sparkle 1.6s ease-in-out 0.4s 3;"
        },
        {
          "selector": "@keyframes w-sparkle",
          "css": "0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }\n  50% { opacity: 0.65; transform: scale(1.35) rotate(18deg); }"
        },
        {
          "selector": ".w-chip",
          "css": "display: inline-flex;\nalign-items: center;\npadding: var(--space-3xs) 10px;\nborder-radius: var(--radius-full);\nbackground: var(--bg-accent);\nfont-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-chip);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 14%, transparent);"
        },
        {
          "selector": ".w-tag",
          "css": "padding: var(--space-3xs) var(--space-2xs);\nborder: 1px solid var(--primary);\nborder-radius: var(--radius-xs);\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xs);\ncolor: var(--text-highlight);"
        },
        {
          "selector": ".w-pill",
          "css": "display: inline-flex;\nalign-items: center;\ngap: 5px;\npadding: 2px 8px 2px 6px;\nborder-radius: var(--radius-full);\nwhite-space: nowrap;\nfont-size: 10px;\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);"
        },
        {
          "selector": ".w-pill::before",
          "css": "content: \"\";\nflex: 0 0 auto;\ninline-size: 6px;\nblock-size: 6px;\nborder-radius: var(--radius-full);"
        },
        {
          "selector": ".w-pill--success",
          "css": "background: var(--success-bg);\ncolor: var(--success-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--success) 24%, transparent);"
        },
        {
          "selector": ".w-pill--success::before",
          "css": "background: var(--success);"
        },
        {
          "selector": ".w-pill--warning",
          "css": "background: var(--warning-bg);\ncolor: var(--warning-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warning) 24%, transparent);"
        },
        {
          "selector": ".w-pill--warning::before",
          "css": "background: var(--warning);"
        },
        {
          "selector": ".w-pill--error",
          "css": "background: var(--error-bg);\ncolor: var(--error-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--error) 24%, transparent);"
        },
        {
          "selector": ".w-pill--error::before",
          "css": "background: var(--error);"
        },
        {
          "selector": ".w-toggle",
          "css": "display: inline-flex;\nalign-items: center;\njustify-content: flex-start;\nflex: 0 0 auto;\ninline-size: 105.6px;\npadding: 2.933px;\nborder: 0;\nborder-radius: 25.35px;\ncursor: pointer;\nbackground: var(--toggle-track);\nbox-shadow: inset 0 0 2.933px 0.733px rgba(136, 145, 168, 0.5);\ntransition: background-color 350ms;"
        },
        {
          "selector": ".w-toggle[aria-checked=\"true\"]",
          "css": "background: var(--active);"
        },
        {
          "selector": ".w-toggle__knob",
          "css": "inline-size: 58.667px;\nblock-size: 38.133px;\nborder-radius: 21.28px;\nborder: 1px solid var(--all-light);\nbackground: var(--toggle-knob);\nbox-shadow: 0 2px 4px rgba(26, 63, 115, 0.2), inset 0 0 8px 2px var(--all-light);\ntransition: transform 350ms var(--ease-spring);"
        },
        {
          "selector": ".w-toggle[aria-checked=\"true\"] .w-toggle__knob",
          "css": "transform: translateX(41.067px);"
        },
        {
          "selector": ".w-theme-toggle",
          "css": "display: inline-grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 40px;\nblock-size: 40px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\ncursor: pointer;\ncolor: var(--text-title);\nbackground: var(--btn-outline-bg);\nbox-shadow: var(--btn-outline-shadow);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-theme-toggle:hover",
          "css": "background: var(--btn-outline-bg-hover);"
        },
        {
          "selector": ".w-theme-toggle__icon",
          "css": "grid-area: 1 / 1;\ninline-size: 18px;\nblock-size: 18px;\ntransition: opacity var(--duration-base), transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-theme-toggle__icon--sun",
          "css": "opacity: 0;\ntransform: rotate(-45deg) scale(0.6);"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-theme-toggle__icon--sun",
          "css": "opacity: 1;\ntransform: none;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-theme-toggle__icon--moon",
          "css": "opacity: 0;\ntransform: rotate(45deg) scale(0.6);"
        },
        {
          "selector": ".w-field",
          "css": "display: flex;\nalign-items: center;\njustify-content: space-between;\nblock-size: 48px;\npadding: 0 var(--space-2xs) 0 var(--space-s);\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\ntransition: border-color var(--duration-fast);"
        },
        {
          "selector": ".w-field:focus-within",
          "css": "border-color: var(--focus);"
        },
        {
          "selector": ".w-field--dark",
          "css": "background: var(--bg-base-2);\nborder-color: var(--border-base);\nbox-shadow: var(--shadow-s);"
        },
        {
          "selector": ".w-field__input",
          "css": "flex: 1 1 0%;\nmin-inline-size: 0;\nborder: 0;\nbackground: none;\noutline: none;\nfont-size: var(--text-s);\nline-height: var(--line-height-m);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-field__input::placeholder",
          "css": "color: var(--text-body-dark);"
        },
        {
          "selector": ".w-field__button",
          "css": "flex: 0 0 auto;\nblock-size: 32px;\npadding-inline: var(--space-xs);\nborder: 0;\nborder-radius: var(--radius-xs);\nbackground: var(--active);\ncolor: var(--all-light);\ncursor: pointer;\nopacity: 0.2;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ntransition: opacity var(--duration-base);"
        },
        {
          "selector": ".w-field:focus-within .w-field__button, .w-field__button:hover",
          "css": "opacity: 1;"
        },
        {
          "selector": ".w-form",
          "css": "display: grid;\ngrid-template-columns: repeat(2, minmax(0, 1fr));\ngap: var(--space-m) var(--space-s);\ninline-size: 100%;\n@media (max-width: 767px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
        },
        {
          "selector": ".w-form__actions",
          "css": "grid-column: 1 / -1;\ndisplay: flex;\nflex-wrap: wrap;\nalign-items: center;\ngap: var(--space-xs) var(--space-s);\npadding-block-start: var(--space-3xs);"
        },
        {
          "selector": ".w-form__note",
          "css": "flex: 1 1 220px;\nfont-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-form__required",
          "css": "color: var(--error);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-form__status",
          "css": "grid-column: 1 / -1;\ndisplay: none;\nalign-items: center;\ngap: var(--space-2xs);\npadding: var(--space-xs) var(--space-s);\nborder-radius: var(--radius-s);\nbackground: var(--success-bg);\ncolor: var(--success-fg);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--success) 24%, transparent);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);"
        },
        {
          "selector": ".w-form.is-sent .w-form__status",
          "css": "display: flex;\nanimation: w-field-in var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-form__status-icon",
          "css": "inline-size: 18px;\nblock-size: 18px;\nflex: 0 0 auto;\nfill: none;\nstroke: currentColor;\nstroke-width: 1.6;\nstroke-linecap: round;\nstroke-linejoin: round;"
        },
        {
          "selector": ".w-form__status-tick",
          "css": "stroke-dasharray: 10;\nstroke-dashoffset: 10;"
        },
        {
          "selector": ".w-form__status-ring",
          "css": "opacity: 0.35;"
        },
        {
          "selector": ".w-form.is-sent .w-form__status-tick",
          "css": "animation: w-draw 400ms var(--ease-standard) 150ms forwards;"
        },
        {
          "selector": "@keyframes w-field-in",
          "css": "from { opacity: 0; transform: translateY(-4px); }"
        },
        {
          "selector": "@keyframes w-draw",
          "css": "to { stroke-dashoffset: 0; }"
        },
        {
          "selector": "@keyframes w-shake",
          "css": "20%, 60% { transform: translateX(-4px); } 40%, 80% { transform: translateX(4px); }"
        },
        {
          "selector": "@keyframes w-pop",
          "css": "50% { transform: scale(1.12); }"
        },
        {
          "selector": ".w-form-field",
          "css": "display: flex;\nflex-direction: column;\ngap: 6px;\nmin-inline-size: 0;\nmargin: 0;\npadding: 0;\nborder: 0;"
        },
        {
          "selector": ".w-form-field--wide",
          "css": "grid-column: 1 / -1;"
        },
        {
          "selector": ".w-form-field__label",
          "css": "display: flex;\nalign-items: baseline;\nflex-wrap: wrap;\ngap: 0 var(--space-3xs);\ninline-size: 100%;\npadding: 0;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-form-field__required",
          "css": "color: var(--error);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-form-field__optional",
          "css": "font-size: var(--text-xs);\nfont-weight: var(--font-weight-body);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-form-field__label--legend",
          "css": "margin-block-end: 6px;"
        },
        {
          "selector": ".w-form-field__options",
          "css": "display: grid;\ngrid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\ngap: var(--space-2xs);"
        },
        {
          "selector": ".w-form-field__footer",
          "css": "display: flex;\nalign-items: flex-start;\ngap: var(--space-xs);\nmin-block-size: 18px;"
        },
        {
          "selector": ".w-form-field__hint",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-form-field__error",
          "css": "display: none;\nalign-items: flex-start;\ngap: 6px;\nfont-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--error-fg);"
        },
        {
          "selector": ".w-form-field__error-icon",
          "css": "inline-size: 14px;\nblock-size: 14px;\nflex: 0 0 auto;\nmargin-block-start: 2px;"
        },
        {
          "selector": ".w-form-field.is-invalid .w-form-field__hint",
          "css": "display: none;"
        },
        {
          "selector": ".w-form-field.is-invalid .w-form-field__error",
          "css": "display: flex;\nanimation: w-field-in var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-form-field__counter",
          "css": "flex: 0 0 auto;\nmargin-inline-start: auto;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: 18px;\nfont-variant-numeric: tabular-nums;\ncolor: var(--text-body);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-form-field__counter.is-near",
          "css": "color: var(--warning-fg);"
        },
        {
          "selector": ".w-form-field__counter.is-full",
          "css": "color: var(--error-fg);"
        },
        {
          "selector": ".w-input",
          "css": "position: relative;\ndisplay: flex;\nalign-items: center;\ngap: var(--space-2xs);\nmin-block-size: var(--input-height);\npadding-inline: var(--space-xs);\nborder: var(--stroke);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\ncursor: text;\ntransition: border-color var(--duration-fast), box-shadow var(--duration-base) var(--ease-standard);"
        },
        {
          "selector": ".w-input:hover",
          "css": "border-color: var(--border-dark);"
        },
        {
          "selector": ".w-input:focus-within",
          "css": "border-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-input.is-invalid",
          "css": "border-color: var(--error);"
        },
        {
          "selector": ".w-input.is-invalid:focus-within",
          "css": "box-shadow: var(--input-ring-error);"
        },
        {
          "selector": ".w-input.is-shake",
          "css": "animation: w-shake 360ms var(--ease-standard);"
        },
        {
          "selector": ".w-input:has(.w-input__field:disabled)",
          "css": "background: var(--bg-surface-2);\nborder-color: var(--border-subtle);\ncursor: not-allowed;"
        },
        {
          "selector": ".w-input--textarea",
          "css": "align-items: flex-start;\npadding-block: 10px;"
        },
        {
          "selector": ".w-input__icon",
          "css": "inline-size: 18px;\nblock-size: 18px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-input:focus-within .w-input__icon",
          "css": "color: var(--focus);"
        },
        {
          "selector": ".w-input.is-invalid .w-input__icon",
          "css": "color: var(--error);"
        },
        {
          "selector": ".w-input__affix",
          "css": "flex: 0 0 auto;\nmargin-inline-end: -6px;\nfont-size: var(--text-s);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-input__field",
          "css": "flex: 1 1 0%;\nmin-inline-size: 0;\nblock-size: calc(var(--input-height) - 2px);\nmargin: 0;\npadding: 0;\nborder: 0;\noutline: none;\nbackground: none;\nfont-size: var(--text-s);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-input__field::placeholder",
          "css": "color: var(--text-body-dark);\nopacity: 1;\ntransition: opacity var(--duration-fast);"
        },
        {
          "selector": ".w-input__field:focus::placeholder",
          "css": "opacity: 0.55;"
        },
        {
          "selector": ".w-input__field:focus-visible",
          "css": "outline: none;"
        },
        {
          "selector": ".w-input__field:disabled",
          "css": "color: var(--text-body);\ncursor: not-allowed;"
        },
        {
          "selector": ".w-input--textarea .w-input__field",
          "css": "block-size: auto;\nmin-block-size: 72px;\nmax-block-size: 240px;\nresize: none;\nfield-sizing: content;\nline-height: var(--line-height-2xl);"
        },
        {
          "selector": ".w-input__clear",
          "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 24px;\nblock-size: 24px;\nmargin-inline-end: -4px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-full);\nbackground: var(--bg-surface-2);\ncolor: var(--icon);\ncursor: pointer;\nopacity: 0;\nvisibility: hidden;\ntransform: scale(0.6);\ntransition: opacity var(--duration-fast), transform var(--duration-slow) var(--ease-overshoot), visibility 0s var(--duration-fast), background-color var(--duration-fast), color var(--duration-fast);"
        },
        {
          "selector": ".w-input:has(.w-input__field:not(:placeholder-shown)) .w-input__clear",
          "css": "opacity: 1;\nvisibility: visible;\ntransform: none;\ntransition-delay: 0s;"
        },
        {
          "selector": ".w-input__clear:hover",
          "css": "background: var(--border-light);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-input__clear-icon",
          "css": "inline-size: 12px;\nblock-size: 12px;\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-input__clear:hover .w-input__clear-icon",
          "css": "transform: rotate(90deg);"
        },
        {
          "selector": ".w-input__status",
          "css": "inline-size: 18px;\nblock-size: 18px;\nflex: 0 0 auto;\nfill: none;\nstroke: var(--success);\nstroke-width: 1.6;\nstroke-linecap: round;\nstroke-linejoin: round;\nopacity: 0;\ntransform: scale(0.6);\ntransition: opacity var(--duration-fast), transform var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-input.is-valid .w-input__status",
          "css": "opacity: 1;\ntransform: none;"
        },
        {
          "selector": ".w-input__status-tick",
          "css": "stroke-dasharray: 10;\nstroke-dashoffset: 10;\ntransition: stroke-dashoffset 350ms var(--ease-standard) 100ms;"
        },
        {
          "selector": ".w-input__status-ring",
          "css": "fill: var(--success-bg);"
        },
        {
          "selector": ".w-input.is-valid .w-input__status-tick",
          "css": "stroke-dashoffset: 0;"
        },
        {
          "selector": ".w-input__reveal",
          "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 30px;\nblock-size: 30px;\nmargin-inline-end: -6px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-xs);\nbackground: none;\ncolor: var(--icon);\ncursor: pointer;\ntransition: color var(--duration-fast), background-color var(--duration-fast);"
        },
        {
          "selector": ".w-input__reveal:hover",
          "css": "background: var(--bg-surface-2);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-input__reveal-icon",
          "css": "inline-size: 18px;\nblock-size: 18px;\nfill: none;\nstroke: currentColor;\nstroke-width: 1.5;\nstroke-linecap: round;\nstroke-linejoin: round;"
        },
        {
          "selector": ".w-input__reveal-pupil",
          "css": "transform-box: fill-box;\ntransform-origin: center;\ntransition: transform var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-input__reveal-slash",
          "css": "stroke-dasharray: 18;\nstroke-dashoffset: 0;\ntransition: stroke-dashoffset 250ms var(--ease-standard);"
        },
        {
          "selector": ".w-input__reveal[aria-pressed=\"true\"] .w-input__reveal-pupil",
          "css": "transform: scale(1.3);"
        },
        {
          "selector": ".w-input__reveal[aria-pressed=\"true\"] .w-input__reveal-slash",
          "css": "stroke-dashoffset: 18;"
        },
        {
          "selector": ".w-meter",
          "css": "display: grid;\ngrid-template-columns: repeat(4, minmax(0, 1fr));\ngap: 4px;"
        },
        {
          "selector": ".w-meter__bar",
          "css": "position: relative;\nblock-size: 4px;\noverflow: hidden;\nborder-radius: var(--radius-full);\nbackground: var(--border-subtle);"
        },
        {
          "selector": ".w-meter__bar::after",
          "css": "content: \"\";\nposition: absolute;\ninset: 0;\nborder-radius: inherit;\nbackground: var(--error);\ntransform: scaleX(0);\ntransform-origin: left;\ntransition: transform var(--duration-slow) var(--ease-spring), background-color var(--duration-base);"
        },
        {
          "selector": ".w-meter__bar:nth-child(2)::after",
          "css": "transition-delay: 40ms;"
        },
        {
          "selector": ".w-meter__bar:nth-child(3)::after",
          "css": "transition-delay: 80ms;"
        },
        {
          "selector": ".w-meter__bar:nth-child(4)::after",
          "css": "transition-delay: 120ms;"
        },
        {
          "selector": ".w-meter.is-weak .w-meter__bar:nth-child(-n+1)::after",
          "css": "transform: none;"
        },
        {
          "selector": ".w-meter.is-fair .w-meter__bar:nth-child(-n+2)::after",
          "css": "transform: none;\nbackground: var(--warning);"
        },
        {
          "selector": ".w-meter.is-good .w-meter__bar:nth-child(-n+3)::after",
          "css": "transform: none;\nbackground: var(--active);"
        },
        {
          "selector": ".w-meter.is-strong .w-meter__bar::after",
          "css": "transform: none;\nbackground: var(--success);"
        },
        {
          "selector": ".w-meter__label",
          "css": "grid-column: 1 / -1;\nmargin-block-start: 2px;\nfont-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-meter.is-weak .w-meter__label",
          "css": "color: var(--error-fg);"
        },
        {
          "selector": ".w-meter.is-fair .w-meter__label",
          "css": "color: var(--warning-fg);"
        },
        {
          "selector": ".w-meter.is-good .w-meter__label",
          "css": "color: var(--text-badge);"
        },
        {
          "selector": ".w-meter.is-strong .w-meter__label",
          "css": "color: var(--success-fg);"
        },
        {
          "selector": ".w-select",
          "css": "position: relative;\ninline-size: 100%;"
        },
        {
          "selector": ".w-select__trigger",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\ninline-size: 100%;\nmin-block-size: var(--input-height);\npadding-inline: var(--space-xs);\nborder: var(--stroke);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\ncolor: var(--text-title);\ncursor: pointer;\ntext-align: left;\nfont-size: var(--text-s);\nline-height: var(--line-height-xl);\ntransition: border-color var(--duration-fast), box-shadow var(--duration-base) var(--ease-standard);"
        },
        {
          "selector": ".w-select__trigger:hover",
          "css": "border-color: var(--border-dark);"
        },
        {
          "selector": ".w-select__trigger:focus-visible",
          "css": "outline: none;\nborder-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-select.is-open .w-select__trigger",
          "css": "border-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-select.is-invalid .w-select__trigger",
          "css": "border-color: var(--error);"
        },
        {
          "selector": ".w-select.is-invalid .w-select__trigger:focus-visible, .w-select.is-invalid.is-open .w-select__trigger",
          "css": "box-shadow: var(--input-ring-error);"
        },
        {
          "selector": ".w-select.is-shake .w-select__trigger",
          "css": "animation: w-shake 360ms var(--ease-standard);"
        },
        {
          "selector": ".w-select__value",
          "css": "flex: 1 1 0%;\nmin-inline-size: 0;\noverflow: hidden;\ntext-overflow: ellipsis;\nwhite-space: nowrap;"
        },
        {
          "selector": ".w-select__value.is-placeholder",
          "css": "color: var(--text-body-dark);"
        },
        {
          "selector": ".w-select__value.is-changed",
          "css": "animation: w-select-value var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": "@keyframes w-select-value",
          "css": "from { opacity: 0; transform: translateY(6px); }"
        },
        {
          "selector": ".w-select__caret",
          "css": "inline-size: 16px;\nblock-size: 16px;\nflex: 0 0 auto;\ncolor: var(--icon);\ntransition: transform var(--duration-slow) var(--ease-spring), color var(--duration-fast);"
        },
        {
          "selector": ".w-select.is-open .w-select__caret",
          "css": "transform: rotate(180deg);\ncolor: var(--focus);"
        },
        {
          "selector": ".w-select__panel",
          "css": "position: absolute;\nz-index: 30;\ninset-block-start: calc(100% + 6px);\ninset-inline-start: 0;\ninset-inline-end: 0;\npadding: 4px;\nborder-radius: var(--radius-m);\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-popover);\nopacity: 0;\nvisibility: hidden;\ntransform: translateY(-6px) scale(0.98);\ntransform-origin: top center;\ntransition: opacity var(--duration-fast) var(--ease-standard), transform 250ms var(--ease-spring), visibility 0s linear 250ms;"
        },
        {
          "selector": ".w-select.is-up .w-select__panel",
          "css": "inset-block-start: auto;\ninset-block-end: calc(100% + 6px);\ntransform: translateY(6px) scale(0.98);\ntransform-origin: bottom center;"
        },
        {
          "selector": ".w-select.is-open .w-select__panel",
          "css": "opacity: 1;\nvisibility: visible;\ntransform: none;\ntransition-delay: 0s;"
        },
        {
          "selector": ".w-select__search",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\nblock-size: 40px;\nmargin: -4px -4px 4px;\npadding-inline: 14px;\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-select__search-icon",
          "css": "inline-size: 16px;\nblock-size: 16px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);"
        },
        {
          "selector": ".w-select__search-input",
          "css": "flex: 1 1 0%;\nmin-inline-size: 0;\nblock-size: 100%;\npadding: 0;\nborder: 0;\noutline: none;\nbackground: none;\nfont-size: var(--text-s);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-select__search-input::placeholder",
          "css": "color: var(--text-body-dark);\nopacity: 1;"
        },
        {
          "selector": ".w-select__viewport",
          "css": "position: relative;\nmax-block-size: 244px;\noverflow-y: auto;\noverscroll-behavior: contain;\nscrollbar-width: thin;"
        },
        {
          "selector": ".w-select__highlight",
          "css": "position: absolute;\ninset-block-start: 0;\ninset-inline-start: 0;\ninset-inline-end: 0;\nblock-size: 0;\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface-2);\nopacity: 0;\npointer-events: none;\ntransition: transform 220ms var(--ease-spring), height 220ms var(--ease-spring), opacity var(--duration-fast);"
        },
        {
          "selector": ".w-select__highlight.is-visible",
          "css": "opacity: 1;"
        },
        {
          "selector": ".w-select__list",
          "css": "position: relative;\ndisplay: flex;\nflex-direction: column;\ngap: 2px;\noutline: none;"
        },
        {
          "selector": ".w-select__option",
          "css": "display: flex;\nalign-items: center;\ngap: 10px;\nmin-block-size: 36px;\npadding: 6px 10px;\nborder-radius: var(--radius-s);\nfont-size: var(--text-s);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);\ncursor: pointer;\nuser-select: none;"
        },
        {
          "selector": ".w-select__option[aria-disabled=\"true\"]",
          "css": "color: var(--text-disabled);\ncursor: not-allowed;"
        },
        {
          "selector": ".w-select__option-dot",
          "css": "inline-size: 8px;\nblock-size: 8px;\nflex: 0 0 auto;\nborder-radius: var(--radius-full);\nbackground: var(--success);\nbox-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 18%, transparent);"
        },
        {
          "selector": ".w-select__option-dot--mid",
          "css": "background: var(--warning);\nbox-shadow: 0 0 0 3px color-mix(in srgb, var(--warning) 18%, transparent);"
        },
        {
          "selector": ".w-select__option-dot--far",
          "css": "background: var(--error);\nbox-shadow: 0 0 0 3px color-mix(in srgb, var(--error) 18%, transparent);"
        },
        {
          "selector": ".w-select__option-label",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;\noverflow: hidden;\ntext-overflow: ellipsis;\nwhite-space: nowrap;"
        },
        {
          "selector": ".w-select__option-meta",
          "css": "flex: 0 0 auto;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-select__option[aria-disabled=\"true\"] .w-select__option-meta",
          "css": "color: var(--text-disabled);"
        },
        {
          "selector": ".w-select__option-check",
          "css": "inline-size: 16px;\nblock-size: 16px;\nflex: 0 0 auto;\ncolor: var(--active);\nopacity: 0;\ntransform: scale(0.4);\ntransition: opacity var(--duration-fast), transform var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-select__option[aria-selected=\"true\"] .w-select__option-check",
          "css": "opacity: 1;\ntransform: none;"
        },
        {
          "selector": ".w-select__empty",
          "css": "padding: var(--space-s) 10px;\nfont-size: var(--text-s);\ntext-align: center;\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-datepicker",
          "css": "position: relative;\ninline-size: 100%;"
        },
        {
          "selector": ".w-datepicker__trigger",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\ninline-size: 100%;\nmin-block-size: var(--input-height);\npadding-inline: var(--space-xs);\nborder: var(--stroke);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\ncolor: var(--text-title);\ncursor: pointer;\ntext-align: left;\nfont-size: var(--text-s);\nline-height: var(--line-height-xl);\ntransition: border-color var(--duration-fast), box-shadow var(--duration-base) var(--ease-standard);"
        },
        {
          "selector": ".w-datepicker__trigger:hover",
          "css": "border-color: var(--border-dark);"
        },
        {
          "selector": ".w-datepicker__trigger:focus-visible",
          "css": "outline: none;\nborder-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-datepicker.is-open .w-datepicker__trigger",
          "css": "border-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-datepicker.is-invalid .w-datepicker__trigger",
          "css": "border-color: var(--error);"
        },
        {
          "selector": ".w-datepicker.is-invalid .w-datepicker__trigger:focus-visible, .w-datepicker.is-invalid.is-open .w-datepicker__trigger",
          "css": "box-shadow: var(--input-ring-error);"
        },
        {
          "selector": ".w-datepicker.is-shake .w-datepicker__trigger",
          "css": "animation: w-shake 360ms var(--ease-standard);"
        },
        {
          "selector": ".w-datepicker__icon",
          "css": "inline-size: 18px;\nblock-size: 18px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-datepicker.is-open .w-datepicker__icon, .w-datepicker__trigger:focus-visible .w-datepicker__icon",
          "css": "color: var(--focus);"
        },
        {
          "selector": ".w-datepicker.is-invalid .w-datepicker__icon",
          "css": "color: var(--error);"
        },
        {
          "selector": ".w-datepicker__value",
          "css": "flex: 1 1 0%;\nmin-inline-size: 0;\noverflow: hidden;\ntext-overflow: ellipsis;\nwhite-space: nowrap;"
        },
        {
          "selector": ".w-datepicker__value.is-placeholder",
          "css": "color: var(--text-body-dark);"
        },
        {
          "selector": ".w-datepicker__value.is-changed",
          "css": "animation: w-select-value var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-datepicker__relative",
          "css": "flex: 0 0 auto;\npadding: 2px var(--space-2xs);\nborder-radius: var(--radius-full);\nbackground: var(--bg-accent);\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\ncolor: var(--text-chip);"
        },
        {
          "selector": ".w-datepicker__relative:empty",
          "css": "display: none;"
        },
        {
          "selector": ".w-datepicker__panel",
          "css": "position: absolute;\nz-index: 30;\ninset-block-start: calc(100% + 6px);\ninset-inline-start: 0;\ninline-size: 320px;\nmax-inline-size: 100%;\npadding: var(--space-xs);\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-popover);\nopacity: 0;\nvisibility: hidden;\ntransform: translateY(-6px) scale(0.98);\ntransform-origin: top left;\ntransition: opacity var(--duration-fast) var(--ease-standard), transform 250ms var(--ease-spring), visibility 0s linear 250ms;"
        },
        {
          "selector": ".w-datepicker.is-up .w-datepicker__panel",
          "css": "inset-block-start: auto;\ninset-block-end: calc(100% + 6px);\ntransform: translateY(6px) scale(0.98);\ntransform-origin: bottom left;"
        },
        {
          "selector": ".w-datepicker.is-open .w-datepicker__panel",
          "css": "opacity: 1;\nvisibility: visible;\ntransform: none;\ntransition-delay: 0s;"
        },
        {
          "selector": ".w-datepicker__presets",
          "css": "display: grid;\ngrid-template-columns: repeat(2, minmax(0, 1fr));\ngap: 6px;\nmargin-block-end: var(--space-2xs);\npadding-block-end: var(--space-xs);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-datepicker__preset",
          "css": "block-size: 28px;\npadding-inline: 10px;\nborder: 0;\nborder-radius: var(--radius-full);\nbackground: var(--bg-surface-2);\ncursor: pointer;\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\ncolor: var(--text-title);\ntransition: background-color var(--duration-fast), color var(--duration-fast), transform var(--duration-base) var(--ease-overshoot);"
        },
        {
          "selector": ".w-datepicker__preset:hover",
          "css": "background: var(--bg-accent);\ncolor: var(--text-chip);"
        },
        {
          "selector": ".w-datepicker__preset:active",
          "css": "transform: scale(0.94);"
        },
        {
          "selector": ".w-datepicker__header",
          "css": "display: flex;\nalign-items: center;\njustify-content: space-between;\ngap: var(--space-2xs);\npadding: var(--space-3xs) 2px var(--space-2xs) 6px;"
        },
        {
          "selector": ".w-datepicker__month",
          "css": "overflow: hidden;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-datepicker__month.is-next",
          "css": "animation: w-cal-roll-next var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-datepicker__month.is-prev",
          "css": "animation: w-cal-roll-prev var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-datepicker__nav-group",
          "css": "display: flex;\ngap: 2px;"
        },
        {
          "selector": ".w-datepicker__nav",
          "css": "display: grid;\nplace-items: center;\ninline-size: 32px;\nblock-size: 32px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncolor: var(--icon);\ncursor: pointer;\ntransition: background-color var(--duration-fast), color var(--duration-fast), transform var(--duration-base) var(--ease-overshoot);"
        },
        {
          "selector": ".w-datepicker__nav:hover",
          "css": "background: var(--bg-surface-2);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-datepicker__nav:active",
          "css": "transform: scale(0.9);"
        },
        {
          "selector": ".w-datepicker__nav:disabled",
          "css": "opacity: 0.35;\ncursor: default;\nbackground: none;\ntransform: none;"
        },
        {
          "selector": ".w-datepicker__nav-icon",
          "css": "inline-size: 14px;\nblock-size: 14px;"
        },
        {
          "selector": ".w-datepicker__nav-icon--prev",
          "css": "transform: scaleX(-1);"
        },
        {
          "selector": ".w-datepicker__grid",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\noverflow: hidden;"
        },
        {
          "selector": ".w-datepicker__weekdays",
          "css": "display: grid;\ngrid-template-columns: repeat(7, minmax(0, 1fr));"
        },
        {
          "selector": ".w-datepicker__weekday",
          "css": "display: grid;\nplace-items: center;\nblock-size: 28px;\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-datepicker__days",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;"
        },
        {
          "selector": ".w-datepicker__days.is-next",
          "css": "animation: w-cal-slide-next 280ms var(--ease-spring);"
        },
        {
          "selector": ".w-datepicker__days.is-prev",
          "css": "animation: w-cal-slide-prev 280ms var(--ease-spring);"
        },
        {
          "selector": "@keyframes w-cal-slide-next",
          "css": "from { opacity: 0; transform: translateX(18px); }"
        },
        {
          "selector": "@keyframes w-cal-slide-prev",
          "css": "from { opacity: 0; transform: translateX(-18px); }"
        },
        {
          "selector": "@keyframes w-cal-roll-next",
          "css": "from { opacity: 0; transform: translateY(8px); }"
        },
        {
          "selector": "@keyframes w-cal-roll-prev",
          "css": "from { opacity: 0; transform: translateY(-8px); }"
        },
        {
          "selector": ".w-datepicker__week",
          "css": "display: grid;\ngrid-template-columns: repeat(7, minmax(0, 1fr));\ngap: 2px;"
        },
        {
          "selector": ".w-datepicker__day",
          "css": "position: relative;\nblock-size: 38px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncursor: pointer;\nfont-size: var(--text-s);\nfont-variant-numeric: tabular-nums;\ncolor: var(--text-title);\ntransition: background-color var(--duration-fast), color var(--duration-fast), transform var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-datepicker__day:hover",
          "css": "background: var(--bg-surface-2);"
        },
        {
          "selector": ".w-datepicker__day:active",
          "css": "transform: scale(0.88);"
        },
        {
          "selector": ".w-datepicker__day:focus-visible",
          "css": "outline: none;\nbox-shadow: inset 0 0 0 1.5px var(--focus);"
        },
        {
          "selector": ".w-datepicker__day.is-outside",
          "css": "color: var(--text-disabled);"
        },
        {
          "selector": ".w-datepicker__day.is-today::after",
          "css": "content: \"\";\nposition: absolute;\ninset-block-end: 5px;\ninset-inline-start: 50%;\ninline-size: 4px;\nblock-size: 4px;\nmargin-inline-start: -2px;\nborder-radius: var(--radius-full);\nbackground: var(--active);"
        },
        {
          "selector": ".w-datepicker__day.is-today",
          "css": "font-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-datepicker__day[aria-disabled=\"true\"]",
          "css": "background: none;\ncolor: var(--text-disabled);\ncursor: not-allowed;\ntransform: none;\ntext-decoration: line-through;\ntext-decoration-color: color-mix(in srgb, var(--text-disabled) 60%, transparent);"
        },
        {
          "selector": ".w-datepicker__day.is-selected",
          "css": "background: var(--active);\ncolor: var(--all-light);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-datepicker__day.is-selected:hover",
          "css": "background: var(--active-hover);"
        },
        {
          "selector": ".w-datepicker__day.is-selected::after",
          "css": "background: var(--all-light);"
        },
        {
          "selector": ".w-datepicker__day.is-selected:focus-visible",
          "css": "box-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-datepicker__day.is-picked",
          "css": "animation: w-pop var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-datepicker__footer",
          "css": "display: flex;\nalign-items: center;\njustify-content: space-between;\ngap: var(--space-2xs);\nmargin-block-start: var(--space-2xs);\npadding-block-start: 10px;\nborder-block-start: var(--stroke-subtle);"
        },
        {
          "selector": ".w-datepicker__hint",
          "css": "font-size: 11px;\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);\n@media (max-width: 767px) {\n  display: none;\n}"
        },
        {
          "selector": ".w-datepicker__clear",
          "css": "flex: 0 0 auto;\nblock-size: 28px;\npadding-inline: 10px;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncursor: pointer;\nfont-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\ncolor: var(--text-chip);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-datepicker__clear:hover",
          "css": "background: var(--bg-accent);"
        },
        {
          "selector": ".w-checkbox",
          "css": "display: inline-flex;\nalign-items: flex-start;\ngap: 10px;\ncursor: pointer;"
        },
        {
          "selector": ".w-checkbox__input",
          "css": "position: relative;\nflex: 0 0 auto;\ninline-size: 18px;\nblock-size: 18px;\nmargin: 1px 0 0;\nappearance: none;\ncursor: pointer;\nborder: 1.5px solid var(--border-dark);\nborder-radius: 5px;\nbackground: var(--bg-surface);\ntransition: background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-slow) var(--ease-overshoot), box-shadow var(--duration-base);"
        },
        {
          "selector": ".w-checkbox__input::after",
          "css": "content: \"\";\nposition: absolute;\ninset: -1.5px;\nbackground: var(--all-light);\nmask: var(--form-check-mask) center / 12px no-repeat;\nclip-path: inset(0 100% 0 0);\ntransition: clip-path 250ms var(--ease-standard);"
        },
        {
          "selector": ".w-checkbox:hover .w-checkbox__input",
          "css": "border-color: var(--icon);"
        },
        {
          "selector": ".w-checkbox__input:active",
          "css": "transform: scale(0.86);"
        },
        {
          "selector": ".w-checkbox__input:checked",
          "css": "border-color: var(--active);\nbackground: var(--active);\nanimation: w-pop var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-checkbox__input:checked::after",
          "css": "clip-path: inset(0);\ntransition-delay: 60ms;"
        },
        {
          "selector": ".w-checkbox__input:focus-visible",
          "css": "outline: none;\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-checkbox__input:disabled",
          "css": "opacity: 0.5;\ncursor: not-allowed;"
        },
        {
          "selector": ".w-checkbox__text",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;"
        },
        {
          "selector": ".w-checkbox__label",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-checkbox__description",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-choice",
          "css": "position: relative;\ndisplay: flex;\nalign-items: flex-start;\ngap: var(--space-xs);\npadding: 14px var(--space-s);\nborder-radius: var(--radius-m);\nbackground: var(--bg-surface);\nbox-shadow: inset 0 0 0 1px var(--border-light);\ncursor: pointer;\ntransition: box-shadow var(--duration-base) var(--ease-standard), background-color var(--duration-base);"
        },
        {
          "selector": ".w-choice:hover",
          "css": "box-shadow: inset 0 0 0 1px var(--border-dark);"
        },
        {
          "selector": ".w-choice:has(.w-choice__radio:checked)",
          "css": "background: color-mix(in srgb, var(--active) 5%, var(--bg-surface));\nbox-shadow: inset 0 0 0 1.5px var(--active);"
        },
        {
          "selector": ".w-choice:has(.w-choice__radio:focus-visible)",
          "css": "box-shadow: inset 0 0 0 1.5px var(--active), var(--input-ring-focus);"
        },
        {
          "selector": ".w-choice__radio",
          "css": "position: relative;\nflex: 0 0 auto;\ninline-size: 18px;\nblock-size: 18px;\nmargin: 1px 0 0;\nappearance: none;\ncursor: pointer;\nborder: 1.5px solid var(--border-dark);\nborder-radius: var(--radius-full);\nbackground: var(--bg-surface);\ntransition: border-color var(--duration-fast);"
        },
        {
          "selector": ".w-choice__radio::after",
          "css": "content: \"\";\nposition: absolute;\ninset: 3px;\nborder-radius: var(--radius-full);\nbackground: var(--active);\ntransform: scale(0);\ntransition: transform var(--duration-slow) var(--ease-overshoot);"
        },
        {
          "selector": ".w-choice__radio:checked",
          "css": "border-color: var(--active);"
        },
        {
          "selector": ".w-choice__radio:checked::after",
          "css": "transform: scale(1);"
        },
        {
          "selector": ".w-choice__radio:focus-visible",
          "css": "outline: none;"
        },
        {
          "selector": ".w-choice__body",
          "css": "display: flex;\nflex: 1 1 auto;\nflex-direction: column;\ngap: 2px;\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-choice__title",
          "css": "font-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-choice__meta",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-choice__price",
          "css": "flex: 0 0 auto;\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-switch",
          "css": "display: inline-flex;\nalign-items: flex-start;\ngap: 10px;\ncursor: pointer;"
        },
        {
          "selector": ".w-switch__input",
          "css": "position: relative;\nflex: 0 0 auto;\ninline-size: 36px;\nblock-size: 20px;\nmargin: 0;\nappearance: none;\ncursor: pointer;\nborder-radius: var(--radius-full);\nbackground: var(--toggle-track);\ntransition: background-color var(--duration-base) var(--ease-standard), box-shadow var(--duration-base);"
        },
        {
          "selector": ".w-switch__input::after",
          "css": "content: \"\";\nposition: absolute;\ninset-block-start: 2px;\ninset-inline-start: 2px;\ninline-size: 16px;\nblock-size: 16px;\nborder-radius: var(--radius-full);\nbackground: var(--all-light);\nbox-shadow: var(--shadow-s);\ntransition: transform var(--duration-slow) var(--ease-spring), width var(--duration-base) var(--ease-spring);"
        },
        {
          "selector": ".w-switch__input:active::after",
          "css": "inline-size: 20px;"
        },
        {
          "selector": ".w-switch__input:checked",
          "css": "background: var(--active);"
        },
        {
          "selector": ".w-switch__input:checked::after",
          "css": "transform: translateX(16px);"
        },
        {
          "selector": ".w-switch__input:checked:active::after",
          "css": "transform: translateX(12px);"
        },
        {
          "selector": ".w-switch__input:focus-visible",
          "css": "outline: none;\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-switch__input:disabled",
          "css": "opacity: 0.5;\ncursor: not-allowed;"
        },
        {
          "selector": ".w-switch__text",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;"
        },
        {
          "selector": ".w-switch__label",
          "css": "font-size: var(--text-s);\nline-height: 20px;\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-switch__description",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-input__field, .w-select__trigger, .w-select__search-input, .w-datepicker__trigger",
          "css": "@media (max-width: 767px) {\n  font-size: var(--text-m);\n}"
        },
        {
          "selector": ".w-nav-link",
          "css": "display: inline-flex;\nalign-items: center;\ngap: var(--space-3xs);\npadding: 6px var(--space-xs);\nborder: 0;\nborder-radius: var(--radius-xs);\nbackground: none;\ncursor: pointer;\nwhite-space: nowrap;\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-nav-link:hover",
          "css": "background: var(--bg-surface-2);"
        },
        {
          "selector": ".w-nav-link__label",
          "css": "display: block;"
        },
        {
          "selector": ".w-nav-link__caret",
          "css": "flex: 0 0 auto;\ninline-size: 16px;\nblock-size: 16px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-nav-link[aria-expanded=\"true\"] .w-nav-link__caret",
          "css": "transform: rotate(180deg);"
        },
        {
          "selector": ".w-mega-item",
          "css": "display: flex;\nalign-items: flex-start;\ngap: var(--space-xs);\npadding: var(--space-xs) var(--space-l);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-mega-item:hover",
          "css": "background: var(--bg-surface-2);"
        },
        {
          "selector": ".w-mega-item__icon",
          "css": "display: inline-flex;\nalign-items: center;\njustify-content: center;\nflex: 0 0 auto;\ninline-size: 40px;\nblock-size: 40px;\nborder: var(--stroke-subtle);\nborder-radius: 6.67px;\nbackground: var(--bg-surface-2);"
        },
        {
          "selector": ".w-mega-item__image",
          "css": "inline-size: 16px;\nblock-size: 16px;\nfilter: grayscale(1);\ntransition: filter var(--duration-fast);"
        },
        {
          "selector": ".w-mega-item:hover .w-mega-item__image",
          "css": "filter: none;"
        },
        {
          "selector": ".w-mega-item__text",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-3xs);\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-mega-item__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-mega-item__description",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-social-link",
          "css": "display: flex;\nflex: 1 1 0%;\nalign-items: center;\ngap: var(--space-xs);\npadding: var(--space-l);\nfont-size: var(--text-m);\nline-height: var(--line-height-xl);\ncolor: var(--all-light);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-social-link:hover",
          "css": "background: var(--bg-base-3);"
        },
        {
          "selector": ".w-social-link__icon",
          "css": "inline-size: 24px;\nblock-size: 24px;\nflex: 0 0 auto;"
        },
        {
          "selector": ".w-social-link__label",
          "css": "display: block;"
        },
        {
          "selector": ".w-menu-column",
          "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xl);\npadding: var(--space-l);"
        },
        {
          "selector": ".w-menu-column__title",
          "css": "font-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-menu-column__brand",
          "css": "text-transform: none;"
        },
        {
          "selector": ".w-menu-column__list",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-l);"
        },
        {
          "selector": ".w-menu-column__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-menu-column__link",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-m);\ncolor: var(--text-title);\nbackground: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: color var(--duration-fast), background-size var(--duration-slow) var(--ease-reveal);"
        },
        {
          "selector": ".w-menu-column__link:is(:hover, :focus-visible)",
          "css": "color: var(--accent);\nbackground-position: left bottom;\nbackground-size: 100% 1px;"
        },
        {
          "selector": ".w-menu-column__more",
          "css": "display: flex;\njustify-content: space-between;\nalign-items: center;\ninline-size: 100%;\nmargin-block-start: var(--space-l);\npadding: 0;\nborder: 0;\nbackground: none;\ncursor: pointer;\nfont-size: var(--text-s);\nline-height: var(--line-height-m);\ncolor: var(--text-body);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-menu-column__more:hover",
          "css": "color: var(--text-title);"
        },
        {
          "selector": ".w-menu-column__more-icon",
          "css": "flex: 0 0 auto;\ninline-size: 16px;\nblock-size: 16px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-accordion-item",
          "css": "position: relative;\npadding: var(--space-s);"
        },
        {
          "selector": ".w-accordion-item__bar",
          "css": "position: absolute;\ninset-block-start: 0;\ninset-block-end: 0;\ninset-inline-start: -1px;\ninline-size: 2px;\nborder-radius: var(--radius-full);\nbackground: var(--gradient-accent-bar);\nbox-shadow: 0 0 15px 1px rgba(118, 208, 244, 0.2);\nopacity: 0;\ntransition: opacity 250ms;"
        },
        {
          "selector": ".w-accordion-item.is-open .w-accordion-item__bar",
          "css": "opacity: 1;"
        },
        {
          "selector": ".w-accordion-item__heading",
          "css": "display: block;"
        },
        {
          "selector": ".w-accordion-item__trigger",
          "css": "display: block;\ninline-size: 100%;\npadding: 0;\nborder: 0;\nbackground: none;\ntext-align: left;\ncursor: pointer;\nfont-size: var(--text-l);\nline-height: var(--line-height-2xs);\ncolor: var(--text-body);\ntransition: color var(--duration-base);"
        },
        {
          "selector": ".w-accordion-item.is-open .w-accordion-item__trigger",
          "css": "color: var(--text-title);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-accordion-item__panel",
          "css": "display: grid;\ngrid-template-rows: 0fr;\ntransition: grid-template-rows var(--duration-slow);"
        },
        {
          "selector": ".w-accordion-item.is-open .w-accordion-item__panel",
          "css": "grid-template-rows: 1fr;"
        },
        {
          "selector": ".w-accordion-item__inner",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-l);\nmin-block-size: 0;\noverflow: hidden;\npadding-block-start: var(--space-l);"
        },
        {
          "selector": ".w-accordion-item__text",
          "css": "font-size: var(--text-m);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-accordion-item__list",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-2xs);\npadding-inline-start: var(--space-l);\nlist-style: disc outside;"
        },
        {
          "selector": ".w-accordion-item__list-item",
          "css": "font-size: var(--text-m);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-stat",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-3xs);\nmax-inline-size: 220px;"
        },
        {
          "selector": ".w-stat__value",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-2xl);\nletter-spacing: var(--letter-spacing-heading);\nline-height: var(--line-height-s);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-stat__label",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-glyph-matrix",
          "css": "position: absolute;\ninset: 0;\npointer-events: none;"
        },
        {
          "selector": ".w-glyph-matrix > canvas",
          "css": "inline-size: 100%;\nblock-size: 100%;"
        },
        {
          "selector": ".w-mock",
          "css": "overflow: hidden;\nborder-radius: 10px;\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-l);\nfont-size: 11px;\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-mock__bar",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\npadding: var(--space-2xs) var(--space-xs);\nborder-block-end: 1px solid var(--bg-surface-2);"
        },
        {
          "selector": ".w-mock__dots",
          "css": "display: inline-flex;\ngap: 5px;"
        },
        {
          "selector": ".w-mock__dot",
          "css": "inline-size: 7px;\nblock-size: 7px;\nborder-radius: 50%;\nbackground: var(--mock-dot-red);"
        },
        {
          "selector": ".w-mock__dot--yellow",
          "css": "background: var(--mock-dot-yellow);"
        },
        {
          "selector": ".w-mock__dot--green",
          "css": "background: var(--mock-dot-green);"
        },
        {
          "selector": ".w-mock__title",
          "css": "font-size: 11px;\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-mock__row",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\npadding: 7px var(--space-xs);\nborder-block-end: 1px solid var(--bg-surface-2);"
        },
        {
          "selector": ".w-mock__icon",
          "css": "flex: 0 0 auto;\ninline-size: 18px;\nblock-size: 18px;\nborder-radius: var(--radius-xs);\nbackground: var(--bg-surface-2);"
        },
        {
          "selector": ".w-mock__name",
          "css": "flex: 1 1 0%;\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-mock__name--muted",
          "css": "color: var(--text-body-dark);"
        },
        {
          "selector": ".w-mock__meta",
          "css": "display: block;\nfont-weight: var(--font-weight-body);\nfont-size: 9px;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-mock__tab",
          "css": "font-size: 10px;\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-mock__skeleton",
          "css": "display: block;\nblock-size: 4px;\nborder-radius: 2px;\nbackground: var(--bg-surface-3);"
        },
        {
          "selector": ".w-mock__skeleton--short",
          "css": "inline-size: 40px;"
        },
        {
          "selector": ".w-mock__skeleton--medium",
          "css": "inline-size: 60px;"
        },
        {
          "selector": ".w-mock__skeleton--long",
          "css": "inline-size: 80px;"
        },
        {
          "selector": ".w-card-hosting",
          "css": "display: flex;\nflex-direction: column;\nblock-size: 100%;\noverflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface);\ntransition: border-color var(--duration-base), box-shadow var(--duration-base), transform var(--duration-base);"
        },
        {
          "selector": ".w-card-hosting:hover",
          "css": "border-color: var(--accent);\ntransform: translateY(-2px);\nbox-shadow: var(--shadow-m);"
        },
        {
          "selector": ".w-card-hosting__plate",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\npadding: var(--space-l);\nbackground: var(--bg-surface-2);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-card-hosting__logo",
          "css": "display: inline-flex;\nalign-items: center;\njustify-content: center;\ninline-size: 52px;\nblock-size: 52px;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-m);\nbackground: var(--all-light);"
        },
        {
          "selector": ".w-card-hosting__logo-image",
          "css": "inline-size: 32px;\nblock-size: 32px;\nobject-fit: contain;\nfilter: grayscale(1);\nopacity: 0.75;\ntransition: filter 300ms, opacity 300ms;"
        },
        {
          "selector": ".w-card-hosting:hover .w-card-hosting__logo-image",
          "css": "filter: grayscale(0);\nopacity: 1;"
        },
        {
          "selector": ".w-card-hosting__body",
          "css": "display: flex;\nflex-direction: column;\nflex: 1 1 0%;\ngap: var(--space-2xs);\npadding: var(--space-l);"
        },
        {
          "selector": ".w-card-hosting__label",
          "css": "font-size: var(--text-xs);\nfont-weight: var(--font-weight-medium);\nletter-spacing: var(--letter-spacing-eyebrow);\ntext-transform: uppercase;\nline-height: var(--line-height-2xl);\ncolor: var(--text-eyebrow);"
        },
        {
          "selector": ".w-card-hosting__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-l);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-hosting__text",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-card-hosting__chips",
          "css": "display: flex;\nflex-wrap: wrap;\ngap: 6px;\nmargin-block-start: var(--space-2xs);"
        },
        {
          "selector": ".w-card-hosting__link",
          "css": "display: inline-flex;\nalign-items: center;\ngap: var(--space-3xs);\nmargin-block-start: auto;\npadding-block-start: var(--space-s);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\ncolor: var(--accent);"
        },
        {
          "selector": ".w-card-hosting__link-label",
          "css": "background: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: background-size var(--duration-slow) var(--ease-reveal);"
        },
        {
          "selector": ".w-card-hosting:is(:hover, :focus-visible) .w-card-hosting__link-label",
          "css": "background-position: left bottom;\nbackground-size: 100% 1px;"
        },
        {
          "selector": ".w-card-hosting__link-icon",
          "css": "flex: 0 0 auto;\ninline-size: 14px;\nblock-size: 14px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-card-hosting:hover .w-card-hosting__link-icon",
          "css": "transform: translateX(3px);"
        },
        {
          "selector": ".w-card-plan",
          "css": "display: flex;\nflex-direction: column;\nalign-items: center;\ngap: var(--space-l);\nmin-inline-size: 0;\npadding-block-end: var(--space-l);\nbackground: var(--bg-body);"
        },
        {
          "selector": ".w-card-plan__media",
          "css": "inline-size: 100%;\nblock-size: 320px;\noverflow: clip;"
        },
        {
          "selector": ".w-card-plan__image",
          "css": "inline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-card-plan__image",
          "css": "filter: invert(0.92) hue-rotate(180deg);"
        },
        {
          "selector": ".w-card-plan__body",
          "css": "display: flex;\nflex-direction: column;\njustify-content: space-between;\nflex: 1 1 0%;\ngap: var(--space-xl);\ninline-size: 352px;\nmax-inline-size: calc(100% - 48px);"
        },
        {
          "selector": ".w-card-plan__text",
          "css": "display: flex;\nflex-direction: column;\ngap: 26px;"
        },
        {
          "selector": ".w-card-plan__intro",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-2xs);"
        },
        {
          "selector": ".w-card-plan__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-xl);\nline-height: var(--line-height-xl);\nletter-spacing: var(--letter-spacing-heading-xs);\nfont-weight: var(--font-weight-heading);\ncolor: var(--plan-title-fg);"
        },
        {
          "selector": ".w-card-plan__description",
          "css": "font-size: var(--text-m);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-card-plan__features",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-s);"
        },
        {
          "selector": ".w-card-plan__feature",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\nfont-size: var(--text-m);\nline-height: var(--line-height-3xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-plan__check",
          "css": "inline-size: 16px;\nblock-size: 16px;\nflex: 0 0 auto;\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-card-feature",
          "css": "position: relative;\ndisplay: block;\nmin-inline-size: 0;\nblock-size: 488px;\noverflow: hidden;\nbackground: var(--bg-surface-3);"
        },
        {
          "selector": ".w-card-feature::after",
          "css": "content: \"\";\nposition: absolute;\ninset-inline-start: 0;\ninset-inline-end: 0;\ninset-block-end: 0;\nz-index: 4;\nblock-size: 2px;\nbackground: var(--active);\ntransform: scaleX(0);\ntransform-origin: 0 50%;\ntransition: transform 280ms;"
        },
        {
          "selector": ".w-card-feature:hover::after",
          "css": "transform: scaleX(1);"
        },
        {
          "selector": ".w-card-feature__head",
          "css": "position: relative;\nz-index: 2;\nblock-size: 144px;\npadding: var(--space-l);"
        },
        {
          "selector": ".w-card-feature__title",
          "css": "margin-block-end: var(--space-2xs);\nfont-family: var(--font-family-display);\nfont-size: var(--text-l);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-feature__description",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-card-feature__slot",
          "css": "position: absolute;\ninset-block-start: 144px;\ninset-inline-start: 0;\ninline-size: 100%;\nblock-size: 344px;\npadding: 22px 40px 0;\noverflow: hidden;\nopacity: 0.85;\nmask-image: linear-gradient(rgba(0, 0, 0, 0.45) 0%, #000 22%, #000 76%, rgba(0, 0, 0, 0.5) 90%, rgba(0, 0, 0, 0.2) 100%);"
        },
        {
          "selector": ".w-card-feature__arrow",
          "css": "inline-size: 18px;\nblock-size: 18px;\nposition: absolute;\ninset-inline-end: var(--space-s);\ninset-block-end: var(--space-xs);\nz-index: 4;\ncolor: var(--accent);\nopacity: 0;\ntransform: translate(-3px, 3px);\ntransition: opacity 220ms, transform 220ms;"
        },
        {
          "selector": ".w-card-feature:hover .w-card-feature__arrow",
          "css": "opacity: 1;\ntransform: none;"
        },
        {
          "selector": ".w-card-feature__mock",
          "css": "max-inline-size: 380px;\nmargin-inline: auto;"
        },
        {
          "selector": ".w-card-feature__mock--narrow",
          "css": "max-inline-size: 300px;\nmargin-block-start: 40px;"
        },
        {
          "selector": ".w-card-security",
          "css": "padding: var(--space-l);\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--bg-night-2);"
        },
        {
          "selector": ".w-card-security__label",
          "css": "margin-block-end: var(--space-2xs);\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nletter-spacing: var(--letter-spacing-mono);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-card-security__title",
          "css": "margin-block-end: var(--space-s);\nfont-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-security__list",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-2xs);"
        },
        {
          "selector": ".w-card-security__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-card-security__link",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);\nbackground: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: color var(--duration-fast), background-size var(--duration-slow) var(--ease-reveal);"
        },
        {
          "selector": ".w-card-security__link:is(:hover, :focus-visible)",
          "css": "color: var(--hover);\nbackground-position: left bottom;\nbackground-size: 100% 1px;"
        },
        {
          "selector": ".w-card-testimonial",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-l);\npadding: var(--space-l);\noverflow: hidden;\nborder: 1px solid var(--border-soft);\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface-4);\ntransition: transform var(--duration-base), box-shadow var(--duration-base);"
        },
        {
          "selector": ".w-card-testimonial:hover",
          "css": "transform: translateY(-2px);\nbox-shadow: var(--card-testimonial-shadow-hover);"
        },
        {
          "selector": ".w-card-testimonial__quote",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);\nwhite-space: pre-wrap;\nword-break: break-word;"
        },
        {
          "selector": ".w-card-testimonial__author",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\nmin-block-size: 50px;"
        },
        {
          "selector": ".w-card-testimonial__avatar",
          "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 50px;\nblock-size: 50px;\npadding: 1px;\nborder-radius: 50%;\nbackground: linear-gradient(rgba(157, 157, 157, 0.06), rgba(0, 0, 0, 0.06));"
        },
        {
          "selector": ".w-card-testimonial__avatar-image",
          "css": "inline-size: 48px;\nblock-size: 48px;\nborder-radius: 50%;\nobject-fit: cover;"
        },
        {
          "selector": ".w-card-testimonial__name",
          "css": "font-size: var(--text-m);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-3xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-way",
          "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-s);\nmin-inline-size: 0;\npadding: var(--space-xl);\nbackground: var(--bg-body);"
        },
        {
          "selector": ".w-card-way__text",
          "css": "flex: 1 1 0%;\nfont-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-card-way__lead",
          "css": "color: var(--text-title);"
        },
        {
          "selector": ".w-card-guarantee",
          "css": "display: flex;\nflex-direction: column;\njustify-content: center;\nalign-items: center;\nmin-inline-size: 0;\npadding: var(--space-xl);\nbackground: var(--bg-base);"
        },
        {
          "selector": ".w-card-guarantee__body",
          "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);"
        },
        {
          "selector": ".w-card-guarantee__head",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-3xs);"
        },
        {
          "selector": ".w-card-guarantee__icon",
          "css": "inline-size: 18px;\nblock-size: 18px;\nflex: 0 0 auto;\ncolor: var(--icon-contrast);"
        },
        {
          "selector": ".w-card-guarantee__title",
          "css": "font-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\nwhite-space: nowrap;\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-guarantee__text",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-card-community",
          "css": "display: flex;\nflex-direction: column;\njustify-content: space-between;\nmin-inline-size: 0;\nblock-size: 553px;\npadding: 40px;\noverflow: clip;\nbackground: var(--bg-band);"
        },
        {
          "selector": ".w-card-community__top",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-m);\ninline-size: 100%;"
        },
        {
          "selector": ".w-card-community__head",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-xs);\ninline-size: 100%;"
        },
        {
          "selector": ".w-card-community__eyebrow",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-3xs);\nfont-size: var(--text-m);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-card-community__eyebrow-icon",
          "css": "inline-size: 20px;\nblock-size: 20px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);"
        },
        {
          "selector": ".w-card-community__statement",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-xl);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\nletter-spacing: var(--letter-spacing-heading);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-card-community__media",
          "css": "inline-size: 100%;\naspect-ratio: 521 / 304;\noverflow: clip;\nborder: 1px solid var(--card-community-media-border);\nbackground: var(--bg-band);"
        },
        {
          "selector": ".w-card-community__image",
          "css": "inline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;\nobject-position: center top;"
        },
        {
          "selector": ".w-tile-agent",
          "css": "background: var(--bg-surface);"
        },
        {
          "selector": ".w-tile-agent__link",
          "css": "display: flex;\nflex-direction: column;\nalign-items: center;\ngap: var(--space-2xs);\npadding: var(--space-l) var(--space-s);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-tile-agent__link:hover",
          "css": "background: var(--bg-body);"
        },
        {
          "selector": ".w-tile-agent__logo",
          "css": "inline-size: 28px;\nblock-size: 28px;\nobject-fit: contain;\nopacity: 0.55;\ntransition: opacity 300ms;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-tile-agent__logo",
          "css": "filter: invert(1);"
        },
        {
          "selector": ".w-tile-agent__link:hover .w-tile-agent__logo",
          "css": "opacity: 1;"
        },
        {
          "selector": ".w-tile-agent__label",
          "css": "display: block;"
        },
        {
          "selector": ".w-tile-integration",
          "css": "display: flex;\nalign-items: center;\njustify-content: center;\nflex: 0 0 auto;\ninline-size: 88px;\nblock-size: 88px;\nmargin-inline-end: var(--space-2xl);\nborder: 1px solid var(--border-soft);\nborder-radius: var(--radius-xl);\nbackground: var(--tile-integration-bg);"
        },
        {
          "selector": ".w-tile-integration__icon",
          "css": "inline-size: 40px;\nblock-size: 40px;\nobject-fit: contain;"
        },
        {
          "selector": ".w-tile-stack",
          "css": "display: flex;\nalign-items: center;\njustify-content: center;\ngap: var(--space-3xs);\nflex: 0 0 160px;\nblock-size: 80px;"
        },
        {
          "selector": ".w-tile-stack__icon",
          "css": "inline-size: 40px;\nblock-size: 40px;"
        },
        {
          "selector": ".w-tile-stack__label",
          "css": "font-size: var(--text-m);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body);\nwhite-space: nowrap;"
        },
        {
          "selector": ".w-logo-cell",
          "css": "position: relative;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\nflex: 0 0 240.8px;\nblock-size: 84px;\npadding-inline: var(--space-xl);\nborder-inline-end: var(--stroke-subtle);\ntransition: background-color 300ms;"
        },
        {
          "selector": ".w-logo-cell:hover",
          "css": "background: var(--bg-surface);"
        },
        {
          "selector": ".w-logo-cell__image",
          "css": "inline-size: auto;\nblock-size: 32px;\nobject-fit: contain;\nfilter: grayscale(1);\nopacity: 0.7;\ntransition: filter 300ms, opacity 300ms;"
        },
        {
          "selector": ".w-logo-cell:hover .w-logo-cell__image",
          "css": "filter: none;\nopacity: 1;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-logo-cell__image",
          "css": "filter: grayscale(1) invert(1);"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-logo-cell:hover .w-logo-cell__image",
          "css": "filter: invert(1);"
        },
        {
          "selector": ".w-logo-cell__badge",
          "css": "position: absolute;\ninset-block-start: var(--space-2xs);\ninset-inline-end: var(--space-xs);\ndisplay: inline-flex;\nalign-items: center;\ngap: 2px;\nfont-size: 10px;\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-m);\ncolor: var(--text-title);"
        },
        {
          "selector": "@keyframes w-marquee-left",
          "css": "from { transform: translateX(0); } to { transform: translateX(-50%); }"
        },
        {
          "selector": "@keyframes w-marquee-right",
          "css": "from { transform: translateX(-50%); } to { transform: translateX(0); }"
        },
        {
          "selector": "@keyframes w-scroll-up",
          "css": "to { transform: translateY(calc(-50% - 8px)); }"
        },
        {
          "selector": ".w-docs-search",
          "css": "display: flex;\nalign-items: center;\ngap: 10px;\ninline-size: 100%;\nblock-size: 40px;\npadding: 0 var(--space-2xs) 0 var(--space-xs);\nborder: var(--stroke);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-xs);\ncursor: pointer;\ntext-align: left;\ncolor: var(--text-body-dark);\ntransition: border-color var(--duration-fast), color var(--duration-fast), box-shadow var(--duration-base) var(--ease-standard);"
        },
        {
          "selector": ".w-docs-search:hover",
          "css": "border-color: var(--border-dark);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-search:focus-visible",
          "css": "outline: 0;\nborder-color: var(--focus);\nbox-shadow: var(--input-ring-focus);"
        },
        {
          "selector": ".w-docs-search__icon",
          "css": "flex: 0 0 auto;\ninline-size: 16px;\nblock-size: 16px;\ncolor: var(--icon-muted);"
        },
        {
          "selector": ".w-docs-search__label",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;\nfont-size: var(--text-s);\nline-height: var(--line-height-m);"
        },
        {
          "selector": ".w-docs-search__key",
          "css": "flex: 0 0 auto;\npadding: 2px 6px;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-xs);\nbackground: var(--bg-surface-2);\nfont-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: var(--line-height-xl);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-menu-button",
          "css": "display: none;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 40px;\nblock-size: 40px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: var(--btn-outline-bg);\nbox-shadow: var(--btn-outline-shadow);\ncolor: var(--text-title);\ncursor: pointer;\n@media (max-width: 991px) {\n  display: grid;\n}"
        },
        {
          "selector": ".w-docs-menu-button:hover",
          "css": "background: var(--btn-outline-bg-hover);"
        },
        {
          "selector": ".w-docs-menu-button__icon",
          "css": "inline-size: 18px;\nblock-size: 18px;"
        },
        {
          "selector": ".w-docs-sidebar",
          "css": "position: sticky;\ninset-block-start: var(--space-l);\ndisplay: flex;\nflex-direction: column;\ngap: var(--space-xs);\nmax-block-size: calc(100vh - 2 * var(--space-l) + 8px);\noverflow-y: auto;\noverscroll-behavior: contain;\nscrollbar-width: none;\nmargin: -4px -4px 0;\npadding: 4px 4px var(--space-l);\n@media (max-width: 991px) {\n  position: fixed;\n  inset-block-start: 0;\n  inset-block-end: 0;\n  inset-inline-start: 0;\n  z-index: 120;\n  inline-size: min(320px, 86vw);\n  max-block-size: none;\n  margin: 0;\n  padding: var(--space-s) var(--space-s) var(--space-xl);\n  border-inline-end: var(--stroke-subtle);\n  background: var(--bg-body);\n  visibility: hidden;\n  translate: -100% 0;\n  transition: translate var(--duration-slow) var(--ease-spring), visibility linear var(--duration-slow), box-shadow var(--duration-slow);\n}"
        },
        {
          "selector": ".w-docs-sidebar::-webkit-scrollbar",
          "css": "display: none;"
        },
        {
          "selector": ".w-docs-sidebar__head",
          "css": "display: none;\nalign-items: center;\njustify-content: space-between;\ngap: var(--space-s);\n@media (max-width: 991px) {\n  display: flex;\n  padding-block-end: var(--space-2xs);\n}"
        },
        {
          "selector": ".w-docs-sidebar__logo",
          "css": "display: inline-flex;"
        },
        {
          "selector": ".w-docs-sidebar__logo-image",
          "css": "inline-size: auto;\nmax-inline-size: none;\nblock-size: 24px;"
        },
        {
          "selector": ".w-docs-sidebar__logo-image--dark",
          "css": "display: none;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-docs-sidebar__logo-image--light",
          "css": "display: none;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-docs-sidebar__logo-image--dark",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-sidebar__close",
          "css": "display: grid;\nplace-items: center;\ninline-size: 34px;\nblock-size: 34px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: var(--btn-outline-bg);\nbox-shadow: var(--btn-outline-shadow);\ncolor: var(--text-title);\ncursor: pointer;"
        },
        {
          "selector": ".w-docs-sidebar__close-icon",
          "css": "inline-size: 16px;\nblock-size: 16px;"
        },
        {
          "selector": ".w-docs-sidebar__meta",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\npadding: var(--space-3xs) 0 var(--space-xs);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-sidebar__meta-item",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-sidebar__meta-link",
          "css": "display: flex;\nalign-items: center;\ngap: 10px;\npadding: 5px var(--space-3xs);\nfont-size: 13px;\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-sidebar__meta-link:hover",
          "css": "color: var(--text-title);"
        },
        {
          "selector": ".w-docs-sidebar__meta-icon",
          "css": "flex: 0 0 auto;\ninline-size: 15px;\nblock-size: 15px;\ncolor: var(--icon-muted);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-sidebar__meta-link:hover .w-docs-sidebar__meta-icon",
          "css": "color: var(--accent);"
        },
        {
          "selector": ".w-docs-sidebar__meta-label",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-docs-sidebar__groups",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;"
        },
        {
          "selector": ".w-docs-nav-group",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-nav-group__summary",
          "css": "display: flex;\nalign-items: center;\ngap: 10px;\npadding: var(--space-2xs) var(--space-3xs);\nborder-radius: var(--radius-s);\nlist-style: none;\ncursor: pointer;\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-xl);\ncolor: var(--text-title);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-nav-group__summary::-webkit-details-marker",
          "css": "display: none;"
        },
        {
          "selector": ".w-docs-nav-group__summary:hover",
          "css": "background: var(--bg-surface-2);"
        },
        {
          "selector": ".w-docs-nav-group__icon",
          "css": "flex: 0 0 auto;\ninline-size: 16px;\nblock-size: 16px;\ncolor: var(--icon-muted);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-nav-group[open] .w-docs-nav-group__icon, .w-docs-nav-group__summary:hover .w-docs-nav-group__icon",
          "css": "color: var(--accent);"
        },
        {
          "selector": ".w-docs-nav-group__title",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-docs-nav-group__chevron",
          "css": "flex: 0 0 auto;\ninline-size: 14px;\nblock-size: 14px;\ncolor: var(--icon-muted);\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-docs-nav-group[open] .w-docs-nav-group__chevron",
          "css": "transform: rotate(180deg);"
        },
        {
          "selector": ".w-docs-nav-group__list",
          "css": "display: flex;\nflex-direction: column;\ngap: 1px;\nmargin: 2px 0 var(--space-2xs) 11px;\nborder-inline-start: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-nav-group__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-nav-group__link",
          "css": "display: block;\nmargin-inline-start: -1px;\npadding: 6px var(--space-xs) 6px 14px;\nborder-inline-start: 2px solid transparent;\nborder-radius: 0 var(--radius-s) var(--radius-s) 0;\nfont-size: 13.5px;\nline-height: var(--line-height-xl);\ncolor: var(--text-body);\ntransition: color var(--duration-fast), border-color var(--duration-fast), background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-nav-group__link:hover",
          "css": "color: var(--text-title);\nborder-inline-start-color: var(--border-dark);"
        },
        {
          "selector": ".w-docs-nav-group__link.is-current",
          "css": "border-inline-start-color: var(--active);\nbackground: var(--bg-accent);\ncolor: var(--text-chip);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-docs-nav-group__link--all",
          "css": "font-size: 13px;\nfont-weight: var(--font-weight-medium);\ncolor: var(--accent);"
        },
        {
          "selector": ".w-docs-nav-group__link--all:hover",
          "css": "color: var(--active-hover);\nborder-inline-start-color: var(--active);"
        },
        {
          "selector": ".w-docs-quick-card",
          "css": "position: relative;\ndisplay: flex;\nalign-items: flex-start;\ngap: var(--space-s);\nmin-inline-size: 0;\npadding: var(--space-l);\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface);\ntransition: border-color var(--duration-base), transform var(--duration-base), box-shadow var(--duration-base);"
        },
        {
          "selector": ".w-docs-quick-card:hover",
          "css": "border-color: var(--primary);\ntransform: translateY(-2px);\nbox-shadow: var(--shadow-m);"
        },
        {
          "selector": ".w-docs-quick-card--wide",
          "css": "grid-column: 1 / -1;"
        },
        {
          "selector": ".w-docs-quick-card__icon",
          "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 40px;\nblock-size: 40px;\nborder-radius: var(--radius-m);\nbackground: var(--bg-accent);\ncolor: var(--primary);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 16%, transparent);"
        },
        {
          "selector": ".w-docs-quick-card--amber .w-docs-quick-card__icon",
          "css": "background: color-mix(in srgb, var(--warning) 12%, transparent);\ncolor: var(--warning);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warning) 22%, transparent);"
        },
        {
          "selector": ".w-docs-quick-card--violet .w-docs-quick-card__icon",
          "css": "background: color-mix(in srgb, var(--docs-tone-violet) 12%, transparent);\ncolor: var(--docs-tone-violet);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--docs-tone-violet) 22%, transparent);"
        },
        {
          "selector": ".w-docs-quick-card--green .w-docs-quick-card__icon",
          "css": "background: color-mix(in srgb, var(--success) 12%, transparent);\ncolor: var(--success);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--success) 22%, transparent);"
        },
        {
          "selector": ".w-docs-quick-card__glyph",
          "css": "inline-size: 20px;\nblock-size: 20px;"
        },
        {
          "selector": ".w-docs-quick-card__body",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-3xs);\nflex: 1 1 auto;\nmin-inline-size: 0;\npadding-inline-end: var(--space-l);"
        },
        {
          "selector": ".w-docs-quick-card__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-heading);\nline-height: var(--line-height-l);\nletter-spacing: var(--letter-spacing-heading-xs);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-quick-card__text",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-quick-card__arrow",
          "css": "position: absolute;\ninset-block-start: var(--space-l);\ninset-inline-end: var(--space-l);\ninline-size: 18px;\nblock-size: 18px;\ncolor: var(--accent);\nopacity: 0;\ntransform: translateX(-4px);\ntransition: opacity var(--duration-base), transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-docs-quick-card:hover .w-docs-quick-card__arrow",
          "css": "opacity: 1;\ntransform: none;"
        },
        {
          "selector": ".w-docs-topic",
          "css": "position: relative;\ndisplay: flex;\nflex-direction: column;\nalign-items: flex-start;\nmin-inline-size: 0;\npadding: var(--space-xl);\nbackground: var(--bg-surface);"
        },
        {
          "selector": ".w-docs-topic::after",
          "css": "content: \"\";\nposition: absolute;\ninset-inline-start: 0;\ninset-inline-end: 0;\ninset-block-end: 0;\nblock-size: 2px;\nbackground: var(--active);\ntransform: scaleX(0);\ntransform-origin: 0 50%;\ntransition: transform 280ms;"
        },
        {
          "selector": ".w-docs-topic:hover::after",
          "css": "transform: scaleX(1);"
        },
        {
          "selector": ".w-docs-topic__icon",
          "css": "display: grid;\nplace-items: center;\ninline-size: 36px;\nblock-size: 36px;\nmargin-block-end: var(--space-s);\nborder-radius: var(--radius-s);\nbackground: var(--bg-accent);\ncolor: var(--primary);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 16%, transparent);"
        },
        {
          "selector": ".w-docs-topic__glyph",
          "css": "inline-size: 18px;\nblock-size: 18px;"
        },
        {
          "selector": ".w-docs-topic__title",
          "css": "margin-block-end: var(--space-3xs);\nfont-size: var(--text-l);\nline-height: var(--line-height-l);\nletter-spacing: var(--letter-spacing-heading-xs);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-topic__title-link",
          "css": "transition: color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-topic__title-link:hover",
          "css": "color: var(--accent);"
        },
        {
          "selector": ".w-docs-topic__text",
          "css": "margin-block-end: var(--space-s);\nfont-size: 13.5px;\nline-height: var(--line-height-2xl);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-topic__list",
          "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: 10px;"
        },
        {
          "selector": ".w-docs-topic__list--more",
          "css": "margin-block-start: 10px;"
        },
        {
          "selector": ".w-docs-topic__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-topic__link",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-xl);\ncolor: var(--text-body);\nbackground: linear-gradient(currentColor, currentColor) right bottom / 0 1px no-repeat;\ntransition: color var(--duration-fast), background-size var(--duration-slow) var(--ease-reveal);"
        },
        {
          "selector": ".w-docs-topic__link:is(:hover, :focus-visible)",
          "css": "color: var(--accent);\nbackground-position: left bottom;\nbackground-size: 100% 1px;"
        },
        {
          "selector": ".w-docs-topic__more",
          "css": "inline-size: 100%;\nmargin-block-start: var(--space-s);"
        },
        {
          "selector": ".w-docs-topic__more-toggle",
          "css": "display: inline-flex;\nalign-items: center;\ngap: 6px;\nlist-style: none;\ncursor: pointer;\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nletter-spacing: 0.2px;\ncolor: var(--accent);"
        },
        {
          "selector": ".w-docs-topic__more-toggle::-webkit-details-marker",
          "css": "display: none;"
        },
        {
          "selector": ".w-docs-topic__more-toggle:hover",
          "css": "color: var(--active-hover);"
        },
        {
          "selector": ".w-docs-topic__more-icon",
          "css": "inline-size: 12px;\nblock-size: 12px;\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-docs-topic__more[open] .w-docs-topic__more-icon",
          "css": "transform: rotate(180deg);"
        },
        {
          "selector": ".w-docs-topic__more[open] .w-docs-topic__more-label",
          "css": "color: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-topic__all",
          "css": "display: inline-flex;\nalign-items: center;\ngap: var(--space-3xs);\nmargin-block-start: var(--space-s);\nfont-size: 13px;\nfont-weight: var(--font-weight-medium);\ncolor: var(--accent);"
        },
        {
          "selector": ".w-docs-topic__all-icon",
          "css": "inline-size: 14px;\nblock-size: 14px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-docs-topic__all:hover .w-docs-topic__all-icon",
          "css": "transform: translateX(3px);"
        },
        {
          "selector": ".w-docs-toc",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-xs);"
        },
        {
          "selector": ".w-docs-toc__title",
          "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: var(--line-height-2xl);\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-toc__list",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\nborder-inline-start: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-toc__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-toc__link",
          "css": "display: block;\nmargin-inline-start: -1px;\npadding: 5px 0 5px 14px;\nborder-inline-start: 2px solid transparent;\nfont-size: 13px;\nline-height: var(--line-height-xl);\ncolor: var(--text-body);\ntransition: color var(--duration-fast), border-color var(--duration-base);"
        },
        {
          "selector": ".w-docs-toc__link--sub",
          "css": "padding-inline-start: 26px;\nfont-size: 12.5px;"
        },
        {
          "selector": ".w-docs-toc__link:hover",
          "css": "color: var(--text-title);"
        },
        {
          "selector": ".w-docs-toc__link.is-active",
          "css": "border-inline-start-color: var(--active);\ncolor: var(--text-chip);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-docs-ask-ai",
          "css": "display: flex;\nflex-direction: column;\ngap: var(--space-2xs);\npadding-block: var(--space-l);\nborder-block: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-ask-ai__title",
          "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: var(--line-height-2xl);\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-ask-ai__list",
          "css": "display: flex;\nflex-direction: column;\ngap: 1px;"
        },
        {
          "selector": ".w-docs-ask-ai__item",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-ask-ai__action",
          "css": "display: flex;\nalign-items: center;\ngap: 10px;\ninline-size: calc(100% + 16px);\nmargin-inline: -8px;\npadding: 6px 8px;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncursor: pointer;\ntext-align: left;\nfont-size: 13px;\nline-height: var(--line-height-xl);\ncolor: var(--text-body);\ntransition: background-color var(--duration-fast), color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-ask-ai__action:hover",
          "css": "background: var(--bg-surface-2);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-ask-ai__icon",
          "css": "inline-size: 16px;\nblock-size: 16px;\nflex: 0 0 auto;\ncolor: var(--icon);"
        },
        {
          "selector": ".w-docs-ask-ai__label",
          "css": "flex: 1 1 auto;"
        },
        {
          "selector": ".w-docs-ask-ai__external",
          "css": "inline-size: 12px;\nblock-size: 12px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-docs-ask-ai__action:hover .w-docs-ask-ai__external",
          "css": "transform: translate(2px, -2px);\ncolor: var(--accent);"
        },
        {
          "selector": ".w-docs-cta",
          "css": "display: flex;\nflex-direction: column;\nalign-items: stretch;\ngap: var(--space-2xs);\npadding: var(--space-l);\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--pattern-dots) 0 0 / 12px 12px, var(--bg-surface);"
        },
        {
          "selector": ".w-docs-cta__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-heading);\nline-height: var(--line-height-l);\nletter-spacing: var(--letter-spacing-heading-xs);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-cta__text",
          "css": "margin-block-end: var(--space-2xs);\nfont-size: 13px;\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-copy-page",
          "css": "position: relative;\ndisplay: inline-flex;\nflex: 0 0 auto;\nborder-radius: var(--radius-s);\nbox-shadow: var(--btn-outline-shadow);"
        },
        {
          "selector": ".w-docs-copy-page__main, .w-docs-copy-page__toggle",
          "css": "display: inline-flex;\nalign-items: center;\njustify-content: center;\nblock-size: 36px;\nborder: 0;\nbackground: var(--btn-outline-bg);\ncursor: pointer;\ncolor: var(--btn-outline-fg);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-copy-page__main",
          "css": "gap: var(--space-2xs);\npadding: 0 var(--space-xs);\nborder-radius: var(--radius-s) 0 0 var(--radius-s);\nborder-inline-end: var(--stroke-subtle);\nfont-size: 13px;\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-docs-copy-page__toggle",
          "css": "inline-size: 34px;\nborder-radius: 0 var(--radius-s) var(--radius-s) 0;"
        },
        {
          "selector": ".w-docs-copy-page__main:hover, .w-docs-copy-page__toggle:hover",
          "css": "background: var(--btn-outline-bg-hover);"
        },
        {
          "selector": ".w-docs-copy-page__icon",
          "css": "inline-size: 15px;\nblock-size: 15px;\ncolor: var(--icon);"
        },
        {
          "selector": ".w-docs-copy-page__caret",
          "css": "inline-size: 14px;\nblock-size: 14px;\ncolor: var(--icon);\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-docs-copy-page.is-open .w-docs-copy-page__caret",
          "css": "transform: rotate(180deg);"
        },
        {
          "selector": ".w-docs-copy-page.is-copied .w-docs-copy-page__icon",
          "css": "color: var(--success);"
        },
        {
          "selector": ".w-docs-copy-page__menu",
          "css": "position: absolute;\ninset-block-start: calc(100% + 8px);\ninset-inline-end: 0;\nz-index: 40;\ndisplay: flex;\nflex-direction: column;\ngap: 2px;\ninline-size: 300px;\npadding: 6px;\nborder-radius: var(--radius-m);\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-popover);\nopacity: 0;\nvisibility: hidden;\ntransform: translateY(-4px) scale(0.98);\ntransform-origin: top right;\ntransition: opacity var(--duration-base), transform var(--duration-slow) var(--ease-spring), visibility linear var(--duration-base);\n@media (max-width: 767px) {\n  inset-inline-end: auto;\n  inset-inline-start: 0;\n  inline-size: min(300px, 100vw - 40px);\n  transform-origin: top left;\n}"
        },
        {
          "selector": ".w-docs-copy-page.is-open .w-docs-copy-page__menu",
          "css": "opacity: 1;\nvisibility: visible;\ntransform: none;\ntransition-delay: 0s;"
        },
        {
          "selector": ".w-docs-copy-page__item",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\npadding: var(--space-2xs) 10px;\nborder-radius: var(--radius-s);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-copy-page__item:hover",
          "css": "background: var(--bg-surface-2);"
        },
        {
          "selector": ".w-docs-copy-page__item-icon",
          "css": "display: grid;\nplace-items: center;\nflex: 0 0 auto;\ninline-size: 30px;\nblock-size: 30px;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-s);\nbackground: var(--bg-surface-2);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-copy-page__item-glyph",
          "css": "inline-size: 16px;\nblock-size: 16px;"
        },
        {
          "selector": ".w-docs-copy-page__item-text",
          "css": "display: flex;\nflex-direction: column;\nflex: 1 1 auto;\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-docs-copy-page__item-title",
          "css": "font-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-l);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-copy-page__item-meta",
          "css": "font-size: var(--text-xs);\nline-height: var(--line-height-l);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-copy-page__item-external",
          "css": "inline-size: 12px;\nblock-size: 12px;\nflex: 0 0 auto;\ncolor: var(--icon-muted);"
        },
        {
          "selector": ".w-docs-share",
          "css": "display: flex;\nflex-wrap: wrap;\nalign-items: flex-end;\njustify-content: space-between;\ngap: var(--space-s) var(--space-l);\nmargin: var(--space-l) 0 var(--space-xl);\npadding-block-end: var(--space-s);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-share__group",
          "css": "display: flex;\nflex-direction: column;\ngap: 6px;"
        },
        {
          "selector": ".w-docs-share__group--end",
          "css": "align-items: flex-end;\n@media (max-width: 767px) {\n  align-items: flex-start;\n}"
        },
        {
          "selector": ".w-docs-share__label",
          "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: var(--line-height-2xl);\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-share__icons",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-3xs);"
        },
        {
          "selector": ".w-docs-share__button",
          "css": "position: relative;\ndisplay: grid;\nplace-items: center;\ninline-size: 32px;\nblock-size: 32px;\npadding: 0;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncursor: pointer;\ncolor: var(--icon);\ntransition: background-color var(--duration-fast), color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-share__button:hover",
          "css": "background: var(--bg-surface-2);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-share__button.is-copied",
          "css": "color: var(--success);"
        },
        {
          "selector": ".w-docs-share__icon",
          "css": "inline-size: 17px;\nblock-size: 17px;"
        },
        {
          "selector": ".w-docs-callout",
          "css": "display: flex;\nalign-items: flex-start;\ngap: var(--space-xs);\nmargin: var(--space-l) 0;\npadding: var(--space-s) var(--space-m);\nborder-radius: var(--radius-m);\nbackground: color-mix(in srgb, var(--primary) 6%, transparent);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 18%, transparent);"
        },
        {
          "selector": ".w-docs-callout--tip",
          "css": "background: color-mix(in srgb, var(--success) 7%, transparent);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--success) 22%, transparent);"
        },
        {
          "selector": ".w-docs-callout--warning",
          "css": "background: color-mix(in srgb, var(--warning) 8%, transparent);\nbox-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warning) 24%, transparent);"
        },
        {
          "selector": ".w-docs-callout__icon",
          "css": "flex: 0 0 auto;\ninline-size: 18px;\nblock-size: 18px;\nmargin-block-start: 3px;\ncolor: var(--primary);"
        },
        {
          "selector": ".w-docs-callout--tip .w-docs-callout__icon",
          "css": "color: var(--success);"
        },
        {
          "selector": ".w-docs-callout--warning .w-docs-callout__icon",
          "css": "color: var(--warning);"
        },
        {
          "selector": ".w-docs-callout__body",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\nmin-inline-size: 0;"
        },
        {
          "selector": ".w-docs-callout__title",
          "css": "font-size: var(--text-s);\nfont-weight: var(--font-weight-strong);\nline-height: var(--line-height-3xl);\ncolor: var(--text-chip);"
        },
        {
          "selector": ".w-docs-callout--tip .w-docs-callout__title",
          "css": "color: var(--success-fg);"
        },
        {
          "selector": ".w-docs-callout--warning .w-docs-callout__title",
          "css": "color: var(--warning-fg);"
        },
        {
          "selector": ".w-docs-callout__text",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-code",
          "css": "margin: var(--space-l) 0;\noverflow: hidden;\nborder-radius: var(--radius-m);\nbackground: var(--bg-base);\nbox-shadow: 0 0 0 1px var(--border-base);"
        },
        {
          "selector": ".w-docs-code__bar",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-2xs);\npadding: 6px 6px 6px var(--space-s);\nborder-block-end: 1px solid var(--border-base);\nbackground: var(--bg-base-3);"
        },
        {
          "selector": ".w-docs-code__lang",
          "css": "padding: 1px 6px;\nborder-radius: var(--radius-xs);\nbackground: var(--bg-base-2);\nfont-family: var(--font-family-mono);\nfont-size: 11px;\nletter-spacing: 0.3px;\ncolor: var(--text-contrast-highlight);"
        },
        {
          "selector": ".w-docs-code__file",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\ncolor: var(--text-contrast-body);"
        },
        {
          "selector": ".w-docs-code__copy",
          "css": "display: inline-flex;\nalign-items: center;\ngap: 6px;\nblock-size: 28px;\npadding: 0 10px;\nborder: 0;\nborder-radius: var(--radius-s);\nbackground: none;\ncursor: pointer;\nfont-size: var(--text-xs);\ncolor: var(--text-contrast-body);\ntransition: background-color var(--duration-fast), color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-code__copy:hover",
          "css": "background: var(--bg-base-2);\ncolor: var(--text-contrast);"
        },
        {
          "selector": ".w-docs-code__copy.is-copied",
          "css": "color: var(--success);"
        },
        {
          "selector": ".w-docs-code__copy-icon",
          "css": "inline-size: 14px;\nblock-size: 14px;"
        },
        {
          "selector": ".w-docs-code__pre",
          "css": "margin: 0;\npadding: var(--space-s) var(--space-m);\noverflow-x: auto;"
        },
        {
          "selector": ".w-docs-code__code",
          "css": "font-family: var(--font-family-mono);\nfont-size: 13px;\nline-height: var(--line-height-3xl);\ncolor: var(--text-contrast);"
        },
        {
          "selector": ".w-docs-code__prompt",
          "css": "color: var(--text-contrast-highlight);\nuser-select: none;"
        },
        {
          "selector": ".w-docs-code__comment",
          "css": "color: var(--text-contrast-muted);"
        },
        {
          "selector": ".w-docs-code__string",
          "css": "color: var(--success);"
        },
        {
          "selector": ".w-docs-figure",
          "css": "margin: var(--space-xl) 0;"
        },
        {
          "selector": ".w-docs-figure__frame",
          "css": "padding: var(--space-xl) var(--space-xl) 0;\noverflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--pattern-dots) 0 0 / 14px 14px, var(--bg-surface-2);"
        },
        {
          "selector": ".w-docs-figure__caption",
          "css": "margin-block-start: var(--space-2xs);\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nline-height: var(--line-height-2xl);\nletter-spacing: 0.2px;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-steps",
          "css": "display: flex;\nflex-direction: column;\nmargin: var(--space-l) 0;\ncounter-reset: w-docs-step;"
        },
        {
          "selector": ".w-docs-steps__item",
          "css": "position: relative;\npadding: 0 0 var(--space-l) 44px;\ncounter-increment: w-docs-step;"
        },
        {
          "selector": ".w-docs-steps__item::before",
          "css": "content: counter(w-docs-step, decimal-leading-zero);\nposition: absolute;\ninset-block-start: 0;\ninset-inline-start: 0;\ndisplay: grid;\nplace-items: center;\ninline-size: 28px;\nblock-size: 28px;\nborder-radius: var(--radius-full);\nbackground: var(--bg-surface);\nbox-shadow: inset 0 0 0 1px var(--border-light);\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-chip);"
        },
        {
          "selector": ".w-docs-steps__item::after",
          "css": "content: \"\";\nposition: absolute;\ninset-block-start: 32px;\ninset-block-end: 4px;\ninset-inline-start: 13.5px;\nborder-inline-start: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-steps__item:last-child",
          "css": "padding-block-end: 0;"
        },
        {
          "selector": ".w-docs-steps__item:last-child::after",
          "css": "display: none;"
        },
        {
          "selector": ".w-docs-steps__title",
          "css": "margin-block-end: 2px;\nfont-size: var(--text-m);\nfont-weight: var(--font-weight-strong);\nline-height: var(--line-height-3xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-steps__text",
          "css": "font-size: var(--text-s);\nline-height: var(--line-height-3xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-pager",
          "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: 1px;\nmargin-block-start: var(--space-3xl);\noverflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--border-subtle);"
        },
        {
          "selector": ".w-docs-pager__link",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\npadding: var(--space-m) var(--space-l);\nbackground: var(--bg-surface);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-pager__link--next",
          "css": "align-items: flex-end;\ntext-align: right;"
        },
        {
          "selector": ".w-docs-pager__link:hover",
          "css": "background: var(--bg-surface-4);"
        },
        {
          "selector": ".w-docs-pager__label",
          "css": "display: inline-flex;\nalign-items: center;\ngap: 6px;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-pager__icon",
          "css": "inline-size: 12px;\nblock-size: 12px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-docs-pager__icon--prev",
          "css": "transform: scaleX(-1);"
        },
        {
          "selector": ".w-docs-pager__link--prev:hover .w-docs-pager__icon--prev",
          "css": "transform: scaleX(-1) translateX(3px);"
        },
        {
          "selector": ".w-docs-pager__link--next:hover .w-docs-pager__icon",
          "css": "transform: translateX(3px);"
        },
        {
          "selector": ".w-docs-pager__title",
          "css": "font-family: var(--font-family-display);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-heading);\nline-height: var(--line-height-l);\ncolor: var(--text-title);\ntransition: color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-pager__link:hover .w-docs-pager__title",
          "css": "color: var(--accent);"
        },
        {
          "selector": ".w-docs-search-dialog",
          "css": "position: fixed;\ninset: 0;\nz-index: 130;\ndisplay: flex;\njustify-content: center;\nalign-items: flex-start;\npadding: 12vh var(--layout-margin) var(--layout-margin);\nbackground: color-mix(in srgb, var(--bg-night) 45%, transparent);\nbackdrop-filter: blur(3px);\nopacity: 0;\nvisibility: hidden;\ntransition: opacity var(--duration-base), visibility linear var(--duration-base);"
        },
        {
          "selector": ".w-docs-search-dialog.is-open",
          "css": "opacity: 1;\nvisibility: visible;\ntransition-delay: 0s;"
        },
        {
          "selector": ".w-docs-search-dialog__panel",
          "css": "display: flex;\nflex-direction: column;\ninline-size: min(620px, 100%);\nmax-block-size: 70vh;\noverflow: hidden;\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface);\nbox-shadow: var(--shadow-popover);\ntransform: translateY(-8px) scale(0.98);\ntransition: transform var(--duration-slow) var(--ease-spring);"
        },
        {
          "selector": ".w-docs-search-dialog.is-open .w-docs-search-dialog__panel",
          "css": "transform: none;"
        },
        {
          "selector": ".w-docs-search-dialog__field",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\npadding: var(--space-s) var(--space-m);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-docs-search-dialog__icon",
          "css": "flex: 0 0 auto;\ninline-size: 18px;\nblock-size: 18px;\ncolor: var(--accent);"
        },
        {
          "selector": ".w-docs-search-dialog__input",
          "css": "flex: 1 1 auto;\nmin-inline-size: 0;\npadding: 0;\nborder: 0;\noutline: 0;\nbackground: none;\nfont-size: var(--text-m);\nline-height: var(--line-height-2xl);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-search-dialog__input::placeholder",
          "css": "color: var(--text-disabled);"
        },
        {
          "selector": ".w-docs-search-dialog__input::-webkit-search-cancel-button",
          "css": "display: none;"
        },
        {
          "selector": ".w-docs-search-dialog__close",
          "css": "flex: 0 0 auto;\npadding: 2px 8px;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-xs);\nbackground: var(--bg-surface-2);\ncursor: pointer;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-search-dialog__results",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\npadding: var(--space-2xs);\noverflow-y: auto;"
        },
        {
          "selector": ".w-docs-search-dialog__result",
          "css": "display: block;"
        },
        {
          "selector": ".w-docs-search-dialog__hit",
          "css": "display: flex;\nflex-direction: column;\ngap: 2px;\npadding: 10px var(--space-s);\nborder-radius: var(--radius-m);\ntransition: background-color var(--duration-fast);"
        },
        {
          "selector": ".w-docs-search-dialog__hit.is-selected",
          "css": "background: var(--bg-accent);"
        },
        {
          "selector": ".w-docs-search-dialog__hit-category",
          "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\nletter-spacing: var(--letter-spacing-mono);\ntext-transform: uppercase;\ncolor: var(--text-chip);"
        },
        {
          "selector": ".w-docs-search-dialog__hit-title",
          "css": "font-size: 15px;\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-l);\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-search-dialog__hit-excerpt",
          "css": "font-size: 13px;\nline-height: var(--line-height-2xl);\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-docs-search-dialog__empty",
          "css": "padding: var(--space-xl) var(--space-m);\ntext-align: center;\nfont-size: var(--text-s);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-search-dialog__query",
          "css": "color: var(--text-title);\nfont-weight: var(--font-weight-medium);"
        },
        {
          "selector": ".w-docs-search-dialog__foot",
          "css": "display: flex;\nalign-items: center;\ngap: var(--space-s);\npadding: 10px var(--space-m);\nborder-block-start: var(--stroke-subtle);\nbackground: var(--bg-surface-4);\nfont-size: var(--text-xs);\ncolor: var(--text-body-dark);"
        },
        {
          "selector": ".w-docs-search-dialog__hint",
          "css": "display: inline-flex;\nalign-items: center;\ngap: var(--space-3xs);"
        },
        {
          "selector": ".w-docs-search-dialog__key",
          "css": "min-inline-size: 20px;\npadding: 1px 5px;\nborder: var(--stroke);\nborder-block-end-width: 2px;\nborder-radius: var(--radius-xs);\nbackground: var(--bg-surface);\ntext-align: center;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-title);"
        },
        {
          "selector": ".w-docs-sidebar.is-open",
          "css": "@media (max-width: 991px) {\n  visibility: visible;\n  translate: 0 0;\n  box-shadow: 0 0 0 100vmax color-mix(in srgb, var(--bg-night) 45%, transparent);\n  transition-delay: 0s;\n}"
        }
      ]
    },
    {
      "id": "glob-pxpace-header",
      "name": "PXpace header",
      "rules": [
        {
          "selector": ".w-header",
          "css": "position: relative;\nz-index: 50;\nblock-size: var(--layout-header-h);\nborder-block-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-header__container",
          "css": "block-size: 100%;\nmax-inline-size: min(var(--layout-frame), 100%);\nborder-inline: var(--stroke-subtle);"
        },
        {
          "selector": ".w-header__bar",
          "css": "display: flex;\nflex-direction: row;\nalign-items: center;\njustify-content: space-between;\ngap: var(--space-l);\nblock-size: 100%;\npadding-inline: var(--space-l);"
        },
        {
          "selector": ".w-header__logo",
          "css": "display: inline-flex;\nflex: 0 0 auto;\nalign-items: center;\npadding-inline: var(--space-2xs);"
        },
        {
          "selector": ".w-header__logo-image",
          "css": "flex: 0 0 auto;\ninline-size: auto;\nmax-inline-size: none;\nblock-size: 28px;"
        },
        {
          "selector": ".w-header__logo-image--dark",
          "css": "display: none;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-header__logo-image--light",
          "css": "display: none;"
        },
        {
          "selector": "html[data-brx-theme=\"dark\"] .w-header__logo-image--dark",
          "css": "display: block;"
        },
        {
          "selector": ".w-header__menu",
          "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: var(--space-xs);\n@media (max-width: 991px) {\n  display: none;\n}"
        },
        {
          "selector": ".w-header__actions",
          "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: var(--space-2xs);\n@media (max-width: 478px) {\n  display: none;\n}"
        },
        {
          "selector": ".w-header__mega",
          "css": "position: absolute;\ninset-block-start: 100%;\ninset-inline-start: 50%;\nz-index: 50;\ninline-size: min(var(--layout-frame), 100vw - 48px);\nopacity: 0;\nvisibility: hidden;\ntransform: translate(-50%, -8px);\ntransition: opacity 180ms, transform 180ms, visibility linear 180ms;"
        },
        {
          "selector": ".w-header__mega.is-open",
          "css": "opacity: 1;\nvisibility: visible;\ntransform: translate(-50%, 0);"
        },
        {
          "selector": ".w-header__mega-panel",
          "css": "display: flex;\nflex-direction: row;\ngap: var(--space-s);\npadding-inline-end: var(--space-s);\nborder: var(--stroke-subtle);\nbackground: var(--bg-body);"
        },
        {
          "selector": ".w-header__mega-main",
          "css": "flex: 1 1 884px;\nmin-inline-size: 0;\nborder-inline-end: var(--stroke-subtle);"
        },
        {
          "selector": ".w-header__mega-heading",
          "css": "padding: var(--space-l);\nbackground: var(--bg-header);\nfont-size: var(--text-xs);\nline-height: var(--line-height-m);\nletter-spacing: 0.02em;\ntext-transform: uppercase;\ncolor: var(--text-body);"
        },
        {
          "selector": ".w-header__mega-grid",
          "css": "display: grid;\ngrid-template-columns: var(--columns-2);\ngap: 1px;\npadding-block-start: 1px;\nbackground: var(--border-subtle);"
        },
        {
          "selector": ".w-header__mega-cell",
          "css": "background: var(--bg-body);"
        },
        {
          "selector": ".w-header__mega-promos",
          "css": "flex: 0 0 284px;\npadding-block-start: var(--space-s);"
        },
        {
          "selector": ".w-header__mega-promo",
          "css": "display: block;\noverflow: hidden;\nborder-radius: 5.19px;\ntransition: transform var(--duration-base);"
        },
        {
          "selector": ".w-header__mega-promo:hover",
          "css": "transform: translateY(-2px);"
        },
        {
          "selector": ".w-header__mega-promo-image",
          "css": "inline-size: 100%;"
        }
      ]
    }
  ],
