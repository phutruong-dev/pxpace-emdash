      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".w-docs-article",
              "css": "position: relative;\npadding-inline: var(--layout-margin);"
            },
            {
              "selector": ".w-docs-article::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-docs-article__container",
              "css": "position: relative;\ndisplay: grid;\ngrid-template-columns: var(--layout-docs-sidebar) minmax(0, 1fr) var(--layout-docs-rail);\nalign-items: start;\ncolumn-gap: var(--space-xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding: var(--space-xl) var(--space-l) var(--space-5xl);\n@media (max-width: 1279px) {\n  grid-template-columns: var(--layout-docs-sidebar) minmax(0, 1fr);\n}\n@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n  padding-block-start: var(--space-s);\n}\n@media (max-width: 767px) {\n  padding-inline: var(--space-s);\n}"
            },
            {
              "selector": ".w-docs-article__container::before, .w-docs-article__container::after",
              "css": "content: \"\";\nposition: absolute;\ninset-block-start: 0;\ninset-block-end: 0;\npointer-events: none;\nborder-inline-start: var(--stroke-subtle);"
            },
            {
              "selector": ".w-docs-article__container::before",
              "css": "inset-inline-start: calc(var(--space-l) + var(--layout-docs-sidebar) + var(--space-xl) / 2);\n@media (max-width: 991px) {\n  display: none;\n}"
            },
            {
              "selector": ".w-docs-article__container::after",
              "css": "inset-inline-end: calc(var(--space-l) + var(--layout-docs-rail) + var(--space-xl) / 2);"
            },
            {
              "selector": ".w-docs-article__main",
              "css": "display: flex;\nflex-direction: column;\nalign-items: center;\nmin-inline-size: 0;"
            },
            {
              "selector": ".w-docs-article__topbar",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: var(--space-xs);\ninline-size: 100%;\nmax-inline-size: var(--layout-docs-measure);\nmargin-block-end: var(--space-2xl);\n@media (max-width: 991px) {\n  flex-wrap: wrap;\n  margin-block-end: var(--space-xl);\n  padding-block-end: var(--space-s);\n  border-block-end: var(--stroke-subtle);\n}"
            },
            {
              "selector": ".w-docs-article__crumbs",
              "css": "flex: 1 1 auto;\nmin-inline-size: 0;\n@media (max-width: 991px) {\n  order: 4;\n  flex-basis: 100%;\n}\n@media (max-width: 767px) {\n  display: none;\n}"
            },
            {
              "selector": ".w-docs-article__crumbs-list",
              "css": "display: flex;\nflex-direction: row;\nalign-items: center;\ngap: 6px;\nmin-inline-size: 0;\nfont-size: 13px;\nline-height: var(--line-height-xl);"
            },
            {
              "selector": ".w-docs-article__crumb",
              "css": "display: inline-flex;\nalign-items: center;\ngap: 6px;\nmin-inline-size: 0;\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-docs-article__crumb-link",
              "css": "white-space: nowrap;\ncolor: var(--text-body);\ntransition: color var(--duration-fast);"
            },
            {
              "selector": ".w-docs-article__crumb-link:hover",
              "css": "color: var(--text-title);"
            },
            {
              "selector": ".w-docs-article__crumb-separator",
              "css": "flex: 0 0 auto;\ninline-size: 12px;\nblock-size: 12px;\ncolor: var(--icon-muted);"
            },
            {
              "selector": ".w-docs-article__crumb-current",
              "css": "overflow: hidden;\nmax-inline-size: 30ch;\nwhite-space: nowrap;\ntext-overflow: ellipsis;"
            },
            {
              "selector": ".w-docs-article__topbar-search",
              "css": "display: none;\nflex: 1 1 auto;\nmin-inline-size: 0;\n@media (max-width: 991px) {\n  display: block;\n}"
            },
            {
              "selector": ".w-docs-article__body",
              "css": "display: flex;\nflex-direction: column;\nflex-wrap: nowrap;\nalign-items: stretch;\ninline-size: 100%;\nmax-inline-size: var(--layout-docs-measure);"
            },
            {
              "selector": ".w-docs-article__header",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);"
            },
            {
              "selector": ".w-docs-article .w-heading-l",
              "css": "text-wrap: balance;"
            },
            {
              "selector": ".w-docs-article__meta",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\nalign-items: center;\ngap: var(--space-2xs);\nfont-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nletter-spacing: 0.2px;\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-docs-article__meta-dot",
              "css": "inline-size: 3px;\nblock-size: 3px;\nborder-radius: var(--radius-full);\nbackground: var(--icon-muted);"
            },
            {
              "selector": ".w-docs-article__prose",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".w-docs-article__rail",
              "css": "position: sticky;\ninset-block-start: var(--space-l);\ndisplay: flex;\nflex-direction: column;\nflex-wrap: nowrap;\nalign-items: stretch;\ngap: var(--space-l);\nmax-block-size: calc(100vh - 2 * var(--space-l));\noverflow-y: auto;\nscrollbar-width: none;"
            },
            {
              "selector": ".w-docs-article__container::after, .w-docs-article__rail",
              "css": "@media (max-width: 1279px) {\n  display: none;\n}"
            }
          ]
        }
      ]
    },
