      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".w-ds-intro, .w-ds-colors, .w-ds-type, .w-ds-fonts, .w-ds-spacing, .w-ds-shape, .w-ds-motion, .w-ds-components",
              "css": "position: relative;\npadding: var(--space-4xl) var(--layout-margin);\nborder-block-start: var(--stroke-subtle);"
            },
            {
              "selector": ".w-ds-intro",
              "css": "border-block-start: 0;\npadding-block-end: var(--space-3xl);"
            },
            {
              "selector": ".w-ds-intro::before, .w-ds-colors::before, .w-ds-type::before, .w-ds-fonts::before, .w-ds-spacing::before, .w-ds-shape::before, .w-ds-motion::before, .w-ds-components::before",
              "css": "content: \"\";\nposition: absolute;\nz-index: 2;\ninset-block: 0;\ninset-inline-start: 50%;\npointer-events: none;\ninline-size: min(var(--layout-frame), 100% - 2 * var(--layout-margin));\ntransform: translateX(-50%);\nborder-inline: var(--stroke-subtle);"
            },
            {
              "selector": ".w-ds-intro__container",
              "css": "align-items: center;\ngap: var(--space-s);\nmax-inline-size: min(var(--layout-frame), 100%);\ntext-align: center;"
            },
            {
              "selector": ".w-ds-intro__actions",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\njustify-content: center;\ngap: var(--space-s);\nmargin-block-start: var(--space-s);"
            },
            {
              "selector": ".w-ds-colors__container, .w-ds-type__container, .w-ds-fonts__container, .w-ds-spacing__container, .w-ds-shape__container, .w-ds-motion__container, .w-ds-components__container",
              "css": "align-items: stretch;\ngap: var(--space-2xl);\nmax-inline-size: min(var(--layout-frame), 100%);\npadding-inline: var(--layout-inset);"
            },
            {
              "selector": ".w-ds-head",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);\nmax-inline-size: 720px;"
            },
            {
              "selector": ".w-ds-head__number",
              "css": "font-family: var(--font-family-mono);\nfont-size: var(--text-xs);\nletter-spacing: var(--letter-spacing-mono);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-ds-subhead",
              "css": "margin-block-end: var(--space-s);\nfont-size: var(--text-l);\nfont-weight: var(--font-weight-medium);\nline-height: var(--line-height-l);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-ds-group",
              "css": "display: flex;\nflex-direction: column;"
            },
            {
              "selector": ".w-ds-note",
              "css": "font-size: 13px;\nline-height: var(--line-height-2xl);\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-ds-code",
              "css": "font-family: var(--font-family-mono);\nfont-size: 12px;\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-ds-swatches",
              "css": "display: grid;\ngrid-template-columns: repeat(6, minmax(0, 1fr));\ngap: var(--space-s);"
            },
            {
              "selector": ".w-ds-swatch",
              "css": "overflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-m);\nbackground: var(--bg-surface);"
            },
            {
              "selector": ".w-ds-swatch__chip",
              "css": "block-size: 72px;\nborder-block-end: var(--stroke-subtle);"
            },
            {
              "selector": ".w-ds-swatch__meta",
              "css": "display: flex;\nflex-direction: column;\ngap: 2px;\npadding: 10px var(--space-xs);"
            },
            {
              "selector": ".w-ds-swatch__name",
              "css": "font-family: var(--font-family-mono);\nfont-size: 12px;\nfont-weight: var(--font-weight-medium);\ncolor: var(--text-title);\nword-break: break-all;"
            },
            {
              "selector": ".w-ds-swatch__value",
              "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-body);\nword-break: break-all;"
            },
            {
              "selector": ".w-ds-table",
              "css": "overflow: hidden;\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);\nbackground: var(--bg-surface);"
            },
            {
              "selector": ".w-ds-table__row",
              "css": "display: grid;\ngrid-template-columns: 210px minmax(0, 1fr) 230px;\nalign-items: center;\ngap: var(--space-l);\npadding: var(--space-m) var(--space-l);\nborder-block-end: var(--stroke-subtle);"
            },
            {
              "selector": ".w-ds-table__row:last-child",
              "css": "border-block-end: 0;"
            },
            {
              "selector": ".w-ds-table__meta",
              "css": "font-family: var(--font-family-mono);\nfont-size: 11px;\nline-height: var(--line-height-3xl);\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-ds-table__sample",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".w-ds-scale",
              "css": "display: flex;\nflex-direction: column;\ngap: 10px;"
            },
            {
              "selector": ".w-ds-scale__row",
              "css": "display: grid;\ngrid-template-columns: 120px 56px minmax(0, 1fr);\nalign-items: center;\ngap: var(--space-xs);\nfont-family: var(--font-family-mono);\nfont-size: 12px;\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-ds-scale__bar",
              "css": "display: block;\nblock-size: 12px;\nborder-radius: 2px;\nbackground: var(--primary-l-3);"
            },
            {
              "selector": ".w-ds-tiles",
              "css": "display: grid;\ngrid-template-columns: repeat(4, minmax(0, 1fr));\ngap: var(--space-l);"
            },
            {
              "selector": ".w-ds-tile",
              "css": "display: flex;\nflex-direction: column;\nalign-items: center;\njustify-content: center;\ngap: var(--space-3xs);\nblock-size: 120px;\npadding: var(--space-2xs);\nborder: var(--stroke-subtle);\nbackground: var(--bg-surface);\ntext-align: center;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-body);"
            },
            {
              "selector": ".w-ds-tile__name",
              "css": "font-family: var(--font-family);\nfont-size: var(--text-s);\nfont-weight: var(--font-weight-medium);\ncolor: var(--text-title);"
            },
            {
              "selector": ".w-ds-panels",
              "css": "display: grid;\ngrid-template-columns: var(--columns-3);\ngap: var(--space-s);"
            },
            {
              "selector": ".w-ds-panels--two",
              "css": "grid-template-columns: var(--columns-2);"
            },
            {
              "selector": ".w-ds-panel",
              "css": "display: flex;\nflex-direction: row;\nflex-wrap: wrap;\nalign-items: center;\ngap: var(--space-s);\nmin-inline-size: 0;\npadding: var(--space-l);\nborder: var(--stroke-subtle);\nborder-radius: var(--radius-l);"
            },
            {
              "selector": ".w-ds-panel--light",
              "css": "background: var(--bg-surface);"
            },
            {
              "selector": ".w-ds-panel--column",
              "css": "flex-direction: column;\nalign-items: stretch;"
            },
            {
              "selector": ".w-ds-panel__label",
              "css": "inline-size: 100%;\nfont-family: var(--font-family-mono);\nfont-size: 11px;\ncolor: var(--text-body-dark);"
            },
            {
              "selector": ".w-ds-panel__frame",
              "css": "inline-size: 100%;"
            },
            {
              "selector": ".w-ds-panels__item",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".w-ds-panels, .w-ds-panels--two",
              "css": "@media (max-width: 991px) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            }
          ]
        }
      ],
      "seo": {
        "noindex": true
      }
    },
