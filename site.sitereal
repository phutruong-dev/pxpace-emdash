  "snippets": [
    {
      "name": "Theme mode restore",
      "lang": "js",
      "code": "(function(){var m=localStorage.getItem('brx_mode')||'light';if(m==='auto'){m=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-brx-theme',m)})();",
      "placement": "head",
      "applyTo": {
        "all": true
      },
      "enabled": true,
      "id": "snip-theme-mode-restore"
    },
    {
      "name": "PXpace site behaviour",
      "lang": "js",
      "code": "/* PXpace mockup behaviour. Hooks are data-* attributes only (never styling classes);\n   state is written as is-* classes / aria-* attributes. In Bricks: Settings › Custom code (body footer). */\n(() => {\n  const root = document.documentElement;\n  root.classList.add('has-js');\n  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  /* scroll reveal: [data-animate] gets .is-in once it enters the viewport */\n  const io = new IntersectionObserver((entries) => entries.forEach((e) => {\n    if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }\n  }), { threshold: 0.15 });\n  document.querySelectorAll('[data-animate]').forEach((el) => io.observe(el));\n\n  /* marquee: duplicate the children once so translate(-50%) loops seamlessly */\n  document.querySelectorAll('[data-marquee]').forEach((track) => {\n    [...track.children].forEach((child) => {\n      const copy = child.cloneNode(true);\n      copy.setAttribute('aria-hidden', 'true');\n      copy.removeAttribute('data-component');\n      track.append(copy);\n    });\n  });\n\n  /* switch (hero toggle): flips aria-checked and the active word of its group */\n  document.querySelectorAll('[data-switch]').forEach((sw) => sw.addEventListener('click', () => {\n    const on = sw.getAttribute('aria-checked') !== 'true';\n    sw.setAttribute('aria-checked', String(on));\n    const group = sw.closest('[data-switch-group]');\n    if (!group) return;\n    group.querySelectorAll('[data-switch-word]').forEach((w) => w.classList.toggle('is-active', (w.dataset.switchWord === 'on') === on));\n  }));\n\n  /* accordion: one item open; optional image swap on [data-accordion-target] inside the same section */\n  document.querySelectorAll('[data-accordion]').forEach((acc) => {\n    const target = acc.closest('section')?.querySelector('[data-accordion-target]');\n    acc.querySelectorAll('[data-accordion-trigger]').forEach((btn) => btn.addEventListener('click', () => {\n      const item = btn.closest('[data-accordion-item]');\n      acc.querySelectorAll('[data-accordion-item]').forEach((i) => {\n        const open = i === item;\n        i.classList.toggle('is-open', open);\n        i.querySelector('[data-accordion-trigger]').setAttribute('aria-expanded', String(open));\n      });\n      if (target && item.dataset.accordionImage) target.src = item.dataset.accordionImage;\n    }));\n  });\n\n  /* mega menu: [data-mega-trigger=\"x\"] toggles [data-mega=\"x\"] */\n  const closeMegas = () => document.querySelectorAll('[data-mega-trigger]').forEach((t) => {\n    t.setAttribute('aria-expanded', 'false');\n    document.querySelector(`[data-mega=\"${t.dataset.megaTrigger}\"]`)?.classList.remove('is-open');\n  });\n  document.querySelectorAll('[data-mega-trigger]').forEach((t) => t.addEventListener('click', (e) => {\n    e.stopPropagation();\n    const open = t.getAttribute('aria-expanded') !== 'true';\n    closeMegas();\n    t.setAttribute('aria-expanded', String(open));\n    document.querySelector(`[data-mega=\"${t.dataset.megaTrigger}\"]`)?.classList.toggle('is-open', open);\n  }));\n  document.addEventListener('click', (e) => { if (!e.target.closest('[data-mega]')) closeMegas(); });\n  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMegas(); });\n\n  /* light / dark switch: same storage key + attribute Bricks uses (localStorage \"brx_mode\", data-brx-theme) */\n  document.querySelectorAll('[data-theme-toggle]').forEach((t) => t.addEventListener('click', () => {\n    const next = root.getAttribute('data-brx-theme') === 'dark' ? 'light' : 'dark';\n    root.setAttribute('data-brx-theme', next);\n    localStorage.setItem('brx_mode', next);\n    t.setAttribute('aria-pressed', String(next === 'dark'));\n  }));\n\n  /* footer \"Load More\" */\n  document.querySelectorAll('[data-menu-more]').forEach((b) => b.addEventListener('click', () => {\n    b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));\n  }));\n\n  /* per-character label swap: [data-split-chars=\"<char class>\"] wraps every character of each child label in a\n     span of that class with --i = its index (the CSS staggers on it), then marks the box .is-split. The link\n     gets the plain text as aria-label so screen readers do not spell the label out. Without JS (and in the\n     Bricks builder) the CSS falls back to the whole-label swap. */\n  document.querySelectorAll('[data-split-chars]').forEach((box) => {\n    const cls = box.dataset.splitChars;\n    const control = box.closest('a, button');\n    if (control && !control.hasAttribute('aria-label')) control.setAttribute('aria-label', box.firstElementChild.textContent.trim());\n    [...box.children].forEach((label) => {\n      const text = label.textContent.trim();\n      label.textContent = '';\n      [...text].forEach((ch, i) => {\n        const span = document.createElement('span');\n        span.className = cls;\n        span.style.setProperty('--i', i);\n        span.textContent = ch === ' ' ? '\\u00A0' : ch;\n        label.append(span);\n      });\n    });\n    box.classList.add('is-split');\n  });\n\n  /* ---------- forms ----------\n     [data-field] = one field (label + [data-field-control] + hint/error); [data-field-clear] empties its input,\n     [data-reveal] shows / hides a password, [data-meter=\"<input id>\"] rates it, [data-counter=\"<textarea id>\"]\n     counts against maxlength, [data-select] is a custom listbox, [data-datepicker] a calendar dialog,\n     form[data-validate] checks every field on submit (data-demo: no request, shows the status instead).\n     Validation rewards early and punishes late: a field is checked when it is left with a value, re-checked live\n     while it is invalid, and every field at submit. Custom controls write a hidden input and validate on pick. */\n  const fieldParts = (field) => {\n    const custom = field.querySelector('[data-select], [data-datepicker]');\n    return {\n      custom, control: field.querySelector('[data-field-control]'),\n      input: custom ? custom.querySelector('[data-select-input], [data-date-input]') : field.querySelector('input, textarea'),\n      focusable: custom ? custom.querySelector('[data-select-trigger], [data-date-trigger]') : field.querySelector('input, textarea'),\n    };\n  };\n  const validate = (field) => {\n    const { custom, control, input, focusable } = fieldParts(field);\n    const ok = custom ? !(custom.hasAttribute('data-required') && !input.value) : input.checkValidity();\n    field.classList.toggle('is-invalid', !ok);\n    control.classList.toggle('is-invalid', !ok);\n    control.classList.toggle('is-valid', ok && input.value !== '' && !custom);\n    focusable.setAttribute('aria-invalid', String(!ok));\n    return ok;\n  };\n  const shake = (el) => { el.classList.remove('is-shake'); void el.offsetWidth; el.classList.add('is-shake'); };\n  document.addEventListener('animationend', (e) => { if (e.animationName === 'w-shake') e.target.closest('.is-shake')?.classList.remove('is-shake'); });\n\n  document.querySelectorAll('[data-field]').forEach((field) => {\n    const { custom, control, input } = fieldParts(field);\n    if (custom) return; // listbox / calendar validate when a value is picked\n    input.addEventListener('blur', () => { if (input.value !== '' || field.classList.contains('is-invalid')) validate(field); });\n    input.addEventListener('input', () => {\n      if (field.classList.contains('is-invalid')) validate(field);\n      else control.classList.remove('is-valid');\n    });\n    // the whole box is the hit area (padding, icon, affix), like a label\n    control.addEventListener('mousedown', (e) => {\n      if (!e.target.closest('button, input, textarea')) { e.preventDefault(); input.focus(); }\n    });\n  });\n\n  document.querySelectorAll('[data-field-clear]').forEach((btn) => btn.addEventListener('click', () => {\n    const input = btn.closest('[data-field-control]').querySelector('input, textarea');\n    input.value = '';\n    input.dispatchEvent(new Event('input', { bubbles: true }));\n    input.focus();\n  }));\n\n  document.querySelectorAll('[data-reveal]').forEach((btn) => btn.addEventListener('click', () => {\n    const input = btn.closest('[data-field-control]').querySelector('input');\n    const show = input.type === 'password';\n    input.type = show ? 'text' : 'password';\n    btn.setAttribute('aria-pressed', String(show));\n    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');\n    input.focus({ preventScroll: true });\n    input.setSelectionRange(input.value.length, input.value.length);\n  }));\n\n  document.querySelectorAll('[data-meter]').forEach((meter) => {\n    const input = document.getElementById(meter.dataset.meter);\n    const label = meter.querySelector('[data-meter-label]');\n    const hint = label.textContent;\n    const words = meter.dataset.meterLabels.split('|');\n    const levels = ['is-weak', 'is-fair', 'is-good', 'is-strong'];\n    input.addEventListener('input', () => {\n      const v = input.value;\n      const points = (v.length >= 8) + (v.length >= 12) + (/[a-z]/.test(v) && /[A-Z]/.test(v)) + /\\d/.test(v) + /[^A-Za-z0-9]/.test(v);\n      const score = !v ? 0 : v.length < 8 ? 1 : Math.max(1, Math.min(4, points));\n      levels.forEach((c, i) => meter.classList.toggle(c, i === score - 1));\n      label.textContent = score ? words[score - 1] : hint;\n    });\n  });\n\n  document.querySelectorAll('[data-counter]').forEach((counter) => {\n    const input = document.getElementById(counter.dataset.counter);\n    const max = input.maxLength;\n    const update = () => {\n      const n = input.value.length;\n      counter.textContent = `${n} / ${max}`;\n      counter.classList.toggle('is-near', n >= max * 0.9 && n < max);\n      counter.classList.toggle('is-full', n >= max);\n    };\n    input.addEventListener('input', update);\n    update();\n  });\n  /* textareas grow with their content: CSS field-sizing where supported, height from scrollHeight otherwise */\n  if (!CSS.supports('field-sizing', 'content')) document.querySelectorAll('[data-autogrow]').forEach((ta) => {\n    const fit = () => { ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight}px`; };\n    ta.addEventListener('input', fit);\n    fit();\n  });\n\n  /* listbox (ARIA \"select-only combobox\"; with [data-select-search] the search input owns the active option) */\n  document.querySelectorAll('[data-select]').forEach((sel) => {\n    const q = (hook) => sel.querySelector(`[data-select-${hook}]`);\n    const trigger = q('trigger'), value = q('value'), input = q('input'), panel = q('panel'), list = q('list');\n    const search = q('search'), empty = q('empty'), highlight = q('highlight');\n    const options = [...sel.querySelectorAll('[data-select-option]')];\n    const owner = search || list;\n    const field = sel.closest('[data-field]');\n    const labelOf = (o) => o.querySelector('[data-select-label]').textContent;\n    const enabled = () => options.filter((o) => !o.hidden && o.getAttribute('aria-disabled') !== 'true');\n    let active = null, typed = '', typedAt = 0;\n\n    const setActive = (opt, scroll) => {\n      active = opt;\n      if (!opt) { highlight.classList.remove('is-visible'); owner.removeAttribute('aria-activedescendant'); return; }\n      owner.setAttribute('aria-activedescendant', opt.id);\n      const jump = !highlight.classList.contains('is-visible'); // first appearance: place, do not glide\n      if (jump) highlight.style.transition = 'none';\n      highlight.style.transform = `translateY(${list.offsetTop + opt.offsetTop}px)`;\n      highlight.style.height = `${opt.offsetHeight}px`;\n      if (jump) { void highlight.offsetWidth; highlight.style.transition = ''; }\n      highlight.classList.add('is-visible');\n      if (scroll) opt.scrollIntoView({ block: 'nearest' });\n    };\n    const filter = (text) => {\n      const t = text.trim().toLowerCase();\n      options.forEach((o) => { o.hidden = t !== '' && !o.textContent.toLowerCase().includes(t); });\n      empty.hidden = options.some((o) => !o.hidden);\n      setActive(enabled()[0] || null);\n    };\n    const open = () => {\n      if (sel.classList.contains('is-open')) return;\n      const r = trigger.getBoundingClientRect();\n      const below = innerHeight - r.bottom;\n      sel.classList.toggle('is-up', below < panel.offsetHeight + 16 && r.top > below);\n      sel.classList.add('is-open');\n      trigger.setAttribute('aria-expanded', 'true');\n      if (search) { search.value = ''; filter(''); }\n      owner.focus({ preventScroll: true });\n      setActive(options.find((o) => o.getAttribute('aria-selected') === 'true') || enabled()[0], true);\n    };\n    const close = (refocus) => {\n      if (!sel.classList.contains('is-open')) return;\n      sel.classList.remove('is-open');\n      trigger.setAttribute('aria-expanded', 'false');\n      setActive(null);\n      if (refocus) trigger.focus({ preventScroll: true });\n    };\n    const choose = (opt) => {\n      options.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));\n      input.value = opt.dataset.value;\n      value.textContent = labelOf(opt);\n      value.classList.remove('is-placeholder', 'is-changed');\n      void value.offsetWidth;\n      value.classList.add('is-changed');\n      input.dispatchEvent(new Event('change', { bubbles: true }));\n      close(true);\n      if (field) validate(field);\n    };\n\n    trigger.addEventListener('click', () => (sel.classList.contains('is-open') ? close(true) : open()));\n    trigger.addEventListener('keydown', (e) => {\n      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) { e.preventDefault(); open(); }\n    });\n    search?.addEventListener('input', () => filter(search.value));\n    panel.addEventListener('mousedown', (e) => { if (e.target !== search) e.preventDefault(); }); // keep focus inside\n    panel.addEventListener('keydown', (e) => {\n      const opts = enabled();\n      const i = opts.indexOf(active);\n      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {\n        e.preventDefault();\n        const down = e.key === 'ArrowDown';\n        setActive(i < 0 ? opts[down ? 0 : opts.length - 1] : opts[(i + (down ? 1 : -1) + opts.length) % opts.length], true);\n      } else if ((e.key === 'Home' || e.key === 'End') && !search) {\n        e.preventDefault();\n        setActive(e.key === 'Home' ? opts[0] : opts[opts.length - 1], true);\n      } else if (e.key === 'Enter' || (e.key === ' ' && !search && Date.now() - typedAt > 600)) { // a space mid-word types\n        e.preventDefault();\n        if (active) choose(active);\n      } else if (e.key === 'Escape') {\n        e.preventDefault();\n        e.stopPropagation();\n        close(true);\n      } else if (e.key === 'Tab') {\n        close(false);\n      } else if (!search && e.key.length === 1) { // type-ahead\n        if (e.key === ' ') e.preventDefault();\n        const now = Date.now();\n        typed = (now - typedAt > 600 ? '' : typed) + e.key.toLowerCase();\n        typedAt = now;\n        const hit = opts.find((o) => labelOf(o).toLowerCase().startsWith(typed));\n        if (hit) setActive(hit, true);\n      }\n    });\n    options.forEach((o) => {\n      o.addEventListener('mousemove', () => { if (o !== active && o.getAttribute('aria-disabled') !== 'true') setActive(o); });\n      o.addEventListener('click', () => { if (o.getAttribute('aria-disabled') !== 'true') choose(o); });\n    });\n    sel.addEventListener('focusout', (e) => { if (!sel.contains(e.relatedTarget)) close(false); });\n  });\n\n  /* date picker (ARIA date-picker dialog): 6-week grid, Monday first, roving tabindex. Arrows ±1 day / ±1 week,\n     Home/End = week start/end, PageUp/PageDown = month (+ Shift = year), Enter/Space picks, Esc closes.\n     data-min=\"today\" (or an ISO date) disables earlier days; [data-date-preset=\"0|1|7|monday\"] jumps and picks. */\n  const DAY = 864e5;\n  const lang = root.lang || 'en';\n  const pad = (n) => String(n).padStart(2, '0');\n  const iso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\n  const fromIso = (s) => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };\n  const addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);\n  const addMonths = (d, n) => { // keeps the day, clamped to the target month's length\n    const t = new Date(d.getFullYear(), d.getMonth() + n, 1);\n    return new Date(t.getFullYear(), t.getMonth(), Math.min(d.getDate(), new Date(t.getFullYear(), t.getMonth() + 1, 0).getDate()));\n  };\n  const fmtMonth = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' });\n  const fmtLong = new Intl.DateTimeFormat(lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\n  const fmtShort = new Intl.DateTimeFormat(lang, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });\n  const fmtRel = new Intl.RelativeTimeFormat(lang, { numeric: 'auto' });\n  const relative = (d, today) => {\n    const n = Math.round((d - today) / DAY);\n    const t = Math.abs(n) < 14 ? fmtRel.format(n, 'day') : fmtRel.format(Math.round(n / 7), 'week');\n    return t.charAt(0).toUpperCase() + t.slice(1);\n  };\n\n  document.querySelectorAll('[data-datepicker]').forEach((dp) => {\n    const q = (hook) => dp.querySelector(`[data-date-${hook}]`);\n    const trigger = q('trigger'), value = q('value'), rel = q('relative'), input = q('input'), panel = q('panel');\n    const month = q('month'), prev = q('prev'), next = q('next'), days = q('days'), clear = q('clear');\n    const field = dp.closest('[data-field]');\n    const today = addDays(new Date(), 0);\n    const min = dp.dataset.min === 'today' ? today : dp.dataset.min ? fromIso(dp.dataset.min) : null;\n    const placeholder = value.textContent;\n    const tooEarly = (d) => min !== null && d < min;\n    let selected = input.value ? fromIso(input.value) : null;\n    let view = new Date(today.getFullYear(), today.getMonth(), 1);\n    let focusDate = today;\n\n    const render = (dir) => {\n      month.textContent = fmtMonth.format(view);\n      const first = new Date(view.getFullYear(), view.getMonth(), 1);\n      const start = addDays(first, -((first.getDay() + 6) % 7));\n      const weeks = [];\n      for (let w = 0; w < 6; w++) {\n        const row = document.createElement('div');\n        row.className = 'w-datepicker__week';\n        row.setAttribute('role', 'row');\n        for (let i = 0; i < 7; i++) {\n          const d = addDays(start, w * 7 + i);\n          const b = document.createElement('button');\n          b.type = 'button';\n          b.className = 'w-datepicker__day';\n          b.setAttribute('role', 'gridcell');\n          b.dataset.date = iso(d);\n          b.textContent = d.getDate();\n          b.setAttribute('aria-label', fmtLong.format(d));\n          b.tabIndex = +d === +focusDate ? 0 : -1;\n          b.classList.toggle('is-outside', d.getMonth() !== view.getMonth());\n          if (+d === +today) { b.classList.add('is-today'); b.setAttribute('aria-current', 'date'); }\n          if (selected && +d === +selected) { b.classList.add('is-selected'); b.setAttribute('aria-selected', 'true'); }\n          if (tooEarly(d)) b.setAttribute('aria-disabled', 'true');\n          row.append(b);\n        }\n        weeks.push(row);\n      }\n      days.replaceChildren(...weeks);\n      prev.disabled = min !== null && new Date(view.getFullYear(), view.getMonth(), 0) < min;\n      if (dir) [days, month].forEach((n) => { n.classList.remove('is-next', 'is-prev'); void n.offsetWidth; n.classList.add(dir); });\n    };\n    const dayButton = (d) => days.querySelector(`[data-date=\"${iso(d)}\"]`);\n    const moveTo = (d) => { // focus a date, switching months (with a slide) when it lies outside the view\n      const target = new Date(d.getFullYear(), d.getMonth(), 1);\n      const dir = target > view ? 'is-next' : target < view ? 'is-prev' : null;\n      focusDate = d;\n      view = target;\n      render(dir);\n      dayButton(d).focus({ preventScroll: true });\n    };\n    const show = () => {\n      value.textContent = selected ? fmtShort.format(selected) : placeholder;\n      value.classList.toggle('is-placeholder', !selected);\n      rel.textContent = selected ? relative(selected, today) : '';\n      input.value = selected ? iso(selected) : '';\n      value.classList.remove('is-changed');\n      void value.offsetWidth;\n      value.classList.add('is-changed');\n      input.dispatchEvent(new Event('change', { bubbles: true }));\n      if (field) validate(field);\n    };\n    const open = () => {\n      if (dp.classList.contains('is-open')) return;\n      const r = trigger.getBoundingClientRect();\n      const below = innerHeight - r.bottom;\n      dp.classList.toggle('is-up', below < panel.offsetHeight + 16 && r.top > below);\n      focusDate = selected || (min && today < min ? min : today);\n      view = new Date(focusDate.getFullYear(), focusDate.getMonth(), 1);\n      render(null);\n      dp.classList.add('is-open');\n      trigger.setAttribute('aria-expanded', 'true');\n      dayButton(focusDate).focus({ preventScroll: true });\n    };\n    const close = (refocus) => {\n      if (!dp.classList.contains('is-open')) return;\n      dp.classList.remove('is-open');\n      trigger.setAttribute('aria-expanded', 'false');\n      if (refocus) trigger.focus({ preventScroll: true });\n    };\n    const pick = (d) => {\n      if (tooEarly(d)) return;\n      selected = d;\n      moveTo(d);\n      dayButton(d).classList.add('is-picked'); // pop, then close\n      show();\n      setTimeout(() => close(true), 220);\n    };\n\n    trigger.addEventListener('click', () => (dp.classList.contains('is-open') ? close(true) : open()));\n    trigger.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); } });\n    prev.addEventListener('click', () => moveTo(addMonths(focusDate, -1)));\n    next.addEventListener('click', () => moveTo(addMonths(focusDate, 1)));\n    days.addEventListener('click', (e) => { const b = e.target.closest('[data-date]'); if (b) pick(fromIso(b.dataset.date)); });\n    days.addEventListener('keydown', (e) => {\n      const b = e.target.closest('[data-date]');\n      if (!b) return;\n      const d = fromIso(b.dataset.date);\n      const wd = (d.getDay() + 6) % 7;\n      const to = {\n        ArrowLeft: () => addDays(d, -1), ArrowRight: () => addDays(d, 1), ArrowUp: () => addDays(d, -7), ArrowDown: () => addDays(d, 7),\n        Home: () => addDays(d, -wd), End: () => addDays(d, 6 - wd),\n        PageUp: () => addMonths(d, e.shiftKey ? -12 : -1), PageDown: () => addMonths(d, e.shiftKey ? 12 : 1),\n      }[e.key];\n      if (to) { e.preventDefault(); moveTo(to()); }\n    });\n    dp.querySelectorAll('[data-date-preset]').forEach((p) => p.addEventListener('click', () => {\n      const v = p.dataset.datePreset;\n      pick(v === 'monday' ? addDays(today, ((8 - today.getDay()) % 7) || 7) : addDays(today, Number(v)));\n    }));\n    clear.addEventListener('click', () => { selected = null; render(null); show(); close(true); });\n    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(true); } });\n    dp.addEventListener('focusout', (e) => { if (e.relatedTarget && !dp.contains(e.relatedTarget)) close(false); });\n    document.addEventListener('mousedown', (e) => { if (!dp.contains(e.target)) close(false); });\n    if (selected) show();\n  });\n\n  document.querySelectorAll('form[data-validate]').forEach((form) => {\n    form.noValidate = true;\n    form.addEventListener('input', () => form.classList.remove('is-sent'));\n    form.addEventListener('submit', (e) => {\n      const bad = [...form.querySelectorAll('[data-field]')].filter((f) => !validate(f));\n      if (bad.length) {\n        e.preventDefault();\n        form.classList.remove('is-sent');\n        bad.forEach((f) => shake(fieldParts(f).control));\n        fieldParts(bad[0]).focusable.focus();\n        return;\n      }\n      if (form.hasAttribute('data-demo')) { e.preventDefault(); form.classList.add('is-sent'); }\n    });\n  });\n\n  /* glyph matrix: canvas of flickering monospace glyphs over the sky photos (colour from --glyph-color) */\n  const GLYPHS = '01<>/{}[]=+*#$%&xX'.split('');\n  document.querySelectorAll('[data-glyph-matrix]').forEach((host) => {\n    const canvas = document.createElement('canvas');\n    host.append(canvas);\n    const ctx = canvas.getContext('2d');\n    const rgb = getComputedStyle(host).getPropertyValue('--glyph-color').trim();\n    const dpr = Math.min(devicePixelRatio || 1, 2);\n    const S = 11;\n    let w = 0, h = 0, cols = 0, cells = [];\n    const pick = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];\n    const alpha = () => (Math.random() < 0.55 ? Math.random() * 0.38 : 0);\n    const size = () => {\n      w = host.clientWidth; h = host.clientHeight;\n      canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n      cols = Math.ceil(w / S);\n      cells = Array.from({ length: cols * Math.ceil(h / S) }, () => ({ g: pick(), a: alpha() }));\n    };\n    const draw = () => {\n      ctx.clearRect(0, 0, w, h);\n      ctx.font = '9px \"Geist Mono\", monospace'; ctx.textBaseline = 'top';\n      cells.forEach((c, i) => {\n        if (c.a < 0.03) return;\n        ctx.fillStyle = `rgba(${rgb}, ${c.a})`;\n        ctx.fillText(c.g, (i % cols) * S, ((i / cols) | 0) * S);\n      });\n    };\n    size(); draw();\n    new ResizeObserver(() => { size(); draw(); }).observe(host);\n    if (!reduceMotion) setInterval(() => {\n      for (let k = 0; k < cells.length * 0.02; k++) { const c = cells[(Math.random() * cells.length) | 0]; c.g = pick(); c.a = alpha(); }\n      draw();\n    }, 120);\n  });\n\n  /* ---------- docs (docs.html, docs-article.html) ---------- */\n  const copyText = async (text) => {\n    try { await navigator.clipboard.writeText(text); return true; } catch {\n      const ta = document.createElement('textarea');\n      ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;opacity:0';\n      document.body.append(ta); ta.select();\n      const ok = document.execCommand('copy'); ta.remove(); return ok;\n    }\n  };\n  const flash = (el) => { el.classList.add('is-copied'); setTimeout(() => el.classList.remove('is-copied'), 1600); };\n  const pageUrl = location.href.split('#')[0];\n\n  /* shortcut hint follows the platform: ⌘K on Apple, Ctrl K elsewhere */\n  if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-docs-search-key]').forEach((k) => { k.textContent = 'Ctrl K'; });\n\n  /* search dialog: [data-docs-search-open] / ⌘K / Ctrl K / \"/\" open it; typing filters the hits (mockup data);\n     ↑ ↓ move .is-selected, Enter opens, Esc or a click on the backdrop closes and returns focus */\n  const searchDialog = document.querySelector('[data-docs-search-dialog]');\n  if (searchDialog) {\n    const input = searchDialog.querySelector('[data-docs-search-input]');\n    const hits = [...searchDialog.querySelectorAll('[data-docs-search-hit]')];\n    const empty = searchDialog.querySelector('[data-docs-search-empty]');\n    const query = searchDialog.querySelector('[data-docs-search-query]');\n    let lastFocus = null;\n    let sel = 0;\n    const visible = () => hits.filter((h) => !h.parentElement.hidden);\n    const select = (i) => {\n      const v = visible();\n      sel = Math.max(0, Math.min(i, v.length - 1));\n      hits.forEach((h) => h.classList.toggle('is-selected', h === v[sel]));\n      v[sel]?.scrollIntoView({ block: 'nearest' });\n    };\n    const filter = () => {\n      const q = input.value.trim().toLowerCase();\n      hits.forEach((h) => { h.parentElement.hidden = Boolean(q) && !h.textContent.toLowerCase().includes(q); });\n      empty.hidden = visible().length > 0;\n      query.textContent = input.value.trim();\n      select(0);\n    };\n    const isOpen = () => searchDialog.classList.contains('is-open');\n    const open = () => {\n      lastFocus = document.activeElement;\n      searchDialog.classList.add('is-open'); searchDialog.setAttribute('aria-hidden', 'false');\n      input.value = ''; filter();\n      setTimeout(() => input.focus(), 30);\n    };\n    const close = () => {\n      searchDialog.classList.remove('is-open'); searchDialog.setAttribute('aria-hidden', 'true');\n      lastFocus?.focus?.();\n    };\n    document.querySelectorAll('[data-docs-search-open]').forEach((b) => b.addEventListener('click', open));\n    searchDialog.querySelectorAll('[data-docs-search-close]').forEach((b) => b.addEventListener('click', close));\n    searchDialog.addEventListener('click', (e) => { if (e.target === searchDialog) close(); });\n    input.addEventListener('input', filter);\n    hits.forEach((h) => h.addEventListener('mousemove', () => select(visible().indexOf(h))));\n    document.addEventListener('keydown', (e) => {\n      if (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); if (isOpen()) close(); else open(); return; }\n      if (e.key === '/' && !isOpen() && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) { e.preventDefault(); open(); return; }\n      if (!isOpen()) return;\n      if (e.key === 'Escape') { e.preventDefault(); close(); }\n      else if (e.key === 'ArrowDown') { e.preventDefault(); select(sel + 1); }\n      else if (e.key === 'ArrowUp') { e.preventDefault(); select(sel - 1); }\n      else if (e.key === 'Enter' && visible()[sel]) { e.preventDefault(); visible()[sel].click(); }\n    });\n  }\n\n  /* sidebar drawer below 992 px: [data-docs-drawer-open] → [data-docs-drawer].is-open; closes on outside click / Esc */\n  const drawer = document.querySelector('[data-docs-drawer]');\n  if (drawer) {\n    const setDrawer = (open) => {\n      drawer.classList.toggle('is-open', open);\n      document.querySelectorAll('[data-docs-drawer-open]').forEach((b) => b.setAttribute('aria-expanded', String(open)));\n      if (open) setTimeout(() => drawer.querySelector('[data-docs-drawer-close]')?.focus(), 50);\n    };\n    document.querySelectorAll('[data-docs-drawer-open]').forEach((b) => b.addEventListener('click', (e) => { e.stopPropagation(); setDrawer(true); }));\n    drawer.querySelectorAll('[data-docs-drawer-close]').forEach((b) => b.addEventListener('click', () => setDrawer(false)));\n    document.addEventListener('click', (e) => { if (drawer.classList.contains('is-open') && !drawer.contains(e.target)) setDrawer(false); });\n    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setDrawer(false); });\n  }\n\n  /* \"on this page\": the last heading above 120 px from the top marks its link .is-active */\n  document.querySelectorAll('[data-docs-toc]').forEach((toc) => {\n    const links = [...toc.querySelectorAll('a[href^=\"#\"]')];\n    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean);\n    if (!targets.length) return;\n    let ticking = false;\n    const update = () => {\n      ticking = false;\n      let current = targets[0];\n      targets.forEach((t) => { if (t.getBoundingClientRect().top <= 120) current = t; });\n      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = targets[targets.length - 1];\n      links.forEach((a) => {\n        const on = a.hash.slice(1) === current.id;\n        a.classList.toggle('is-active', on);\n        if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');\n      });\n    };\n    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });\n    update();\n  });\n\n  /* copy-page split button: [data-docs-copy-toggle] opens the menu (.is-open on [data-docs-copy-menu]) */\n  document.querySelectorAll('[data-docs-copy-menu]').forEach((box) => {\n    const toggle = box.querySelector('[data-docs-copy-toggle]');\n    const set = (open) => { box.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };\n    toggle.addEventListener('click', (e) => { e.stopPropagation(); set(!box.classList.contains('is-open')); });\n    document.addEventListener('click', (e) => { if (!box.contains(e.target)) set(false); });\n    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });\n  });\n\n  /* page → Markdown (title + the rich-text flow of [data-prose]) for \"Copy page\" */\n  const pageMarkdown = () => {\n    const out = [`# ${(document.querySelector('[data-docs-title]')?.textContent ?? document.title).trim()}`];\n    document.querySelector('[data-prose]')?.querySelectorAll(':scope > *').forEach((el) => {\n      const text = el.innerText.trim();\n      if (el.matches('h2')) out.push(`## ${text}`);\n      else if (el.matches('h3')) out.push(`### ${text}`);\n      else if (el.matches('ul')) out.push([...el.children].map((li) => `- ${li.innerText.trim()}`).join('\\n'));\n      else if (el.matches('ol')) out.push([...el.children].map((li, i) => `${i + 1}. ${li.innerText.trim()}`).join('\\n'));\n      else if (el.querySelector('pre')) out.push(`\\`\\`\\`\\n${el.querySelector('pre').innerText.trim()}\\n\\`\\`\\``);\n      else if (text) out.push(text);\n    });\n    return `${out.join('\\n\\n')}\\n\\nSource: ${pageUrl}\\n`;\n  };\n  document.querySelectorAll('[data-docs-copy-page]').forEach((b) => b.addEventListener('click', async () => {\n    if (!(await copyText(pageMarkdown()))) return;\n    flash(b.closest('[data-docs-copy-menu]') ?? b);\n    const label = b.querySelector('[data-docs-copy-label]');\n    if (label) { const was = label.textContent; label.textContent = 'Copied'; setTimeout(() => { label.textContent = was; }, 1600); }\n  }));\n  document.querySelectorAll('[data-docs-copy-link]').forEach((b) => b.addEventListener('click', async () => {\n    if (await copyText(pageUrl)) flash(b);\n  }));\n\n  /* code blocks: [data-code-copy] copies its block's <pre> without the prompt glyphs ([data-code-prompt]) */\n  document.querySelectorAll('[data-code-copy]').forEach((b) => b.addEventListener('click', async () => {\n    const pre = b.closest('[data-code]')?.querySelector('pre');\n    if (!pre) return;\n    const clone = pre.cloneNode(true);\n    clone.querySelectorAll('[data-code-prompt]').forEach((p) => p.remove());\n    if (!(await copyText(clone.textContent.trim()))) return;\n    flash(b);\n    const label = b.querySelector('[data-code-copy-label]');\n    if (label) { label.textContent = 'Copied'; setTimeout(() => { label.textContent = 'Copy'; }, 1600); }\n  }));\n\n  /* assistant + share links get this page's URL: [data-docs-ai=\"chatgpt|claude|cursor|gemini|perplexity\"]\n     (data-docs-ai-mode=\"summarize\" asks for a summary), [data-docs-share=\"x|facebook|linkedin\"] */\n  const AI_URL = {\n    chatgpt: (q) => `https://chatgpt.com/?q=${q}`,\n    claude: (q) => `https://claude.ai/new?q=${q}`,\n    gemini: (q) => `https://gemini.google.com/app?q=${q}`,\n    perplexity: (q) => `https://www.perplexity.ai/search?q=${q}`,\n    cursor: (q) => `cursor://anysphere.cursor-deeplink/prompt?text=${q}`,\n  };\n  document.querySelectorAll('[data-docs-ai]').forEach((a) => {\n    const ask = a.dataset.docsAiMode === 'summarize'\n      ? `Summarize this PXpace documentation page: ${pageUrl}`\n      : `Read ${pageUrl} so I can ask questions about it.`;\n    a.href = AI_URL[a.dataset.docsAi]?.(encodeURIComponent(ask)) ?? a.href;\n  });\n  const SHARE_URL = {\n    x: (u) => `https://x.com/intent/post?url=${u}`,\n    facebook: (u) => `https://www.facebook.com/sharer/sharer.php?u=${u}`,\n    linkedin: (u) => `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,\n  };\n  document.querySelectorAll('[data-docs-share]').forEach((a) => { a.href = SHARE_URL[a.dataset.docsShare]?.(encodeURIComponent(pageUrl)) ?? a.href; });\n})();\n",
      "placement": "body-end",
      "applyTo": {
        "all": true
      },
      "enabled": true,
      "id": "snip-pxpace-site-behaviour"
    },
    {
      "name": "Design system docs",
      "lang": "js",
      "code": "/* design-system.html only: renders token specimens from the live custom properties (tokens.css). */\n(() => {\n  const root = document.documentElement;\n  const val = (name) => getComputedStyle(root).getPropertyValue(`--${name}`).trim();\n  /* clamp(16px, calc(…), 20px) → \"16 → 20px\" */\n  const short = (v) => { const m = v.match(/^clamp\\((\\d+(?:\\.\\d+)?)px,.*,\\s*(\\d+(?:\\.\\d+)?)px\\)$/); return m ? `${m[1]} → ${m[2]}px` : v; };\n  const names = (el, attr) => el.getAttribute(attr).split(/\\s+/).filter(Boolean);\n  const el = (tag, cls, text) => { const n = document.createElement(tag); n.className = cls; if (text != null) n.textContent = text; return n; };\n\n  document.querySelectorAll('[data-ds-swatches]').forEach((grid) => names(grid, 'data-ds-swatches').forEach((n) => {\n    const card = el('div', 'w-ds-swatch');\n    const chip = el('div', 'w-ds-swatch__chip'); chip.style.background = `var(--${n})`;\n    const meta = el('div', 'w-ds-swatch__meta');\n    const value = el('span', 'w-ds-swatch__value', val(n)); value.dataset.dsToken = n;\n    meta.append(el('span', 'w-ds-swatch__name', `--${n}`), value);\n    card.append(chip, meta); grid.append(card);\n  }));\n\n  document.querySelectorAll('[data-ds-scale]').forEach((list) => names(list, 'data-ds-scale').forEach((n) => {\n    const row = el('div', 'w-ds-scale__row');\n    const bar = el('span', 'w-ds-scale__bar'); bar.style.width = `calc(var(--${n}) * 3)`;\n    row.append(el('span', '', `--${n}`), el('span', '', short(val(n))), bar); list.append(row);\n  }));\n\n  const tiles = (attr, apply) => document.querySelectorAll(`[${attr}]`).forEach((grid) => names(grid, attr).forEach((n) => {\n    const t = el('div', 'w-ds-tile'); apply(t, n);\n    t.append(el('span', 'w-ds-tile__name', `--${n}`), el('span', '', val(n).length > 60 ? val(n).slice(0, 60) + '…' : val(n)));\n    grid.append(t);\n  }));\n  tiles('data-ds-radius', (t, n) => { t.style.borderRadius = `var(--${n})`; });\n  tiles('data-ds-shadow', (t, n) => { t.style.border = '0'; t.style.borderRadius = 'var(--radius-l)'; t.style.boxShadow = `var(--${n})`; });\n  tiles('data-ds-stroke', (t, n) => { t.style.border = `var(--${n})`; });\n\n  document.querySelectorAll('[data-ds-motion]').forEach((table) => names(table, 'data-ds-motion').forEach((n) => {\n    const row = el('div', 'w-ds-table__row');\n    row.append(el('p', 'w-ds-table__meta', `--${n}`), el('p', 'w-text-m', val(n)), el('p', 'w-ds-table__meta', 'Variables › Motion'));\n    table.append(row);\n  }));\n\n  /* swatch values follow the light / dark switch */\n  new MutationObserver(() => document.querySelectorAll('[data-ds-token]').forEach((v) => { v.textContent = val(v.dataset.dsToken); }))\n    .observe(root, { attributes: true, attributeFilter: ['data-brx-theme'] });\n})();\n",
