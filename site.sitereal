                  "component": "cmp-docs-search-dialog",
                  "props": {
                    "results": "\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"/docs/quick-start\"><span class=\"w-docs-search-dialog__hit-category\">Quick Start</span><span class=\"w-docs-search-dialog__hit-title\">Set Up Your First Server and Site</span><span class=\"w-docs-search-dialog__hit-excerpt\">Sign up, pick a provider and plan, and get a managed server online in about ten minutes.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Sites</span><span class=\"w-docs-search-dialog__hit-title\">Create a Staging Environment</span><span class=\"w-docs-search-dialog__hit-excerpt\">Clone a live site to a staging domain, test changes, then push them back in one click.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Sites</span><span class=\"w-docs-search-dialog__hit-title\">Install a Free SSL Certificate</span><span class=\"w-docs-search-dialog__hit-excerpt\">Let's Encrypt certificates are issued and renewed automatically for every domain.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Servers</span><span class=\"w-docs-search-dialog__hit-title\">Add a Custom Cron Job</span><span class=\"w-docs-search-dialog__hit-excerpt\">Schedule any command per site or per server, with the output kept in the server log.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Migration</span><span class=\"w-docs-search-dialog__hit-title\">Migrate Sites from cPanel</span><span class=\"w-docs-search-dialog__hit-excerpt\">Move files, databases and email settings from any cPanel host without downtime.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Developer Tools</span><span class=\"w-docs-search-dialog__hit-title\">Create an API Token</span><span class=\"w-docs-search-dialog__hit-excerpt\">Generate scoped tokens for the public API, the CLI and MCP clients.</span></a></li>\n"
                  },
                  "attrs": {
                    "builder-data-element": "component"
                  }
                }
              ],
