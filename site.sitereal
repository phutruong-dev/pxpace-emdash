                            }
                          ],
                          "name": "header",
                          "id": "header-mwj42l8i-7029"
                        },
                        {
                          "id": "sr-inst-mwj42l8i-7037",
                          "tag": "DocsShareBar",
                          "component": "cmp-docs-share-bar",
                          "props": {},
                          "attrs": {
                            "builder-data-element": "component"
                          }
                        },
                        {
                          "tag": "div",
                          "classes": [
                            "w-docs-article__prose"
                          ],
                          "attrs": {
                            "builder-data-element": "div",
                            "data-prose": ""
                          },
                          "children": [
                            {
                              "tag": "p",
                              "html": "With <a href=\"#\">PXpace</a> you can set up your first server and site without writing any code. PXpace provisions the server, installs an optimized stack and keeps it updated, so you can focus on building sites instead of running infrastructure. Follow these steps to get started.",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8i-7039"
                            },
                            {
                              "id": "sr-inst-mwj42l8i-7040",
                              "tag": "DocsCallout",
                              "component": "cmp-docs-callout",
                              "props": {
                                "variant": "w-docs-callout--tip",
                                "icon": "<path d=\"M7.75 14.25h4.5M8.5 16.75h3M10 3.25a4.75 4.75 0 0 0-2.75 8.6c.4.3.6.75.6 1.25v.15h4.3v-.15c0-.5.2-.95.6-1.25A4.75 4.75 0 0 0 10 3.25Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path>",
                                "title": "Before you start",
                                "text": "You only need an email address. The self-managed plan includes 1 server and 10 sites for free; a payment method is needed for managed servers."
                              },
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "tag": "h2",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "sign-up"
                              },
                              "text": "Step 1: Sign Up for PXpace",
                              "id": "h2-mwj42l8i-7041"
                            },
                            {
                              "tag": "p",
                              "html": "Open <a href=\"#\">app.pxpace.com</a> and create an account with your name, email and a secure password. Confirm your email from the message we send you, and you land on the dashboard.",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8i-7042"
                            },
                            {
                              "id": "sr-inst-mwj42l8i-7043",
                              "tag": "DocsFigure",
                              "component": "cmp-docs-figure",
                              "props": {
                                "content": "\n<div class=\"w-mock__bar\"><span class=\"w-mock__dots\"><span class=\"w-mock__dot\"></span><span class=\"w-mock__dot w-mock__dot--yellow\"></span><span class=\"w-mock__dot w-mock__dot--green\"></span></span><span class=\"w-mock__title\">app.pxpace.com — Create your account</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">Full name<span class=\"w-mock__meta\">Jane Cooper</span></span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">Email<span class=\"w-mock__meta\">jane@studio.dev</span></span><span class=\"w-pill w-pill--success\">Verified</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">Password<span class=\"w-mock__meta\">••••••••••••••</span></span><span class=\"w-pill w-pill--success\">Strong</span></div>\n<div class=\"w-mock__row\"><span class=\"w-chip\">Create account</span><span class=\"w-mock__skeleton w-mock__skeleton--long\"></span></div>\n",
                                "caption": "Fig. 1 — The sign-up screen"
                              },
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "tag": "h2",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "create-server"
                              },
                              "text": "Step 2: Create Your First Server",
                              "id": "h2-mwj42l8i-7044"
                            },
                            {
                              "tag": "p",
                              "text": "From the dashboard, start a new server. PXpace walks you through four short choices:",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8i-7045"
                            },
                            {
                              "id": "sr-inst-mwj42l8i-7046",
                              "tag": "DocsSteps",
                              "component": "cmp-docs-steps",
                              "props": {},
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "id": "sr-inst-mwj42l8i-7047",
                              "tag": "DocsFigure",
                              "component": "cmp-docs-figure",
                              "props": {
                                "content": "\n<div class=\"w-mock__bar\"><span class=\"w-mock__dots\"><span class=\"w-mock__dot\"></span><span class=\"w-mock__dot w-mock__dot--yellow\"></span><span class=\"w-mock__dot w-mock__dot--green\"></span></span><span class=\"w-mock__title\">New server — Choose a provider</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">PXpace Managed<span class=\"w-mock__meta\">Fully managed, from $5/month</span></span><span class=\"w-pill w-pill--success\">Recommended</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">Vultr<span class=\"w-mock__meta\">1 account connected</span></span><span class=\"w-pill w-pill--success\">Connected</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">DigitalOcean<span class=\"w-mock__meta\">API token required</span></span><span class=\"w-pill w-pill--warning\">Connect</span></div>\n<div class=\"w-mock__row\"><span class=\"w-mock__icon\"></span><span class=\"w-mock__name\">Any Ubuntu server<span class=\"w-mock__meta\">Ubuntu 22.04 or 24.04, fresh install</span></span><span class=\"w-mock__tab\">Run 1 command</span></div>\n",
                                "caption": "Fig. 2 — Choosing where the server runs"
                              },
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "tag": "h2",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "server-details"
                              },
                              "text": "Step 3: Add Server Details",
                              "id": "h2-mwj42l8j-7048"
                            },
                            {
                              "tag": "p",
                              "html": "Give the server a <strong>name</strong> you will recognise, pick the <strong>plan</strong> (CPU, RAM, storage) and the <strong>region</strong>. The root database password is generated for you; copy it to your password manager before you continue.",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8j-7049"
                            },
                            {
                              "tag": "h3",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "database-engine"
                              },
                              "text": "Database engine",
                              "id": "h3-mwj42l8j-7050"
                            },
                            {
                              "tag": "ul",
                              "children": [
                                {
                                  "tag": "li",
                                  "html": "<strong>MySQL 8.0</strong> — the default, best for most WordPress sites.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7052"
                                },
                                {
                                  "tag": "li",
                                  "html": "<strong>MariaDB 10.11</strong> — a drop-in alternative with lower memory use.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7053"
                                },
                                {
                                  "tag": "li",
                                  "html": "Need PostgreSQL? Add it later from <a href=\"#\">Server → Databases</a>.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7054"
                                }
                              ],
                              "attrs": {
                                "builder-data-element": "list"
                              },
                              "id": "ul-mwj42l8j-7051"
                            },
                            {
                              "id": "sr-inst-mwj42l8j-7055",
                              "tag": "DocsCallout",
                              "component": "cmp-docs-callout",
                              "props": {
                                "variant": "w-docs-callout--warning",
                                "icon": "<g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"><path d=\"M8.7 3.9a1.5 1.5 0 0 1 2.6 0l5.6 9.8a1.5 1.5 0 0 1-1.3 2.25H4.4a1.5 1.5 0 0 1-1.3-2.25L8.7 3.9Z\"></path><path d=\"M10 8v3\"></path></g><circle cx=\"10\" cy=\"13.4\" fill=\"currentColor\" r=\".9\"></circle>",
                                "title": "Save the root password",
                                "text": "It is shown once. You can reset it later, but sites that use it will lose their database connection until you update them."
                              },
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "tag": "p",
                              "html": "Once the server shows <code>Provisioned</code>, you can connect over SSH with the sudo user PXpace created:",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8j-7056"
                            },
                            {
                              "id": "sr-inst-mwj42l8j-7057",
                              "tag": "DocsCodeBlock",
                              "component": "cmp-docs-code-block",
                              "props": {
                                "language": "bash",
                                "filename": "Your terminal",
                                "code": "<code class=\"w-docs-code__code\"><span class=\"w-docs-code__comment\"># connect as the sudo user (key added in Server → SSH Keys)</span>\n<span class=\"w-docs-code__prompt\" data-code-prompt=\"\">$ </span>ssh pxpace@203.0.113.24\n<span class=\"w-docs-code__prompt\" data-code-prompt=\"\">$ </span>sudo systemctl status nginx mysql --no-pager\n<span class=\"w-docs-code__prompt\" data-code-prompt=\"\">$ </span>echo <span class=\"w-docs-code__string\">\"server is ready\"</span></code>"
                              },
                              "attrs": {
                                "builder-data-element": "component"
                              }
                            },
                            {
                              "tag": "h2",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "next-site"
                              },
                              "text": "Next: Create Your First Site",
                              "id": "h2-mwj42l8j-7058"
                            },
                            {
                              "tag": "p",
                              "html": "Your server is live. Site creation starts from the app catalogue: choose <strong>WordPress</strong> first and PXpace lists the servers that can run it, including the one you just created.",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8j-7059"
                            },
                            {
                              "tag": "ul",
                              "children": [
                                {
                                  "tag": "li",
                                  "children": [
                                    {
                                      "tag": "a",
                                      "attrs": {
                                        "builder-data-element": "link",
                                        "href": "#"
                                      },
                                      "text": "How to create your first WordPress site",
                                      "id": "a-mwj42l8j-7062"
                                    }
                                  ],
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7061"
                                },
                                {
                                  "tag": "li",
                                  "children": [
                                    {
                                      "tag": "a",
                                      "attrs": {
                                        "builder-data-element": "link",
                                        "href": "#"
                                      },
                                      "text": "Create a demo site on a temporary domain",
                                      "id": "a-mwj42l8j-7064"
                                    }
                                  ],
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7063"
                                }
                              ],
                              "attrs": {
                                "builder-data-element": "list"
                              },
                              "id": "ul-mwj42l8j-7060"
                            },
                            {
                              "tag": "h2",
                              "attrs": {
                                "builder-data-element": "heading",
                                "id": "verify"
                              },
                              "text": "Verify the Server",
                              "id": "h2-mwj42l8j-7065"
                            },
                            {
                              "tag": "ul",
                              "children": [
                                {
                                  "tag": "li",
                                  "html": "The server shows as <strong>Connected</strong> and <strong>Provisioned</strong> under Servers.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7067"
                                },
                                {
                                  "tag": "li",
                                  "text": "Plan, region and database engine match what you selected.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7068"
                                },
                                {
                                  "tag": "li",
                                  "html": "<strong>New Site</strong> on the server opens the app catalogue.",
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "id": "li-mwj42l8j-7069"
                                }
                              ],
                              "attrs": {
                                "builder-data-element": "list"
                              },
                              "id": "ul-mwj42l8j-7066"
                            },
                            {
                              "tag": "p",
                              "html": "Stuck on provisioning? See <a href=\"#\">Server stuck provisioning</a> for the checks and the Retry button, or press <kbd>?</kbd> in the dashboard to reach support.",
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "id": "p-mwj42l8j-7070"
                            }
                          ],
                          "name": "prose",
                          "id": "div-mwj42l8i-7038"
                        },
                        {
                          "id": "sr-inst-mwj42l8j-7071",
