---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import BadgeRating from '../components/BadgeRating.astro';
import Toggle from '../components/Toggle.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonOutline from '../components/ButtonOutline.astro';
import GlyphMatrix from '../components/GlyphMatrix.astro';
import LogoCell from '../components/LogoCell.astro';
import CardHosting from '../components/CardHosting.astro';
import CardPlan from '../components/CardPlan.astro';
import TileStack from '../components/TileStack.astro';
import ButtonText from '../components/ButtonText.astro';
import CardFeature from '../components/CardFeature.astro';
import Tag from '../components/Tag.astro';
import CardSecurity from '../components/CardSecurity.astro';
import Stat from '../components/Stat.astro';
import TileAgent from '../components/TileAgent.astro';
import CardWay from '../components/CardWay.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';
import BadgePill from '../components/BadgePill.astro';
import AccordionItem from '../components/AccordionItem.astro';
import TileIntegration from '../components/TileIntegration.astro';
import CardTestimonial from '../components/CardTestimonial.astro';
import CardCommunity from '../components/CardCommunity.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-mwj2rj4d-1.css';
import '../styles/generated/pages/index.css';
---
<Base title="Home" siteName="PXpace" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/brand/favicon.png" type="image/png" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="PXpace" />
    <script is:inline src="/scripts/snippets/snip-theme-mode-restore.js"></script>
  </Fragment>
  <MainLayout>
    <section class="w-home-hero" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-home-hero__container" builder-data-element="container" data-brx="container">
        <div class="w-home-hero__copy" builder-data-element="flex" data-brx="block">
          <BadgeRating link="#" label="4.8 stars | 428+ 5 Star Reviews" />
          <h1 class="w-home-hero__heading" builder-data-element="heading">
            <span class="w-heading-2xl" builder-data-element="span">Host Anything.</span>
            <span class="w-heading-2xl" builder-data-element="span">Scale Infinitely. Manage With</span>
            <span class="w-home-hero__line-row" builder-data-element="span" data-switch-group="">
              <span class="w-home-hero__word is-active" builder-data-element="span" data-switch-word="off">Panel</span>
              <Toggle />
              <span class="w-home-hero__word w-home-hero__word--agent" builder-data-element="span" data-switch-word="on">AI Agents</span>
            </span>
          </h1>
          <p class="w-text-m" builder-data-element="text">Deploy WordPress, WooCommerce, Laravel, Node.js, n8n, AI tools, and more from one platform. Launch on your own cloud provider or fully managed PXpace servers in minutes, protected and patched for you.</p>
        </div>
        <div class="w-home-hero__actions" builder-data-element="flex" data-brx="block">
          <ButtonPrimary link="#" label="Join for free" />
          <ButtonOutline link="#" label="Deploy" showIcon={false} />
        </div>
      </div>
      <div class="w-home-hero__visual" builder-data-element="container" data-brx="container">
        <img class="w-home-hero__background" builder-data-element="image" alt="" src="https://xcloud.host/_landing/hero/hero-bg-1.png" />
        <GlyphMatrix />
        <img class="w-home-hero__illustration" builder-data-element="image" alt="PXpace site dashboard" src="https://xcloud.host/_landing/hero/hero-illustration-sitedashboard.png" />
        <div class="w-home-hero__fade" builder-data-element="div" data-brx="div"></div>
      </div>
    </section>
    <section class="w-logos" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-logos__container" builder-data-element="container" data-brx="container">
        <p class="w-logos__intro" builder-data-element="text">Trusted by <strong>100,000+</strong> businesses and brands worldwide.</p>
      </div>
      <div class="w-logos__band" builder-data-element="container" data-brx="container">
        <div class="w-logos__viewport" builder-data-element="div" data-brx="div">
          <ul class="w-logos__track" builder-data-element="list" data-marquee="">
            <LogoCell showBadge={false} logoAlt="Dumitru Butucel" logo="https://xcloud.host/_landing/logofolio/logo-db.png" />
            <LogoCell showBadge={false} logoAlt="stackhaus" logo="https://xcloud.host/_landing/logofolio/logo-stackhause.png" />
            <LogoCell badge="• Case Study" showBadge logoAlt="Kevin Heinrichs" logo="https://xcloud.host/_landing/logofolio/logo-kevin.png" />
            <LogoCell badge="• Case Study" showBadge logoAlt="Cloud Nine Web" logo="https://xcloud.host/_landing/logofolio/logo-cloudenineweb.png" />
            <LogoCell badge="• Case Study" showBadge logoAlt="Newman Web Solutions" logo="https://xcloud.host/_landing/logofolio/logo-newman.png" />
            <LogoCell showBadge={false} logoAlt="Advanced Web Strategies" logo="https://xcloud.host/_landing/logofolio/logo-advancedwebstrategies.png" />
            <LogoCell showBadge={false} logoAlt="En Busca del Fuego" logo="https://xcloud.host/_landing/logofolio/logo-enbusca.png" />
          </ul>
        </div>
      </div>
    </section>
    <section class="w-hosting" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-hosting__container" builder-data-element="container" data-animate="" data-brx="container">
        <header class="w-hosting__head" builder-data-element="flex" data-brx="block">
          <h2 class="w-heading-xl" builder-data-element="heading">What Do You Want to Host?</h2>
          <p class="w-text-l" builder-data-element="text">Pick what you are building. PXpace sets up the server for it, keeps it updated and backed up, and you manage everything from one dashboard.</p>
        </header>
        <ul class="w-hosting__grid" builder-data-element="list">
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/wordpress.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/woocommerce.svg\"/></span>"} label="WordPress Hosting" title="Fast, Safe WordPress and WooCommerce" text="Caching, backups and SSL are ready from day one. Update plugins safely, with a backup first and a compatibility check." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Safe updates\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Daily backups\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Free SSL\"}'></sitereal-component>"} linkLabel="WordPress hosting" />
          </li>
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/nodejs.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/nextjs.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/nuxt-js.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/astro.svg\"/></span>"} label="Node.js Hosting" title="Deploy JavaScript Apps From Git" text="Next.js, Nuxt, Astro, Express and more. Push your code and PXpace builds it, runs it and keeps it running." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Deploy on push\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Zero-downtime deploys\"}'></sitereal-component>"} linkLabel="Node.js hosting" />
          </li>
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/docker.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/docker-compose.png\"/></span>"} label="Docker Hosting" title="Run Any App in a Container" text="Bring a Dockerfile or a Docker Compose file. It runs on the same server as your other sites, with its own domain and SSL." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Docker Compose\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Same server as your sites\"}'></sitereal-component>"} linkLabel="Docker hosting" />
          </li>
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/one-click-app/laravel.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/php.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/statamic.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/drupal.svg\"/></span>"} label="PHP & Laravel Hosting" title="Laravel and PHP Apps, Ready to Run" text="Laravel, Statamic, Drupal and other PHP apps. Composer, queues, the scheduler and Horizon are set up for you. Deploy from Git and pick your PHP version." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Queues and scheduler\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Deploy from Git\"}'></sitereal-component>"} linkLabel="Laravel hosting" />
          </li>
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/n8n.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/nextcloud.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/uptime-kuma.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/supabase.svg\"/></span>"} label="One-Click Apps" title="1,000+ Open-Source Apps in One Click" text="n8n, Nextcloud, Uptime Kuma, Supabase and many more. Pick an app, and it is installed and online in minutes." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Installed for you\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Backups included\"}'></sitereal-component>"} linkLabel="Browse one-click apps" />
          </li>
          <li class="w-hosting__item" builder-data-element="text" data-stagger="">
            <CardHosting link="#" plate={"<span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/openclaw.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/hermes.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/paperclip.svg\"/></span><span class=\"w-card-hosting__logo\"><img alt=\"\" class=\"w-card-hosting__logo-image\" src=\"https://xcloud.host/_landing/home/hosting-types/deepseek.svg\"/></span>"} label="AI Agent Hosting" title="Your Own AI Agents, Always On" text="Run OpenClaw, Hermes, Paperclip, DeepSeek Harness and other AI agents on a server that stays online, from $24.99/month." chips={"<sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Always online\"}'></sitereal-component><sitereal-component data-component=\"cmp-chip\" data-name=\"Chip\" data-props='{\"label\": \"Set up for you\"}'></sitereal-component>"} linkLabel="AI agent hosting" />
          </li>
        </ul>
        <p class="w-hosting__note" builder-data-element="text">
          Every one of these runs on a PXpace Managed server from $5/month, or on your own server through the same panel. Your first own server is free.{' '}
          <a class="w-hosting__note-link" builder-data-element="link" href="#">Choose how you want to host</a>
        </p>
      </div>
    </section>
    <section class="w-plans" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-plans__container" builder-data-element="container" data-animate="" data-brx="container">
        <header class="w-plans__head" builder-data-element="flex" data-brx="block">
          <h2 class="w-heading-xl" builder-data-element="heading">Choose How You Want To Host</h2>
          <p class="w-text-m" builder-data-element="text">From small startups to enterprises, PXpace is built to support your growth. Choose the plan that suits you best with affordable plans and pricing.</p>
        </header>
        <div class="w-plans__cards" builder-data-element="div" data-brx="div">
          <CardPlan image="https://xcloud.host/_landing/pricing/pricing-xcloud.png" title="PXpace Hosting" description="Fully managed hosting for dynamic, high-traffic sites, with automated daily backups and easy scaling built to deliver high-performance websites." features={"<li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Fully managed server setup</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Optimized hosting stack</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Daily automated backups</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Free SSL and renewal</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Support from expert engineers</li>"}>
            <ButtonPrimary link="#" variant="w-button-primary--block" label="View the Plans" />
          </CardPlan>
          <CardPlan image="https://xcloud.host/_landing/pricing/pricing-selfmanaged.png" title="Self-Managed Hosting" description="Bring your own server and connect it to the PXpace panel for easier server management, with every feature you need available under a single, unified dashboard." features={"<li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Bring your own server, manage it from one dashboard</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Free: 1 server and 10 sites included</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Connect any VPS to the PXpace panel</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Every feature under one dashboard</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Unlimited apps and databases</li>"}>
            <ButtonOutline link="#" variant="w-button-outline--block" label="Connect Your Own Server" showIcon />
          </CardPlan>
          <CardPlan image="https://xcloud.host/_landing/pricing/pricing-managedbilling.png" title="Reseller Hosting" description="Sell hosting under your own brand. Resell on PXpace servers or bring your own, with full white-label control, built-in client management, and billing handled for you." features={"<li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Resell on PXpace servers or your own</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>100% white-label — your domain and logo</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Built-in client and account management</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Create custom packages and set your prices</li><li class=\"w-card-plan__feature\"><svg aria-hidden=\"true\" class=\"w-card-plan__check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg>Automated billing and invoicing</li>"}>
            <ButtonOutline link="#" variant="w-button-outline--block" label="Start Reselling" showIcon />
          </CardPlan>
        </div>
      </div>
    </section>
    <section class="w-stack" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-stack__container" builder-data-element="container" data-brx="container">
        <div class="w-stack__intro" builder-data-element="flex" data-brx="block">
          <p class="w-stack__title" builder-data-element="text">Bring the stack you already use</p>
          <p class="w-stack__description" builder-data-element="text">Runtime, SSL and domain are configured before your first deploy.</p>
          <img class="w-stack__dots" builder-data-element="image" alt="" src="https://xcloud.host/_landing/tech-stack/dot-pattern.svg" />
        </div>
        <div class="w-stack__rows" builder-data-element="div" data-brx="div">
          <div class="w-stack__row" builder-data-element="div" data-brx="div">
            <div class="w-stack__track" builder-data-element="div" data-marquee="">
              <TileStack icon="https://xcloud.host/_landing/tech-stack/laravel.svg" label="Laravel" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/docker.svg" label="Docker" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/nodejs.svg" label="Node" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/nextjs.svg" label="Next.js" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/astro.svg" label="Astro" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/react.svg" label="React" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/vite.svg" label="Vite" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/svelte.svg" label="Svelte" />
            </div>
          </div>
          <span class="w-stack__rule" builder-data-element="span"></span>
          <div class="w-stack__row" builder-data-element="div" data-brx="div">
            <div class="w-stack__track w-stack__track--reverse" builder-data-element="div" data-marquee="">
              <TileStack icon="https://xcloud.host/_landing/tech-stack/django.svg" label="Django" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/bun.svg" label="Bun" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/python.svg" label="Python" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/redis.svg" label="Redis" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/postgres.svg" label="Postgres" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/go.svg" label="Go" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/rust.svg" label="Rust" />
              <TileStack icon="https://xcloud.host/_landing/tech-stack/ruby.svg" label="Ruby" />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="w-features" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-features__container" builder-data-element="container" data-brx="container">
        <header class="w-features__head" builder-data-element="flex" data-animate="" data-brx="block">
          <h2 class="w-heading-xl" builder-data-element="heading">A <span class="w-highlight">Modern</span> &amp; <span class="w-highlight">User-Friendly</span> Control Panel You Can Rely On</h2>
          <p class="w-text-m" builder-data-element="text">Manage servers, applications, databases, teams, backups, deployments, and security from one intuitive dashboard.</p>
          <ButtonText link="#" label="View all features" showIcon />
        </header>
        <div class="w-features__grid" builder-data-element="div" data-brx="div">
          <div class="w-features__row" builder-data-element="div" data-brx="div">
